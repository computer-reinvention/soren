#!/usr/bin/env bash
# memory-index - Index journal entries and artifacts into semantic memory store
#
# Usage: memory-index [--date YYYY-MM-DD] [--all]
#                     [--project <id>] [--all-projects]
#
#   No args:            index SOREN journal for today + yesterday
#   --date YYYY-MM-DD:  index SOREN journal for a specific date
#   --all:              index SOREN journal for all available dates
#   --project <id>:     index a specific project (journal + docs)
#   --all-projects:     index all active projects from projects.json

set -uo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
PROJECTS_FILE="${SOREN_HOME}/.soren/projects.json"

# Parse args
DATE_MODE="recent"
SPECIFIC_DATE=""
PROJECT_MODE="self"
PROJECT_ID=""

WITH_PATTERNS=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --all)           DATE_MODE="all"; shift ;;
        --date)          DATE_MODE="single"; SPECIFIC_DATE="${2:-}"; shift 2 ;;
        --project)       PROJECT_MODE="single"; PROJECT_ID="${2:-}"; shift 2 ;;
        --all-projects)  PROJECT_MODE="all"; shift ;;
        --with-patterns) WITH_PATTERNS=true; shift ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
    esac
done

# Build Python script that uses memory_store to index entries
python_script=$(cat <<'PYEOF'
import sys
import json
import re
from pathlib import Path
from datetime import datetime, timezone, timedelta

soren_home    = Path(sys.argv[1])
date_mode    = sys.argv[2]   # recent | single | all
project_mode = sys.argv[3]   # self | single | all
project_id   = sys.argv[4]   # "" unless single
specific_date = sys.argv[5]  # "" unless date_mode=single

# Add project root to path so we can import the service
sys.path.insert(0, str(soren_home))
from src.server.services.memory_store import memory_store

projects_file = soren_home / ".soren" / "projects.json"


def load_projects() -> list[dict]:
    if not projects_file.exists():
        return []
    data = json.loads(projects_file.read_text())
    return [p for p in data.get("projects", []) if p.get("active", True)]


def index_journal_dir(
    journal_dir: Path,
    pid: str,
    source_prefix: str = ".soren/journal",
    dates: "set[str] | None" = None,
    extra_tags: "list[str] | None" = None,
) -> tuple[int, int]:
    """Index journal entries and artifacts from a journal directory.

    `journal_dir` is the directory that directly contains YYYY-MM-DD
    subdirectories -- for SOREN's own journal this is now a specific scope
    (`.soren/journal/supervisor` or `.soren/journal/teams/<prefix>`), not
    `.soren/journal` itself (see the self-mode caller below). `source_prefix`
    is the path segment recorded in each memory's source_path, since it no
    longer always equals ".soren/journal" once a scope subdirectory is
    involved. `dates`, if given, restricts indexing to those specific date
    names instead of every date dir found.

    Returns (entries_added, artifacts_added).
    """
    if not journal_dir.exists():
        return 0, 0

    total_entries = 0
    total_artifacts = 0
    extra_tags = extra_tags or []

    for day_dir in sorted(journal_dir.glob("????-??-??")):
        if not day_dir.is_dir():
            continue
        d = day_dir.name
        if dates is not None and d not in dates:
            continue

        # Index journal entries (split by ## headers)
        journal_file = day_dir / "journal.md"
        if journal_file.exists():
            content = journal_file.read_text()
            sections = re.split(r'^(## .+)$', content, flags=re.MULTILINE)
            entries = []
            i = 1
            while i < len(sections) - 1:
                header = sections[i].strip()
                body = sections[i + 1].strip()
                if body:
                    full_text = f"{header}\n{body}"
                    entries.append({
                        "content": full_text,
                        "source_type": "journal",
                        "source_path": f"{pid}/{source_prefix}/{d}/journal.md",
                        "keywords": [],
                        "tags": [d, pid, *extra_tags],
                        "project_id": pid,
                    })
                i += 2
            if entries:
                total_entries += memory_store.add_memories_batch(entries)

        # Index artifacts (markdown files)
        artifacts_dir = day_dir / "artifacts"
        if artifacts_dir.exists():
            artifact_entries = []
            for artifact in sorted(artifacts_dir.glob("*.md")):
                text = artifact.read_text().strip()
                if len(text) >= 20:
                    artifact_entries.append({
                        "content": text[:2000],
                        "source_type": "artifact",
                        "source_path": f"{pid}/{source_prefix}/{d}/artifacts/{artifact.name}",
                        "keywords": [],
                        "tags": [d, artifact.stem, pid, *extra_tags],
                        "project_id": pid,
                    })
            if artifact_entries:
                total_artifacts += memory_store.add_memories_batch(artifact_entries)

    return total_entries, total_artifacts


def index_soren_own_journal(journal_root: Path, pid: str, dates: "set[str] | None" = None) -> tuple[int, int]:
    """Index a SOREN installation's OWN journal tree, which is split into
    scopes (supervisor/<date>/ + teams/<prefix>/<date>/) rather than a flat
    list of date directories directly under `journal_root`. Walks the
    supervisor scope plus every team scope, tagging team-sourced memories
    with "team:<prefix>" so a semantic search result can be attributed back
    to the right scope.

    This is distinct from `index_journal_dir()`'s direct use for an
    EXTERNAL project's `.soren/journal/` (if that project happens to be its
    own independent SOREN-managed checkout with the old flat layout) --
    that path is untouched by this restructuring.
    """
    total_entries = 0
    total_artifacts = 0

    supervisor_dir = journal_root / "supervisor"
    e, a = index_journal_dir(supervisor_dir, pid, source_prefix=".soren/journal/supervisor", dates=dates)
    total_entries += e
    total_artifacts += a

    teams_root = journal_root / "teams"
    if teams_root.exists():
        for team_dir in sorted(teams_root.iterdir()):
            if not team_dir.is_dir():
                continue
            e, a = index_journal_dir(
                team_dir, pid,
                source_prefix=f".soren/journal/teams/{team_dir.name}",
                dates=dates,
                extra_tags=[f"team:{team_dir.name}"],
            )
            total_entries += e
            total_artifacts += a

    return total_entries, total_artifacts


def index_docs(project_path: Path, pid: str) -> int:
    """Index key documentation files when no journal exists.

    Looks for: README.md, AGENTS.md (falling back to CLAUDE.md), docs/**/*.md
    Returns count added.
    """
    candidates = []
    readme = project_path / "README.md"
    if readme.exists():
        candidates.append(readme)
    # Prefer AGENTS.md; fall back to legacy CLAUDE.md if AGENTS.md is missing
    agents_md = project_path / "AGENTS.md"
    if agents_md.exists():
        candidates.append(agents_md)
    else:
        claude_md = project_path / "CLAUDE.md"
        if claude_md.exists():
            candidates.append(claude_md)
    docs_dir = project_path / "docs"
    if docs_dir.exists():
        candidates.extend(sorted(docs_dir.glob("**/*.md")))

    if not candidates:
        return 0

    entries = []
    for f in candidates:
        text = f.read_text().strip()
        if len(text) >= 20:
            rel = str(f.relative_to(project_path))
            entries.append({
                "content": text[:2000],
                "source_type": "documentation",
                "source_path": f"{pid}/{rel}",
                "keywords": [],
                "tags": [pid, f.stem],
                "project_id": pid,
            })

    if not entries:
        return 0
    return memory_store.add_memories_batch(entries)


def index_project(project: dict) -> None:
    pid  = project["id"]
    path = Path(project["path"])
    print(f"\nIndexing project: {pid} ({path})")

    # If this is the self project, use scope-aware journal indexing
    # (supervisor + every team — see index_soren_own_journal)
    if project.get("is_self"):
        journal_dir = path / ".soren" / "journal"
        entries, artifacts = index_soren_own_journal(journal_dir, pid)
        print(f"  Indexed {entries} journal entries, {artifacts} artifacts")
        return

    # External project: prefer journal, fall back to docs
    ext_journal = path / ".soren" / "journal"
    if ext_journal.exists():
        entries, artifacts = index_journal_dir(ext_journal, pid)
        print(f"  Indexed {entries} journal entries, {artifacts} artifacts (from journal)")
    else:
        added = index_docs(path, pid)
        print(f"  Indexed {added} documentation files (no journal found)")


# ── Main logic ───────────────────────────────────────────────────────────────

if project_mode == "all":
    projects = load_projects()
    if not projects:
        print("No active projects found in projects.json")
        sys.exit(0)
    for p in projects:
        index_project(p)

elif project_mode == "single":
    if not project_id:
        print("Error: --project requires a project ID", file=sys.stderr)
        sys.exit(1)
    projects = load_projects()
    match = next((p for p in projects if p["id"] == project_id), None)
    if not match:
        print(f"Error: project '{project_id}' not found in projects.json", file=sys.stderr)
        sys.exit(1)
    index_project(match)

else:
    # self/date-based mode — index SOREN's own journal (supervisor scope +
    # every team's own scope; see index_soren_own_journal). "recent"/"single"
    # pass an explicit date filter down; nonexistent dates simply contribute
    # zero entries rather than needing an existence check against any one
    # particular scope up front (a date might exist in one team's journal
    # but not another's, or not in the supervisor's at all).
    journal_dir = soren_home / ".soren" / "journal"
    dates: "set[str] | None" = None
    dates_label = "all dates"
    if date_mode == "recent":
        today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        yesterday = (datetime.now(timezone.utc) - timedelta(days=1)).strftime("%Y-%m-%d")
        dates = {today, yesterday}
        dates_label = ", ".join(sorted(dates))
    elif date_mode == "single":
        if not specific_date:
            print("Error: --date requires YYYY-MM-DD argument", file=sys.stderr)
            sys.exit(1)
        dates = {specific_date}
        dates_label = specific_date
    # else "all": dates stays None, index_journal_dir indexes every date found

    print(f"Indexing {dates_label} across the supervisor journal and every team's journal")
    total_entries, total_artifacts = index_soren_own_journal(journal_dir, "soren", dates=dates)
    print(f"Indexed {total_entries} journal entries, {total_artifacts} artifacts")

stats = memory_store.stats()
print(f"\nTotal memories: {stats['total']} | by_type: {json.dumps(stats['by_type'])} | by_project: {json.dumps(stats.get('by_project', {}))}")
PYEOF
)

cd "$SOREN_HOME"
uv run python -c "$python_script" "$SOREN_HOME" "$DATE_MODE" "$PROJECT_MODE" "$PROJECT_ID" "$SPECIFIC_DATE"

# Optionally run pattern extraction on indexed dates
if [[ "$WITH_PATTERNS" == "true" && "$PROJECT_MODE" == "self" ]]; then
    echo ""
    echo "Running pattern extraction..."
    tools/extract-patterns ${SPECIFIC_DATE:+--date "$SPECIFIC_DATE"} ${DATE_MODE:+} 2>/dev/null || true
fi
