#!/usr/bin/env bash
#===============================================================================
# contract - Validate and inspect permanent-team role contracts
#
# Each templates/team/<agent_id>-role.md carries YAML frontmatter describing
# the agent's machine-readable contract (identity, tier, domains, worktree
# policy, report format). This CLI parses and validates those contracts.
#
# Usage:
#   contract validate [file|all]   - Validate one role file or all of them
#   contract show <agent_id>       - Print the parsed contract as JSON
#   contract list                  - Table of all contracts
#
# Parsing is done with python3 and a small hand-rolled parser for the simple
# YAML subset used in the frontmatter — no external dependencies (PyYAML may
# not be installed).
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
TEMPLATES_DIR="${SOREN_HOME}/templates/team"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
info() { echo -e "${CYAN}→${NC} $1"; }
ok() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }

command -v python3 >/dev/null 2>&1 || die "python3 is required"
[[ -d "$TEMPLATES_DIR" ]] || die "templates directory not found: $TEMPLATES_DIR"

# run_py <mode> [args...] — invoke the embedded parser/validator.
run_py() {
    python3 - "$@" <<'PYEOF'
import json, os, re, sys

CATEGORIES = ("builder", "reviewer", "support")
TIERS = ("haiku", "sonnet", "opus")
PROTECTED = ("forbidden", "via-worktree")


def strip_comment(line):
    """Remove a trailing # comment, respecting quoted strings."""
    out, quote = [], None
    for ch in line:
        if quote:
            out.append(ch)
            if ch == quote:
                quote = None
        elif ch in ('"', "'"):
            quote = ch
            out.append(ch)
        elif ch == '#':
            break
        else:
            out.append(ch)
    return ''.join(out).rstrip()


def parse_scalar(raw):
    v = raw.strip()
    if len(v) >= 2 and v[0] in ('"', "'") and v[-1] == v[0]:
        return v[1:-1]
    if v == 'true':
        return True
    if v == 'false':
        return False
    if v.startswith('[') and v.endswith(']'):
        inner = v[1:-1].strip()
        if not inner:
            return []
        return [parse_scalar(item) for item in inner.split(',')]
    if re.fullmatch(r'-?\d+', v):
        return int(v)
    return v


def parse_frontmatter(text):
    """Return (dict|None, body, error|None). Frontmatter must open the file."""
    lines = text.split('\n')
    if not lines or lines[0].strip() != '---':
        return None, text, 'no frontmatter block at top of file'
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == '---':
            end = i
            break
    if end is None:
        return None, text, 'frontmatter opened but never closed with ---'

    data, i = {}, 1
    while i < end:
        line = strip_comment(lines[i])
        if not line.strip():
            i += 1
            continue
        if line.startswith(' '):
            return None, text, f'unexpected indented line outside a map: {line.strip()!r}'
        m = re.match(r'^([A-Za-z_][A-Za-z0-9_-]*):(.*)$', line)
        if not m:
            return None, text, f'unparseable line: {line!r}'
        key, rest = m.group(1), m.group(2).strip()
        if rest:
            data[key] = parse_scalar(rest)
            i += 1
        else:
            # nested map: consume indented key: value lines
            sub = {}
            i += 1
            while i < end:
                nline = strip_comment(lines[i])
                if not nline.strip():
                    i += 1
                    continue
                if not nline.startswith('  '):
                    break
                sm = re.match(r'^\s+([A-Za-z_][A-Za-z0-9_-]*):(.*)$', nline)
                if not sm:
                    return None, text, f'unparseable nested line: {nline.strip()!r}'
                sub[sm.group(1)] = parse_scalar(sm.group(2).strip())
                i += 1
            data[key] = sub
    body = '\n'.join(lines[end + 1:])
    return data, body, None


def validate_file(path):
    errors = []
    try:
        with open(path, encoding='utf-8') as f:
            text = f.read()
    except OSError as e:
        return [f'cannot read file: {e}']

    fm, body, err = parse_frontmatter(text)
    if err:
        return [err]

    fname = os.path.basename(path)
    expected_id = fname[:-len('-role.md')] if fname.endswith('-role.md') else None

    agent_id = fm.get('agent_id')
    if not agent_id:
        errors.append('missing agent_id')
    elif expected_id and agent_id != expected_id:
        errors.append(f'agent_id {agent_id!r} does not match filename (expected {expected_id!r})')

    if not fm.get('display_name'):
        errors.append('missing display_name')

    category = fm.get('category')
    if category not in CATEGORIES:
        errors.append(f'category {category!r} not in {list(CATEGORIES)}')

    tier = fm.get('tier')
    if tier not in TIERS:
        errors.append(f'tier {tier!r} not in {list(TIERS)}')

    if fm.get('protected_paths') not in PROTECTED:
        errors.append(f'protected_paths {fm.get("protected_paths")!r} not in {list(PROTECTED)}')

    if not isinstance(fm.get('worktree_required'), bool):
        errors.append(f'worktree_required must be boolean, got {fm.get("worktree_required")!r}')

    report = fm.get('report')
    if not isinstance(report, dict):
        errors.append('missing or invalid report map')
    else:
        fmt = report.get('format')
        if not isinstance(fmt, str) or not fmt.strip():
            errors.append('report.format must be a non-empty string')
        if not isinstance(report.get('done_requires_commit'), bool):
            errors.append('report.done_requires_commit must be boolean')
        verdicts = report.get('verdicts')
        if not isinstance(verdicts, list):
            errors.append('report.verdicts must be a list')
        elif category == 'reviewer' and not verdicts:
            errors.append('reviewers must declare non-empty report.verdicts')
        elif category in ('builder', 'support') and verdicts:
            errors.append(f'{category}s must have empty report.verdicts, got {verdicts}')

    if '## Accumulated Knowledge' not in body:
        errors.append("body missing '## Accumulated Knowledge' section")

    return errors


def load_all(tdir):
    out = {}
    for fname in sorted(os.listdir(tdir)):
        if not fname.endswith('-role.md'):
            continue
        path = os.path.join(tdir, fname)
        with open(path, encoding='utf-8') as f:
            fm, _, err = parse_frontmatter(f.read())
        out[path] = (fm, err)
    return out


def main():
    mode = sys.argv[1]
    tdir = sys.argv[2]

    if mode == 'validate':
        target = sys.argv[3]
        if target == 'all':
            files = sorted(
                os.path.join(tdir, f) for f in os.listdir(tdir) if f.endswith('-role.md')
            )
            if not files:
                print(f'no role files found in {tdir}', file=sys.stderr)
                sys.exit(1)
        else:
            files = [target]
        failed = 0
        for path in files:
            errs = validate_file(path)
            name = os.path.basename(path)
            if errs:
                failed += 1
                print(f'FAIL {name}')
                for e in errs:
                    print(f'  - {e}')
            else:
                print(f'PASS {name}')
        sys.exit(1 if failed else 0)

    elif mode == 'show':
        agent_id = sys.argv[3]
        path = os.path.join(tdir, f'{agent_id}-role.md')
        if not os.path.isfile(path):
            print(f'no role file for {agent_id!r}: {path}', file=sys.stderr)
            sys.exit(1)
        with open(path, encoding='utf-8') as f:
            fm, _, err = parse_frontmatter(f.read())
        if err:
            print(f'{agent_id}: {err}', file=sys.stderr)
            sys.exit(1)
        print(json.dumps(fm, indent=2, ensure_ascii=False))

    elif mode == 'list':
        rows = [('AGENT_ID', 'NAME', 'CATEGORY', 'TIER', 'WORKTREE', 'PROTECTED_PATHS')]
        for path, (fm, err) in load_all(tdir).items():
            if err or fm is None:
                rows.append((os.path.basename(path), '<parse error>', '-', '-', '-', '-'))
                continue
            report = fm.get('report') or {}
            rows.append((
                str(fm.get('agent_id', '?')),
                str(fm.get('display_name', '?')),
                str(fm.get('category', '?')),
                str(fm.get('tier', '?')),
                str(fm.get('worktree_required', '?')).lower(),
                str(fm.get('protected_paths', '?')),
            ))
        widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
        for idx, r in enumerate(rows):
            print('  '.join(cell.ljust(widths[i]) for i, cell in enumerate(r)).rstrip())

    else:
        print(f'unknown mode: {mode}', file=sys.stderr)
        sys.exit(2)


main()
PYEOF
}

cmd_validate() {
    local target="${1:-all}"
    if [[ "$target" != "all" ]]; then
        [[ -f "$target" ]] || die "file not found: $target"
    fi
    local output rc=0
    output=$(run_py validate "$TEMPLATES_DIR" "$target") || rc=$?
    while IFS= read -r line; do
        case "$line" in
            PASS\ *) ok "${line#PASS }" ;;
            FAIL\ *) echo -e "${RED}✗${NC} ${line#FAIL }" ;;
            *)       echo "$line" ;;
        esac
    done <<< "$output"
    if (( rc != 0 )); then
        die "contract validation failed"
    fi
    ok "all contracts valid"
}

cmd_show() {
    local agent_id="${1:-}"
    [[ -n "$agent_id" ]] || die "usage: contract show <agent_id>"
    run_py show "$TEMPLATES_DIR" "$agent_id"
}

cmd_list() {
    run_py list "$TEMPLATES_DIR"
}

case "${1:-}" in
    validate) shift; cmd_validate "$@" ;;
    show)     shift; cmd_show "$@" ;;
    list)     cmd_list ;;
    ""|help|--help|-h)
        sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        ;;
    *) die "unknown subcommand: $1 (see contract help)" ;;
esac
