#!/usr/bin/env bash
#===============================================================================
# prefs - TARS-style configurable preferences for SOREN agents
#
# Usage:
#   prefs list                    - Show all settings with values and descriptions
#   prefs get <key>               - Show one setting's value and description
#   prefs set <key> <value>       - Update a setting (1-10 integer)
#   prefs reset                   - Restore all to defaults
#   prefs help                    - Show usage
#
# Storage: the `prefs` key-value table in the consolidated SQLite DB
# (.soren/soren.db). This merges the two legacy stores that had drifted apart:
#   - .soren/preferences.json  (this tool's old file — the live copy had also
#     accumulated server-schema keys)
#   - .soren/prefs.json        (the server API's old file — heartbeat keys)
# Both are imported once, lazily and verbatim (prefs.json wins on key
# conflicts, since the server file was authoritative for its own keys), then
# renamed *.migrated. The server route (src/server/routes/prefs.py) reads and
# writes the same table.
#
# The six TARS settings managed here are integers 1-10.
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
PREFERENCES_FILE="${SOREN_HOME}/.soren/preferences.json"   # legacy TARS store
SERVER_PREFS_FILE="${SOREN_HOME}/.soren/prefs.json"        # legacy server store

# Shared DB helpers (SOREN_DB_PATH resolution + soren_db wrapper)
source "${SOREN_HOME}/tools/lib/db.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $1"; }

# Escape a value for embedding in a single-quoted SQL literal.
sql_q() { printf '%s' "$1" | sed "s/'/''/g"; }

#-------------------------------------------------------------------------------
# Setting descriptions
#-------------------------------------------------------------------------------

description_for() {
    case "$1" in
        alertness)      echo "How often to alert the user with sound/voice notifications" ;;
        verbosity)      echo "How detailed agent responses should be (1=terse, 10=explain everything)" ;;
        autonomy)       echo "How much agents do without asking (1=ask everything, 10=just do it)" ;;
        humor)          echo "How playful vs dry the tone is" ;;
        proactiveness)  echo "How aggressively to find work when idle" ;;
        journal_detail) echo "How much to journal (1=major events only, 10=everything)" ;;
        *)              echo "Unknown setting" ;;
    esac
}

default_for() {
    case "$1" in
        alertness)      echo 7 ;;
        verbosity)      echo 5 ;;
        autonomy)       echo 7 ;;
        humor)          echo 3 ;;
        proactiveness)  echo 6 ;;
        journal_detail) echo 5 ;;
        *)              echo 5 ;;
    esac
}

VALID_KEYS="alertness verbosity autonomy humor proactiveness journal_detail"

#-------------------------------------------------------------------------------
# State init — schema + one-time lazy import of BOTH legacy files
# NOTE (shared schema + import): duplicated in src/server/routes/prefs.py —
# keep in sync.
#-------------------------------------------------------------------------------

_prefs_ensure_schema() {
    soren_db "CREATE TABLE IF NOT EXISTS prefs (
        key        TEXT PRIMARY KEY,
        value      TEXT,
        updated_at TEXT,
        updated_by TEXT
    );" 2>/dev/null || true
}

# One-time lazy import of one legacy JSON prefs file: every top-level key
# except _meta is imported verbatim (value stored as its JSON encoding);
# _meta.updated_at/_meta.updated_by become the rows' audit columns. mv is the
# atomic claim; the file ends up renamed *.migrated so this never runs twice.
_prefs_import_file() {
    local f="$1"
    [[ -f "$f" ]] || return 0
    local claim="${f}.importing.$$"
    mv "$f" "$claim" 2>/dev/null || return 0
    local prog sql
    prog=$(cat <<'JQEOF'
def q: "'" + (gsub("'"; "''")) + "'";
select(type == "object")
| (._meta.updated_at // "") as $ts
| (._meta.updated_by // "import") as $by
| to_entries[]
| select(.key != "_meta")
| "INSERT OR REPLACE INTO prefs (key, value, updated_at, updated_by) VALUES ("
  + (.key | q) + ", " + ((.value | tojson) | q) + ", "
  + ($ts | q) + ", " + ($by | q) + ");"
JQEOF
)
    if sql=$(jq -r "$prog" "$claim" 2>/dev/null) && [[ -n "$sql" ]]; then
        printf 'BEGIN IMMEDIATE;\n%s\nCOMMIT;\n' "$sql" | soren_db 2>/dev/null || true
    fi
    if [[ -e "${f}.migrated" ]]; then
        mv "$claim" "${f}.migrated.$(date +%s).$$" 2>/dev/null || true
    else
        mv "$claim" "${f}.migrated" 2>/dev/null || true
    fi
}

init_state() {
    _prefs_ensure_schema
    # Order matters: prefs.json (the server's store) is imported second so it
    # wins any key conflicts.
    _prefs_import_file "$PREFERENCES_FILE"
    _prefs_import_file "$SERVER_PREFS_FILE"
}

is_valid_key() {
    local key="$1"
    for k in $VALID_KEYS; do
        [[ "$k" == "$key" ]] && return 0
    done
    return 1
}

# Read one key from the table; fall back to the default when missing or not a
# clean integer (values are stored as JSON — ints are stored bare).
pref_value() {
    local key="$1"
    local val
    val=$(soren_db "SELECT value FROM prefs WHERE key = '$(sql_q "$key")';" 2>/dev/null) || val=""
    if ! [[ "$val" =~ ^[0-9]+$ ]]; then
        val=$(default_for "$key")
    fi
    echo "$val"
}

level_bar() {
    local val="$1"
    local bar=""
    for i in $(seq 1 10); do
        if [[ $i -le $val ]]; then
            bar="${bar}█"
        else
            bar="${bar}░"
        fi
    done
    echo "$bar"
}

level_color() {
    local val="$1"
    if [[ $val -le 3 ]]; then
        echo -e "${CYAN}"
    elif [[ $val -le 6 ]]; then
        echo -e "${YELLOW}"
    else
        echo -e "${GREEN}"
    fi
}

#-------------------------------------------------------------------------------
# Commands
#-------------------------------------------------------------------------------

cmd_list() {
    echo -e "${BOLD}SOREN Agent Preferences${NC}"
    echo -e "${DIM}All values 1-10. Use 'prefs set <key> <value>' to change.${NC}"
    echo ""
    printf "${DIM}%-16s  %-5s  %-12s  %s${NC}\n" "SETTING" "VALUE" "LEVEL" "DESCRIPTION"
    echo -e "${DIM}────────────────  ─────  ────────────  ──────────────────────────────────────────────────${NC}"

    for key in $VALID_KEYS; do
        local val
        val=$(pref_value "$key")
        local color
        color=$(level_color "$val")
        local bar
        bar=$(level_bar "$val")
        local desc
        desc=$(description_for "$key")

        printf "%-16s  ${color}%-5s${NC}  ${color}%s${NC}  %s\n" "$key" "$val" "$bar" "$desc"
    done

    echo ""
    local meta updated_at updated_by
    meta=$(soren_db -separator $'\t' "SELECT IFNULL(updated_at, ''), IFNULL(updated_by, '')
        FROM prefs
        WHERE key IN ('alertness','verbosity','autonomy','humor','proactiveness','journal_detail')
        ORDER BY updated_at DESC LIMIT 1;" 2>/dev/null) || meta=""
    updated_at=$(printf '%s' "$meta" | cut -f1)
    updated_by=$(printf '%s' "$meta" | cut -f2)
    [[ -z "$updated_at" ]] && updated_at="unknown"
    [[ -z "$updated_by" ]] && updated_by="unknown"
    echo -e "${DIM}Last updated: ${updated_at} by ${updated_by}${NC}"
}

cmd_get() {
    local key="${1:-}"
    [[ -z "$key" ]] && die "usage: prefs get <key>"

    is_valid_key "$key" || die "unknown setting: $key (valid: $VALID_KEYS)"

    local val
    val=$(pref_value "$key")
    local desc
    desc=$(description_for "$key")
    local color
    color=$(level_color "$val")
    local bar
    bar=$(level_bar "$val")

    echo -e "${BOLD}${key}${NC}: ${color}${val}${NC}  ${color}${bar}${NC}"
    echo -e "${DIM}${desc}${NC}"
}

cmd_set() {
    local key="${1:-}"
    local value="${2:-}"

    [[ -z "$key" ]] && die "usage: prefs set <key> <value>"
    [[ -z "$value" ]] && die "usage: prefs set <key> <value>"

    is_valid_key "$key" || die "unknown setting: $key (valid: $VALID_KEYS)"

    # Validate integer 1-10
    if ! [[ "$value" =~ ^[0-9]+$ ]] || [[ "$value" -lt 1 ]] || [[ "$value" -gt 10 ]]; then
        die "value must be an integer from 1 to 10 (got: $value)"
    fi

    local now
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local agent_name="${SOREN_AGENT_NAME:-user}"

    soren_db "INSERT OR REPLACE INTO prefs (key, value, updated_at, updated_by)
        VALUES ('$(sql_q "$key")', '$value', '$(sql_q "$now")', '$(sql_q "$agent_name")');"

    local color
    color=$(level_color "$value")
    local bar
    bar=$(level_bar "$value")
    ok "${key} → ${color}${value}${NC}  ${color}${bar}${NC}"
}

cmd_reset() {
    local now
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local agent_name="${SOREN_AGENT_NAME:-user}"

    local key sql=""
    for key in $VALID_KEYS; do
        sql="${sql}INSERT OR REPLACE INTO prefs (key, value, updated_at, updated_by)
            VALUES ('$key', '$(default_for "$key")', '$(sql_q "$now")', '$(sql_q "$agent_name")');"$'\n'
    done
    printf 'BEGIN IMMEDIATE;\n%s\nCOMMIT;\n' "$sql" | soren_db

    ok "All preferences reset to defaults"
    echo ""
    cmd_list
}

cmd_help() {
    cat << 'EOF'
prefs - TARS-style configurable preferences for SOREN agents

USAGE:
    prefs <command> [arguments]

COMMANDS:
    list                Show all settings with values and descriptions
    get <key>           Show one setting's value and description
    set <key> <value>   Update a setting (1-10 integer)
    reset               Restore all to defaults
    help                Show this help

SETTINGS:
    alertness       How often to alert the user with sound/voice notifications
    verbosity       How detailed agent responses should be (1=terse, 10=explain everything)
    autonomy        How much agents do without asking (1=ask everything, 10=just do it)
    humor           How playful vs dry the tone is
    proactiveness   How aggressively to find work when idle
    journal_detail  How much to journal (1=major events only, 10=everything)

EXAMPLES:
    prefs list                     # See all settings
    prefs set humor 8              # Turn up the humor
    prefs set alertness 3          # Fewer notifications
    prefs set autonomy 10          # Maximum autonomy
    prefs get verbosity            # Check current verbosity
    prefs reset                    # Restore defaults

ENVIRONMENT:
    SOREN_HOME          Project root (default: git rev-parse --show-toplevel)
    SOREN_AGENT_NAME    Agent name for audit trail (default: user)

STORAGE:
    The `prefs` table in .soren/soren.db (override with SOREN_DB), shared with
    the server API (/api/prefs). The legacy .soren/preferences.json and
    .soren/prefs.json are imported once and renamed *.migrated.
EOF
}

#-------------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------------

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        list|ls)    init_state; cmd_list "$@" ;;
        get)        init_state; cmd_get "$@" ;;
        set)        init_state; cmd_set "$@" ;;
        reset)      init_state; cmd_reset "$@" ;;
        help|--help|-h) cmd_help ;;
        *)          die "unknown command: $cmd (try 'prefs help')" ;;
    esac
}

main "$@"
