#!/usr/bin/env bash
#===============================================================================
# journal - Quick journal entries for SOREN agents
#
# Usage:
#   journal log "<what you did>"                 - Quick one-liner
#   journal note "<title>" "<detail>"            - Titled entry with detail
#   journal decision "<what>" "<why>"            - Record a decision
#   journal read [date]                          - Read today's (or given date's) journal
#   journal dates                                - List dates with entries
#
# Designed for agents to journal instinctively with minimal friction.
# Every command is one line - no excuses not to journal.
#
# Writes directly to the filesystem — no API dependency.
#
# SCOPING: journal storage is split into a single global supervisor journal
# and one isolated journal per team:
#   .soren/journal/supervisor/<date>/journal.md   (the default)
#   .soren/journal/teams/<prefix>/<date>/journal.md
#
# Every command here transparently targets the CALLER's own scope: if
# $SOREN_AGENT_NAME is a member of a team (per the `teams` table), reads and
# writes go to that team's own journal; otherwise they go to the supervisor's
# global journal. There is deliberately no flag to target a different scope
# — a team's journal is private working memory for that team, and the
# supervisor's is the single system-wide record. See
# .opencode/skills/journal/SKILL.md.
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
JOURNAL_DIR="${SOREN_HOME}/.soren/journal"

# shellcheck source=/dev/null
source "${SOREN_HOME}/tools/lib/db.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $1"; }

sql_q() { printf '%s' "$1" | sed "s/'/''/g"; }

#-------------------------------------------------------------------------------
# Scope resolution
#-------------------------------------------------------------------------------

# Prints the journal root directory for the calling agent's own scope: a
# team's journal directory if $SOREN_AGENT_NAME is listed as a member of a
# `teams` table row, otherwise the supervisor's global journal directory.
# Best-effort — any DB error (e.g. no .soren/soren.db yet, first run before
# any team exists) falls back to the supervisor scope rather than failing.
resolve_scope_dir() {
    local agent="${SOREN_AGENT_NAME:-}"
    local team=""
    if [[ -n "$agent" ]]; then
        team=$(soren_db "SELECT prefix FROM teams, json_each(teams.members)
            WHERE json_each.value = '$(sql_q "$agent")' LIMIT 1;" 2>/dev/null || true)
    fi
    if [[ -n "$team" ]]; then
        echo "${JOURNAL_DIR}/teams/${team}"
    else
        echo "${JOURNAL_DIR}/supervisor"
    fi
}

#-------------------------------------------------------------------------------
# Helpers
#-------------------------------------------------------------------------------

ensure_day_dir() {
    local scope_dir="$1"
    local target_date="$2"
    local day_dir="${scope_dir}/${target_date}"
    mkdir -p "${day_dir}/artifacts"

    local journal_file="${day_dir}/journal.md"
    if [[ ! -f "$journal_file" ]]; then
        printf '# Journal - %s\n' "$target_date" > "$journal_file"
    fi
}

append_entry() {
    local title="$1"
    local content="${2:-}"
    local scope_dir
    scope_dir="$(resolve_scope_dir)"
    local target_date
    target_date="$(date +%Y-%m-%d)"
    local time_str
    time_str="$(date +%H:%M)"

    ensure_day_dir "$scope_dir" "$target_date"

    local journal_file="${scope_dir}/${target_date}/journal.md"

    # Skip if last entry has identical title (dedup)
    local last_title
    last_title=$(grep '^## ' "$journal_file" 2>/dev/null | tail -1 | sed 's/^## [0-9:]* - //' | sed 's/^\[.*\] //' || true)
    if [[ -n "$last_title" && "$last_title" == "$title" ]]; then
        ok "Skipped duplicate: $title"
        return 1
    fi

    # Include project tag if SOREN_PROJECT_ID is set
    local header
    if [[ -n "${SOREN_PROJECT_ID:-}" ]]; then
        header="## ${time_str} - [${SOREN_PROJECT_ID}] ${title}"
    else
        header="## ${time_str} - ${title}"
    fi

    if [[ -n "$content" ]]; then
        printf '\n%s\n%s\n' "$header" "$content" >> "$journal_file"
    else
        printf '\n%s\n' "$header" >> "$journal_file"
    fi
}

#-------------------------------------------------------------------------------
# Commands
#-------------------------------------------------------------------------------

cmd_log() {
    local entry="${1:-}"
    [[ -z "$entry" ]] && die "usage: journal log \"<what you did>\""

    if append_entry "$entry" ""; then ok "Logged: ${entry:0:60}"; fi
}

cmd_note() {
    local title="${1:-}"
    local detail="${2:-}"
    [[ -z "$title" ]] && die "usage: journal note \"<title>\" \"<detail>\""
    [[ -z "$detail" ]] && die "usage: journal note \"<title>\" \"<detail>\""

    if append_entry "$title" "$detail"; then ok "Noted: $title"; fi
}

cmd_decision() {
    local what="${1:-}"
    local why="${2:-}"
    [[ -z "$what" ]] && die "usage: journal decision \"<what>\" \"<why>\""
    [[ -z "$why" ]] && die "usage: journal decision \"<what>\" \"<why>\""

    local content
    content="$(printf '**Decision:** %s\n\n**Rationale:** %s' "$what" "$why")"

    if append_entry "Decision: $what" "$content"; then ok "Decision recorded: $what"; fi
}

cmd_read() {
    local target_date="${1:-$(date +%Y-%m-%d)}"
    local scope_dir
    scope_dir="$(resolve_scope_dir)"
    local journal_file="${scope_dir}/${target_date}/journal.md"

    if [[ ! -f "$journal_file" ]]; then
        echo -e "${DIM}No journal entries for ${target_date}${NC}"
        return
    fi

    echo -e "${CYAN}Journal - ${target_date}${NC}"
    echo ""
    cat "$journal_file"
}

cmd_dates() {
    local scope_dir
    scope_dir="$(resolve_scope_dir)"

    if [[ ! -d "$scope_dir" ]]; then
        echo -e "${DIM}No journal entries found${NC}"
        return
    fi

    local found=0
    # List directories matching YYYY-MM-DD that contain journal.md, sorted reverse
    for dir in $(ls -1d "${scope_dir}"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] 2>/dev/null | sort -r); do
        if [[ -f "${dir}/journal.md" ]]; then
            if [[ $found -eq 0 ]]; then
                echo -e "${CYAN}Journal dates:${NC}"
                found=1
            fi
            basename "$dir"
        fi
    done

    if [[ $found -eq 0 ]]; then
        echo -e "${DIM}No journal entries found${NC}"
    fi
}

cmd_help() {
    cat << 'EOF'
journal - Quick journal entries for SOREN agents

USAGE:
    journal <command> [arguments]

COMMANDS:
    log "<entry>"                   Quick one-liner (most common)
    note "<title>" "<detail>"       Titled entry with body
    decision "<what>" "<why>"       Record a decision with rationale
    read [YYYY-MM-DD]               Read journal (default: today)
    dates                           List dates with entries
    help                            Show this help

EXAMPLES:
    # Quick log (use this most often - it's one line!)
    journal log "Fixed auth bug in token.py, was using wrong timezone"
    journal log "Spawned worker-frontend for dashboard redesign"
    journal log "Tests passing after JWT refactor"

    # Detailed note
    journal note "Auth Investigation" "Found three issues:
    1. Token expiry uses local time instead of UTC
    2. Refresh endpoint missing rate limiting
    3. Session store not cleaned up on logout"

    # Decision record
    journal decision "Use JSONL for mailbox" "Eliminates parsing ambiguity, keeps file-based resilience"

    # Read today's journal
    journal read

    # Read a specific day
    journal read 2026-02-18

SCOPE:
    Every command above transparently reads/writes YOUR OWN journal: your
    team's journal if you're on a team, otherwise the supervisor's global
    journal. This is automatic based on your agent identity — there is no
    flag to target another scope.

ENVIRONMENT:
    SOREN_HOME          Project root (default: git rev-parse --show-toplevel)
    SOREN_AGENT_NAME     Your agent identity, used to resolve your team (if any)
EOF
}

#-------------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------------

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        log)      cmd_log "$@" ;;
        note)     cmd_note "$@" ;;
        decision) cmd_decision "$@" ;;
        read)     cmd_read "$@" ;;
        dates)    cmd_dates "$@" ;;
        help|--help|-h) cmd_help ;;
        *)        die "unknown command: $cmd (try 'journal help')" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
