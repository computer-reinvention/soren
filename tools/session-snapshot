#!/usr/bin/env bash
#===============================================================================
# session-snapshot - Generate machine-readable JSON snapshot of session state
#
# Usage: session-snapshot
#
# Saves to .soren/journal/YYYY-MM-DD/session-snapshot.json (overwrites).
# A new supervisor can read this JSON first for instant orientation.
# Designed to complete in <10s.
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
SOREN_PORT="${SOREN_PORT:-8000}"
SOREN_SESSION="${SOREN_SESSION:-soren}"
STATUS_LOG="$SOREN_HOME/.soren/status.log"
DB="$SOREN_HOME/.soren/tasks.db"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $1"; }

TODAY=$(date +%Y-%m-%d)
OUTDIR="$SOREN_HOME/.soren/journal/$TODAY"
OUTFILE="$OUTDIR/session-snapshot.json"
mkdir -p "$OUTDIR"

TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)

#───────────────────────────────────────────────────────────────────────────────
# 1. Active workers — from agents API (combines registry + tmux)
#───────────────────────────────────────────────────────────────────────────────

active_workers="[]"
agents_json=$(curl -sf --max-time 3 "http://localhost:${SOREN_PORT}/api/agents" 2>/dev/null) || true
if [[ -n "$agents_json" ]]; then
    active_workers=$(echo "$agents_json" | jq '[.agents[] | {name: .name, status: .status}]' 2>/dev/null) || active_workers="[]"
fi

#───────────────────────────────────────────────────────────────────────────────
# 2. Pending tasks — from tasks API
#───────────────────────────────────────────────────────────────────────────────

pending_tasks="[]"
tasks_json=$(curl -sf --max-time 3 "http://localhost:${SOREN_PORT}/api/tasks?status=pending" 2>/dev/null) || true
if [[ -n "$tasks_json" ]]; then
    pending_tasks=$(echo "$tasks_json" | jq '[.tasks[] | {title: .title, assigned_to: .assigned_to, priority: .priority}]' 2>/dev/null) || pending_tasks="[]"
fi

#───────────────────────────────────────────────────────────────────────────────
# 3. Due reminders
#───────────────────────────────────────────────────────────────────────────────

due_reminders="[]"
reminders_json=$(curl -sf --max-time 3 "http://localhost:${SOREN_PORT}/api/tasks/reminders/due" 2>/dev/null) || true
if [[ -n "$reminders_json" ]]; then
    due_reminders=$(echo "$reminders_json" | jq '[.tasks[] | {title: .title, due_date: .due_date}]' 2>/dev/null) || due_reminders="[]"
fi

#───────────────────────────────────────────────────────────────────────────────
# 4. Recent failures — grep status.log for WARN/ERROR/FAIL in last hour
#───────────────────────────────────────────────────────────────────────────────

recent_failures="[]"
if [[ -f "$STATUS_LOG" ]]; then
    one_hour_ago=$(date -u -v-1H +%Y-%m-%dT%H:%M 2>/dev/null || date -u -d '1 hour ago' +%Y-%m-%dT%H:%M 2>/dev/null || echo "")
    if [[ -n "$one_hour_ago" ]]; then
        # Grab lines with WARN/ERROR/FAIL from the last hour
        failure_lines=""
        failure_lines=$(tail -500 "$STATUS_LOG" | grep -iE 'WARN|ERROR|FAIL' | while IFS= read -r line; do
            line_ts=$(echo "$line" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}' | head -1)
            if [[ -n "$line_ts" && "$line_ts" > "$one_hour_ago" ]]; then
                echo "$line"
            fi
        done | tail -20) || true
        if [[ -n "$failure_lines" ]]; then
            recent_failures=$(echo "$failure_lines" | jq -R -s 'split("\n") | map(select(length > 0))' 2>/dev/null) || recent_failures="[]"
        fi
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 5. System health — run system-verify
#───────────────────────────────────────────────────────────────────────────────

sys_passed=0
sys_failed=0
syscheck_tool="$SOREN_HOME/tools/system-verify"
if [[ -x "$syscheck_tool" ]]; then
    syscheck_output=$("$syscheck_tool" 2>&1) || true
    sys_passed=$(echo "$syscheck_output" | grep -c '✓' 2>/dev/null || true)
    sys_failed=$(echo "$syscheck_output" | grep -c '✗' 2>/dev/null || true)
    [[ -z "$sys_passed" ]] && sys_passed=0
    [[ -z "$sys_failed" ]] && sys_failed=0
fi
system_health=$(jq -n --argjson passed "$sys_passed" --argjson failed "$sys_failed" \
    '{passed: $passed, failed: $failed, status: (if $failed == 0 then "healthy" else "degraded" end)}')

#───────────────────────────────────────────────────────────────────────────────
# 6. Git state
#───────────────────────────────────────────────────────────────────────────────

git_branch=$(git -C "$SOREN_HOME" branch --show-current 2>/dev/null || echo "unknown")
last_commit_hash=$(git -C "$SOREN_HOME" log -1 --format="%H" 2>/dev/null || echo "")
last_commit_short=$(git -C "$SOREN_HOME" log -1 --format="%h" 2>/dev/null || echo "")
last_commit_msg=$(git -C "$SOREN_HOME" log -1 --format="%s" 2>/dev/null || echo "")
uncommitted_count=$(git -C "$SOREN_HOME" status --porcelain 2>/dev/null | wc -l | tr -d ' ')

git_state=$(jq -n \
    --arg branch "$git_branch" \
    --arg hash "$last_commit_hash" \
    --arg short "$last_commit_short" \
    --arg message "$last_commit_msg" \
    --argjson uncommitted "$uncommitted_count" \
    '{branch: $branch, last_commit: {hash: $hash, short: $short, message: $message}, uncommitted_files: $uncommitted}')

#───────────────────────────────────────────────────────────────────────────────
# 7. Backlog count
#───────────────────────────────────────────────────────────────────────────────

backlog_count=0
if [[ -f "$DB" ]]; then
    backlog_count=$(sqlite3 "$DB" "SELECT COUNT(*) FROM tasks WHERE status='backlog';" 2>/dev/null || echo "0")
fi

#───────────────────────────────────────────────────────────────────────────────
# Assemble and write
#───────────────────────────────────────────────────────────────────────────────

jq -n \
    --arg timestamp "$TIMESTAMP" \
    --argjson active_workers "$active_workers" \
    --argjson pending_tasks "$pending_tasks" \
    --argjson due_reminders "$due_reminders" \
    --argjson recent_failures "$recent_failures" \
    --argjson system_health "$system_health" \
    --argjson git_state "$git_state" \
    --argjson backlog_count "$backlog_count" \
    '{
        timestamp: $timestamp,
        active_workers: $active_workers,
        pending_tasks: $pending_tasks,
        due_reminders: $due_reminders,
        recent_failures: $recent_failures,
        system_health: $system_health,
        git_state: $git_state,
        backlog_count: $backlog_count
    }' > "$OUTFILE"

ok "Session snapshot saved: $OUTFILE"
