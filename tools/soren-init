#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════════════
# soren-init — unified project onboarding
#
# Usage:
#   tools/soren-init <path> [--name <name>] [--description <desc>]
#                          [--no-hooks] [--no-activate] [--no-index]
#                          [--dry-run]
#
# Steps:
#   1. Validate path (exists, is a git repo)
#   2. Auto-detect language, git remote, project name, build/test commands
#   3. Register project via projects add
#   4. Generate worker context file with detected tech stack
#   5. Install Claude hooks (unless --no-hooks)
#   6. Activate project supervisor (unless --no-activate)
#   7. Index into memory (unless --no-index)
#   8. Print summary
#═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOREN_HOME="${SOREN_HOME:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || echo "$SCRIPT_DIR/..")}"
SOREN_HOME="$(cd "$SOREN_HOME" && pwd)"
REGISTRY="${SOREN_HOME}/.soren/projects.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# ── Helpers ──────────────────────────────────────────────────────────────────

die()  { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
info() { echo -e "${CYAN}▶${NC} $1"; }
ok()   { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }
step() { echo -e "\n${BOLD}[$1]${NC} $2"; }

# ── Auto-detection functions ──────────────────────────────────────────────────

detect_language() {
    local dir="$1"
    local langs=()
    [[ -f "$dir/pyproject.toml" || -f "$dir/setup.py" || -f "$dir/requirements.txt" ]] && langs+=("Python")
    [[ -f "$dir/package.json" ]] && langs+=("JavaScript/TypeScript")
    [[ -f "$dir/Cargo.toml" ]] && langs+=("Rust")
    [[ -f "$dir/go.mod" ]] && langs+=("Go")
    [[ -f "$dir/pom.xml" || -f "$dir/build.gradle" ]] && langs+=("Java")
    [[ -f "$dir/Gemfile" ]] && langs+=("Ruby")
    if [[ ${#langs[@]} -eq 0 ]]; then
        echo "unknown"
    else
        echo "$(IFS=", "; echo "${langs[*]}")"
    fi
}

detect_readme_description() {
    local dir="$1"
    local readme=""
    # Try README variants
    for f in README.md README.rst README.txt readme.md; do
        if [[ -f "$dir/$f" ]]; then
            readme="$dir/$f"
            break
        fi
    done
    if [[ -z "$readme" ]]; then
        echo ""
        return 0
    fi
    # Extract first non-empty, non-heading line from README
    local line
    while IFS= read -r line; do
        line="${line#"${line%%[![:space:]]*}"}"  # trim leading whitespace
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^[#] ]] && continue   # skip heading lines
        [[ "$line" =~ ^\! ]] && continue    # skip badge lines
        [[ "$line" =~ ^\[ ]] && continue    # skip link-only lines
        # Strip markdown formatting for a clean description
        line="${line//\*\*/}"
        line="${line//\*/}"
        line="${line//\`/}"
        echo "${line:0:120}"
        return
    done < "$readme"
    echo ""
}

detect_project_name() {
    local dir="$1"
    local basename
    basename="$(basename "$dir")"

    # Try package.json "name" field
    if [[ -f "$dir/package.json" ]]; then
        local pkg_name
        pkg_name=$(python3 -c "import json; d=json.load(open('$dir/package.json')); print(d.get('name',''))" 2>/dev/null || echo "")
        if [[ -n "$pkg_name" ]]; then
            # Convert kebab-case/snake_case to Title Case
            echo "$pkg_name" | sed 's/[-_]/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1'
            return
        fi
    fi

    # Try pyproject.toml "name" field
    if [[ -f "$dir/pyproject.toml" ]]; then
        local py_name
        py_name=$(python3 -c "
try:
    import tomllib
except ImportError:
    try:
        import tomli as tomllib
    except ImportError:
        exit(1)
with open('$dir/pyproject.toml', 'rb') as f:
    d = tomllib.load(f)
print(d.get('project', {}).get('name', '') or d.get('tool', {}).get('poetry', {}).get('name', ''))
" 2>/dev/null || echo "")
        if [[ -n "$py_name" ]]; then
            echo "$py_name" | sed 's/[-_]/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1'
            return
        fi
    fi

    # Fallback: capitalize directory basename
    echo "$basename" | sed 's/[-_]/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1'
}

detect_build_commands() {
    # Returns a JSON-like dict printed line by line: key=value
    local dir="$1"
    local build="" test="" dev="" lint="" run=""

    # package.json scripts
    if [[ -f "$dir/package.json" ]]; then
        local scripts
        scripts=$(python3 -c "
import json, sys
try:
    d = json.load(open('$dir/package.json'))
    s = d.get('scripts', {})
    for k in ['build','test','dev','start','lint','typecheck','check']:
        if k in s:
            print(f'{k}={s[k]}')
except Exception:
    pass
" 2>/dev/null || echo "")
        local has_npm=0
        while IFS='=' read -r key val; do
            [[ -z "$key" ]] && continue
            has_npm=1
            case "$key" in
                build)      build="npm run build" ;;
                test)       test="npm run test" ;;
                dev|start)  [[ -z "$dev" ]] && dev="npm run $key" ;;
                lint)       lint="npm run lint" ;;
                typecheck|check) [[ -z "$lint" ]] && lint="npm run $key" ;;
            esac
        done <<< "$scripts"
    fi

    # pyproject.toml
    if [[ -f "$dir/pyproject.toml" ]]; then
        # Check for pytest configuration
        local has_pytest
        has_pytest=$(grep -l "pytest" "$dir/pyproject.toml" 2>/dev/null || echo "")
        if [[ -n "$has_pytest" ]]; then
            [[ -z "$test" ]] && test="uv run pytest"
        fi
        # Check for build system
        local has_build
        has_build=$(grep -l "build-backend\|build_backend" "$dir/pyproject.toml" 2>/dev/null || echo "")
        if [[ -n "$has_build" ]]; then
            [[ -z "$build" ]] && build="uv build"
        fi
        # Generic python run
        [[ -z "$run" ]] && run="uv run python -m <module>"
    elif [[ -f "$dir/requirements.txt" ]]; then
        [[ -z "$test" ]] && test="pytest"
    fi

    # Makefile — extract common targets
    if [[ -f "$dir/Makefile" ]]; then
        local mk_targets
        mk_targets=$(grep -E '^[a-zA-Z][a-zA-Z0-9_-]*:' "$dir/Makefile" 2>/dev/null | cut -d: -f1 | tr '\n' ' ' || echo "")
        for t in $mk_targets; do
            case "$t" in
                build)     [[ -z "$build" ]] && build="make build" ;;
                test|tests) [[ -z "$test" ]] && test="make test" ;;
                dev|start|run) [[ -z "$dev" ]] && dev="make $t" ;;
                lint|format) [[ -z "$lint" ]] && lint="make $t" ;;
            esac
        done
    fi

    # Cargo.toml
    if [[ -f "$dir/Cargo.toml" ]]; then
        [[ -z "$build" ]] && build="cargo build"
        [[ -z "$test" ]] && test="cargo test"
        [[ -z "$run" ]] && run="cargo run"
        [[ -z "$lint" ]] && lint="cargo clippy"
    fi

    # go.mod
    if [[ -f "$dir/go.mod" ]]; then
        [[ -z "$build" ]] && build="go build ./..."
        [[ -z "$test" ]] && test="go test ./..."
        [[ -z "$run" ]] && run="go run ."
        [[ -z "$lint" ]] && lint="go vet ./..."
    fi

    # Print as key=value for easy parsing
    [[ -n "$build" ]] && echo "build=$build" || true
    [[ -n "$test" ]]  && echo "test=$test"   || true
    [[ -n "$dev" ]]   && echo "dev=$dev"     || true
    [[ -n "$lint" ]]  && echo "lint=$lint"   || true
    [[ -n "$run" ]]   && echo "run=$run"     || true
    return 0
}

detect_git_remote() {
    local dir="$1"
    git -C "$dir" remote get-url origin 2>/dev/null || echo ""
}

# ── Worker context generation ─────────────────────────────────────────────────

generate_worker_context() {
    local id="$1"
    local name="$2"
    local project_path="$3"
    local language="$4"
    local build_cmds="$5"  # newline-separated key=value pairs

    local context_dir="${SOREN_HOME}/.soren/worker-contexts"
    mkdir -p "$context_dir"
    local context_file="${context_dir}/${id}-worker-role.md"

    # Parse build commands
    local cmd_build="" cmd_test="" cmd_dev="" cmd_lint="" cmd_run=""
    while IFS='=' read -r key val; do
        [[ -z "$key" ]] && continue
        case "$key" in
            build) cmd_build="$val" ;;
            test)  cmd_test="$val" ;;
            dev)   cmd_dev="$val" ;;
            lint)  cmd_lint="$val" ;;
            run)   cmd_run="$val" ;;
        esac
    done <<< "$build_cmds"

    cat > "$context_file" << CTXEOF
# Worker Context: ${name}

You are a worker agent in the SOREN multi-agent system, assigned to the **${name}** project.

## Project

- **ID**: ${id}
- **Name**: ${name}
- **Path**: ${project_path}
- **Language / Stack**: ${language}

## Build & Test Commands

$(if [[ -n "$cmd_build" ]]; then echo "- **Build**: \`${cmd_build}\`"; fi)
$(if [[ -n "$cmd_test" ]]; then echo "- **Test**: \`${cmd_test}\`"; fi)
$(if [[ -n "$cmd_dev" ]]; then echo "- **Dev server**: \`${cmd_dev}\`"; fi)
$(if [[ -n "$cmd_lint" ]]; then echo "- **Lint/typecheck**: \`${cmd_lint}\`"; fi)
$(if [[ -n "$cmd_run" ]]; then echo "- **Run**: \`${cmd_run}\`"; fi)
$(if [[ -z "${cmd_build}${cmd_test}${cmd_dev}${cmd_lint}${cmd_run}" ]]; then echo "_No build commands auto-detected. Check Makefile, package.json, or pyproject.toml._"; fi)

## Conventions

> _Fill this section in with project-specific conventions, coding standards, and common pitfalls._
>
> Examples:
> - "Always use X pattern for Y"
> - "Tests live in tests/ and must be named test_*.py"
> - "Never commit directly to main"

## Key Files

> _List important files and their purpose once you've explored the codebase._

## Notes

> _Add anything else workers need to know: authentication, environment variables, external services, gotchas._
CTXEOF

    echo "$context_file"
}

# ── Main ──────────────────────────────────────────────────────────────────────

usage() {
    cat << 'EOF'
soren-init — unified project onboarding

USAGE:
    tools/soren-init <path> [options]

ARGUMENTS:
    path                    Path to the project directory

OPTIONS:
    --name <name>           Project display name (auto-detected if omitted)
    --description <desc>    Project description (auto-detected from README if omitted)
    --no-hooks              Skip installing Claude hooks in the project
    --no-activate           Skip spawning the project supervisor
    --no-index              Skip indexing project docs into memory
    --dry-run               Show what would be done without making changes
    -h, --help              Show this help

WHAT IT DOES:
    1. Validates path (exists, is a git repo)
    2. Auto-detects language, git remote, project name, build/test commands
    3. Registers project (tools/projects add)
    4. Generates worker context file with detected stack and commands
    5. Installs Claude hooks (tools/projects install-hooks)
    6. Activates project supervisor (tools/projects activate)
    7. Indexes docs into memory (tools/memory-index --project <id>)
    8. Prints summary

EXAMPLES:
    tools/soren-init /path/to/my-api
    tools/soren-init /path/to/frontend --name "My Frontend" --no-activate
    tools/soren-init /path/to/project --dry-run
EOF
}

main() {
    local path=""
    local name=""
    local description=""
    local no_hooks=0
    local no_activate=0
    local no_index=0
    local dry_run=0

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                [[ -z "${2:-}" ]] && die "--name requires a value"
                name="$2"; shift 2 ;;
            --description|--desc)
                [[ -z "${2:-}" ]] && die "--description requires a value"
                description="$2"; shift 2 ;;
            --no-hooks)
                no_hooks=1; shift ;;
            --no-activate)
                no_activate=1; shift ;;
            --no-index)
                no_index=1; shift ;;
            --dry-run)
                dry_run=1; shift ;;
            -h|--help)
                usage; exit 0 ;;
            -*)
                die "unknown option: $1 (try --help)" ;;
            *)
                if [[ -z "$path" ]]; then
                    path="$1"
                else
                    die "unexpected argument: $1"
                fi
                shift ;;
        esac
    done

    [[ -z "$path" ]] && { usage; exit 1; }

    # ── Step 1: Validate path ─────────────────────────────────────────────────
    step "1/8" "Validating path"

    [[ -e "$path" ]] || die "path does not exist: $path"
    [[ -d "$path" ]] || die "path is not a directory: $path"

    path="$(cd "$path" && pwd)"
    ok "Path exists: $path"

    if git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
        ok "Git repository detected"
    else
        warn "Not a git repository — hooks and version tracking will be limited"
    fi

    # Derive project ID (same logic as tools/projects add)
    local id
    id="$(basename "$path" | tr '[:upper:]' '[:lower:]' | tr ' .' '-' | tr -cd 'a-z0-9-')"
    [[ -z "$id" ]] && die "could not derive project ID from path basename"

    # Check if already registered
    if [[ -f "$REGISTRY" ]]; then
        if jq -e --arg id "$id" '.projects[] | select(.id == $id)' "$REGISTRY" >/dev/null 2>&1; then
            die "project '$id' is already registered. To re-onboard: tools/projects remove $id && tools/soren-init $path"
        fi
    fi

    # ── Step 2: Auto-detect ───────────────────────────────────────────────────
    step "2/8" "Auto-detecting project info"

    local language
    language="$(detect_language "$path")"
    ok "Language: $language"

    local git_remote
    git_remote="$(detect_git_remote "$path")"
    [[ -n "$git_remote" ]] && ok "Git remote: $git_remote"

    # Auto-detect name if not provided
    if [[ -z "$name" ]]; then
        name="$(detect_project_name "$path")"
        info "Name auto-detected: $name"
    else
        ok "Name: $name"
    fi

    # Auto-detect description if not provided
    if [[ -z "$description" ]]; then
        description="$(detect_readme_description "$path")"
        if [[ -n "$description" ]]; then
            info "Description from README: ${description:0:80}..."
        else
            description="Project at $path"
            info "Description: $description"
        fi
    else
        ok "Description: $description"
    fi

    # Detect build/test commands
    local build_cmds
    build_cmds="$(detect_build_commands "$path")"
    if [[ -n "$build_cmds" ]]; then
        ok "Build commands detected:"
        while IFS='=' read -r key val; do
            [[ -z "$key" ]] && continue
            echo "       $key: $val"
        done <<< "$build_cmds"
    else
        warn "No build commands auto-detected"
    fi

    # Dry run: print summary and exit
    if [[ $dry_run -eq 1 ]]; then
        echo ""
        echo -e "${BOLD}DRY RUN — no changes made${NC}"
        echo ""
        echo "  Project ID:   $id"
        echo "  Name:         $name"
        echo "  Path:         $path"
        echo "  Language:     $language"
        echo "  Description:  $description"
        [[ -n "$git_remote" ]] && echo "  Remote:       $git_remote"
        echo ""
        echo "  Would run:"
        echo "    tools/projects add '$path' --name '$name' --description '...'"
        [[ $no_hooks -eq 0 ]]    && echo "    tools/projects install-hooks $id"
        [[ $no_activate -eq 0 ]] && echo "    tools/projects activate $id"
        [[ $no_index -eq 0 ]]    && echo "    tools/memory-index --project $id"
        echo ""
        echo "  Worker context: .soren/worker-contexts/${id}-worker-role.md"
        exit 0
    fi

    # ── Step 3: Register project ──────────────────────────────────────────────
    step "3/8" "Registering project"

    "${SOREN_HOME}/tools/projects" add "$path" \
        --name "$name" \
        --description "$description"

    # ── Step 4: Generate worker context ──────────────────────────────────────
    step "4/8" "Generating worker context"

    local context_file
    context_file="$(generate_worker_context "$id" "$name" "$path" "$language" "$build_cmds")"
    ok "Worker context: $context_file"
    info "Edit this file to add project-specific conventions and notes"

    # ── Step 5: Install hooks ─────────────────────────────────────────────────
    step "5/8" "Installing Claude hooks"

    if [[ $no_hooks -eq 1 ]]; then
        warn "Skipped (--no-hooks)"
    else
        "${SOREN_HOME}/tools/projects" install-hooks "$id"
    fi

    # ── Step 6: Activate project supervisor ───────────────────────────────────
    step "6/8" "Activating project supervisor"

    if [[ $no_activate -eq 1 ]]; then
        warn "Skipped (--no-activate)"
    else
        "${SOREN_HOME}/tools/projects" activate "$id"
    fi

    # ── Step 7: Index into memory ─────────────────────────────────────────────
    step "7/8" "Indexing project into memory"

    if [[ $no_index -eq 1 ]]; then
        warn "Skipped (--no-index)"
    elif ! command -v uv >/dev/null 2>&1; then
        warn "uv not found — skipping memory index (run: tools/memory-index --project $id)"
    else
        info "Running memory-index for project $id..."
        "${SOREN_HOME}/tools/memory-index" --project "$id" 2>&1 | tail -5 || \
            warn "Memory indexing encountered an issue (non-fatal)"
        ok "Memory index complete"
    fi

    # ── Step 8: Summary ───────────────────────────────────────────────────────
    step "8/8" "Done"
    echo ""
    echo -e "${BOLD}════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  Project '${id}' onboarded successfully${NC}"
    echo -e "${BOLD}════════════════════════════════════════════════${NC}"
    echo ""
    echo "  ID:           $id"
    echo "  Name:         $name"
    echo "  Path:         $path"
    echo "  Language:     $language"
    if [[ $no_activate -eq 0 ]]; then
        echo "  Supervisor:   sup-${id} (running in tmux)"
    fi
    echo ""
    echo -e "${BOLD}Next steps:${NC}"
    echo "  1. Edit worker context: .soren/worker-contexts/${id}-worker-role.md"
    echo "     Add project conventions, key files, and common pitfalls"
    if [[ $no_activate -eq 1 ]]; then
        echo "  2. Activate when ready: tools/projects activate $id"
    fi
    echo ""
    echo -e "  ${DIM}Manage with: tools/projects <list|info|deactivate|remove> $id${NC}"
    echo ""
}

main "$@"
