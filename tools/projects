main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        add)            cmd_add "$@" ;;
        remove)         cmd_remove "$@" ;;
        list)           cmd_list "$@" ;;
        info)           cmd_info "$@" ;;
        activate)       cmd_activate "$@" ;;
        deactivate)     cmd_deactivate "$@" ;;
        install-hooks)  cmd_install_hooks "$@" ;;
        sync-skills)    cmd_sync_skills "$@" ;;
        help|--help|-h) cmd_help ;;
        *)              die "unknown command: $cmd (try 'projects help')" ;;
    esac
}

main "$@"
