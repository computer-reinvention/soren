    # Allocate a dedicated port for the supervisor's embedded opencode server
    local oc_port
    oc_port=$(soren_oc_free_port) || die "could not allocate an opencode port"
    soren_registry_update "$reg_file" --arg key "$sup_name" --argjson p "$oc_port" '.[$key].oc_port = $p'

