#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════════════
# projects - Manage the SOREN project registry
#
# Usage:
#   projects add <path> [--name NAME] [--description DESC]
#   projects remove <id>
#   projects list
#   projects info <id>
#   projects activate <id>
#   projects deactivate <id>
#
# Storage model (matches the agent-registry pattern in tools/lib/opencode.sh):
# the MASTER is the `projects` table in the consolidated SQLite DB
# (.soren/soren.db); .soren/projects.json is a REGENERATED READ-ONLY VIEW of
# that table so existing jq readers (monitor.sh, verify-done.sh, tools/workers,
# scan-project.sh, memory-index, soren-init, soren-run, blocker_detector.py, …)
# keep working unchanged. Never write the JSON file directly — every mutation
# is a sqlite statement followed by a view regeneration (tmp+mv).
#
# View shape is the exact legacy shape: {"projects":[...]} with JSON booleans
# for is_self/active/hooks_installed and null for an unset supervisor_agent_id.
# The view bytes are jq-formatted and byte-identical to the python service's
# regeneration (src/server/services/project_service.py — keep in sync).
#═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
REGISTRY="${SOREN_HOME}/.soren/projects.json"

# Shared opencode helpers (model mapping, ports, health, HTTP send)
source "${SOREN_HOME}/tools/lib/opencode.sh"

# Shared project scanning helpers (stack/command detection)
source "${SOREN_HOME}/tools/lib/scan-project.sh"

# Shared DB helpers (SOREN_DB_PATH resolution + soren_db wrapper)
source "${SOREN_HOME}/tools/lib/db.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

#───────────────────────────────────────────────────────────────────────────────
# Helpers
#───────────────────────────────────────────────────────────────────────────────

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
info() { echo -e "${CYAN}▶${NC} $1"; }
ok() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }

# Escape a value for embedding in a single-quoted SQL literal.
sql_q() { printf '%s' "$1" | sed "s/'/''/g"; }

# Schema for the projects master table.
# NOTE (shared schema): duplicated in src/server/services/project_service.py —
# keep in sync. CREATE IF NOT EXISTS from both sides.
_projects_ensure_schema() {
    soren_db "CREATE TABLE IF NOT EXISTS projects (
        id                  TEXT PRIMARY KEY,
        name                TEXT,
        path                TEXT,
        is_self             INTEGER DEFAULT 0,
        active              INTEGER DEFAULT 1,
        supervisor_agent_id TEXT DEFAULT '',
        hooks_installed     INTEGER DEFAULT 0,
        added_at            TEXT,
        git_remote          TEXT DEFAULT '',
        language            TEXT DEFAULT '',
        description         TEXT DEFAULT ''
    );" 2>/dev/null || true
}

# Serialize the table into the legacy view shape, one JSON object per row.
# Boolean columns become JSON booleans; an empty supervisor_agent_id becomes
# null (both legacy writers emitted null when unset). Key order matches the
# legacy writers (and the python regenerator) for byte-stable views.
_PROJECTS_VIEW_SQL="SELECT json_object(
    'id', id,
    'name', name,
    'path', path,
    'is_self', json(CASE WHEN is_self THEN 'true' ELSE 'false' END),
    'active', json(CASE WHEN active THEN 'true' ELSE 'false' END),
    'supervisor_agent_id', CASE WHEN IFNULL(supervisor_agent_id, '') = '' THEN NULL ELSE supervisor_agent_id END,
    'hooks_installed', json(CASE WHEN hooks_installed THEN 'true' ELSE 'false' END),
    'added_at', added_at,
    'git_remote', IFNULL(git_remote, ''),
    'language', IFNULL(language, ''),
    'description', IFNULL(description, '')
) FROM projects ORDER BY rowid;"

# Regenerate the JSON view from the master (post-commit; tmp+mv in the SAME
# directory so the replacement is an atomic same-filesystem rename). jq '.'
# formatting is byte-identical to the python service's
# json.dumps(indent=2, ensure_ascii=False) + '\n'.
regen_projects_view() {
    local tmp
    tmp=$(mktemp "${REGISTRY}.tmp.XXXXXX") || return 1
    if soren_db "$_PROJECTS_VIEW_SQL" 2>/dev/null | jq -s '{projects: .}' > "$tmp" 2>/dev/null; then
        mv "$tmp" "$REGISTRY"
    else
        rm -f "$tmp"
        return 1
    fi
}

# One-time lazy import: if the table is empty but a populated legacy
# projects.json exists (pre-sqlite era), seed the table from it. The file is
# NOT renamed — it becomes the regenerated view. Idempotent (INSERT OR IGNORE
# + empty-table guard); mirrors the python service's import.
_projects_import_legacy() {
    [[ -s "$REGISTRY" ]] || return 0
    local count
    count=$(soren_db "SELECT COUNT(*) FROM projects;" 2>/dev/null) || count=0
    [[ "$count" == "0" ]] || return 0
    local n
    n=$(jq -r '.projects | length' "$REGISTRY" 2>/dev/null) || n=0
    [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 )) || return 0
    info "Importing ${n} project(s) from legacy $(basename "$REGISTRY") into sqlite"
    local prog sql
    prog=$(cat <<'JQEOF'
def q: "'" + ((. // "") | tostring | gsub("'"; "''")) + "'";
def flag: if . == true then "1" else "0" end;
.projects[]
| "INSERT OR IGNORE INTO projects (id, name, path, is_self, active, supervisor_agent_id, hooks_installed, added_at, git_remote, language, description) VALUES ("
  + (.id | q) + ", " + (.name | q) + ", " + (.path | q) + ", "
  + (.is_self | flag) + ", " + (.active | flag) + ", "
  + (.supervisor_agent_id | q) + ", " + (.hooks_installed | flag) + ", "
  + (.added_at | q) + ", " + (.git_remote | q) + ", "
  + (.language | q) + ", " + (.description | q) + ");"
JQEOF
)
    sql=$(jq -r "$prog" "$REGISTRY" 2>/dev/null) || return 0
    [[ -n "$sql" ]] || return 0
    printf 'BEGIN IMMEDIATE;\n%s\nCOMMIT;\n' "$sql" | soren_db 2>/dev/null || return 0
    # Canonicalize the file now that it is a derived view
    regen_projects_view || true
}

# Ensure schema + one-time import + a readable view file; called by every
# command before touching state.
ensure_registry() {
    mkdir -p "$(dirname "$REGISTRY")"
    _projects_ensure_schema
    _projects_import_legacy
    if [[ ! -f "$REGISTRY" ]]; then
        regen_projects_view || echo '{"projects":[]}' > "$REGISTRY"
    fi
}

project_exists() {
    local n
    n=$(soren_db "SELECT COUNT(*) FROM projects WHERE id = '$(sql_q "$1")';" 2>/dev/null) || n=0
    [[ "$n" != "0" ]]
}

# project_field <id> <column> — print one column for one project (raw sqlite
# output: integers for boolean columns).
project_field() {
    soren_db "SELECT $2 FROM projects WHERE id = '$(sql_q "$1")';" 2>/dev/null
}

detect_git_remote() {
    local dir="$1"
    git -C "$dir" remote get-url origin 2>/dev/null || echo ""
}

detect_language() {
    local dir="$1"
    if [[ -f "$dir/pyproject.toml" ]] || [[ -f "$dir/setup.py" ]]; then
        echo "python"
    elif [[ -f "$dir/package.json" ]]; then
        echo "javascript"
    elif [[ -f "$dir/Cargo.toml" ]]; then
        echo "rust"
    elif [[ -f "$dir/go.mod" ]]; then
        echo "go"
    elif [[ -f "$dir/pom.xml" ]] || [[ -f "$dir/build.gradle" ]]; then
        echo "java"
    elif [[ -f "$dir/Gemfile" ]]; then
        echo "ruby"
    else
        echo "unknown"
    fi
}

# Sanitize a project id into a valid skill-name fragment:
# lowercase, non-alphanumeric runs collapsed to single hyphens, no edge hyphens.
sanitize_skill_id() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# generate_conventions_skill <id> <path>
# Creates .opencode/skills/project-<id>-conventions/SKILL.md in the SOREN repo,
# mechanically derived from the project: stack, key commands, the project's own
# rules file (AGENTS.md/CLAUDE.md), and recent commit style.
generate_conventions_skill() {
    local id="$1"
    local proj_path="$2"

    local sid
    sid=$(sanitize_skill_id "$id")
    if [[ -z "$sid" ]]; then
        warn "cannot derive a skill name from project id '$id' — skipping conventions skill"
        return 1
    fi

    local skill_dir="${SOREN_HOME}/.opencode/skills/project-${sid}-conventions"
    local skill_file="${skill_dir}/SKILL.md"
    mkdir -p "$skill_dir"

    # Detect stack and commands via the shared scan library
    scan_project "$proj_path" quiet

    {
        echo "---"
        echo "name: project-${sid}-conventions"
        echo "description: Conventions, stack, and commands for the ${id} project. Load before working on it."
        echo "---"
        echo ""
        echo "# Project Conventions: ${id}"
        echo ""
        echo "> Auto-generated by \`tools/projects\` at registration. Regenerate with \`./tools/projects sync-skills\`. Do not edit by hand."
        echo ""
        echo "- **Path**: \`${proj_path}\`"
        echo "- **Stack**: ${SCAN_tech_stack:-Unknown}"
        echo ""
        echo "## Key commands"
        echo ""
        if [[ -f "$proj_path/package.json" ]]; then
            echo "From \`package.json\` scripts (run as \`npm run <script>\` or the repo's package manager):"
            echo ""
            echo '```'
            jq -r '.scripts // {} | to_entries[] | "npm run \(.key)\t# \(.value)"' "$proj_path/package.json" 2>/dev/null | head -15
            echo '```'
            echo ""
        fi
        if [[ -f "$proj_path/pyproject.toml" ]]; then
            echo "Python project (\`pyproject.toml\` present — use uv):"
            echo ""
            echo '```'
            echo "uv sync           # install dependencies"
            echo "uv run pytest     # run tests"
            echo "uv run <cmd>      # run any command in the project venv"
            echo '```'
            echo ""
        fi
        if [[ ! -f "$proj_path/package.json" && ! -f "$proj_path/pyproject.toml" ]]; then
            echo "No package.json or pyproject.toml detected — check the project README for build/test commands."
            echo ""
        fi

        # The project's own rules file takes precedence over SOREN defaults
        local rules_file=""
        if [[ -f "$proj_path/AGENTS.md" ]]; then
            rules_file="$proj_path/AGENTS.md"
        elif [[ -f "$proj_path/CLAUDE.md" ]]; then
            rules_file="$proj_path/CLAUDE.md"
        fi
        if [[ -n "$rules_file" ]]; then
            echo "## Project rules (from $(basename "$rules_file"))"
            echo ""
            echo "First ~80 lines, verbatim (full file: \`${rules_file}\`):"
            echo ""
            echo '````'
            head -80 "$rules_file"
            echo '````'
            echo ""
        fi

        # Pointers to other reference docs
        local refs=""
        [[ -f "$proj_path/CONTRIBUTING.md" ]] && refs="${refs}- \`${proj_path}/CONTRIBUTING.md\`"$'\n'
        [[ -f "$proj_path/README.md" ]] && refs="${refs}- \`${proj_path}/README.md\`"$'\n'
        if [[ -n "$refs" ]]; then
            echo "## Reference docs"
            echo ""
            printf '%s' "$refs"
            echo ""
        fi

        echo "## Working conventions"
        echo ""
        echo "- Respect the project's own rules file (AGENTS.md/CLAUDE.md) over SOREN defaults — when they conflict, the project wins."
        echo "- Match the commit style of the project's recent history (\`git log --oneline -10\`):"
        echo ""
        echo '```'
        git -C "$proj_path" log --oneline -10 2>/dev/null || echo "No git history available"
        echo '```'
    } > "$skill_file"

    echo "$skill_file"
}

#───────────────────────────────────────────────────────────────────────────────
# Commands
#───────────────────────────────────────────────────────────────────────────────

cmd_add() {
    local path=""
    local name=""
    local description=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                [[ -z "${2:-}" ]] && die "--name requires a value"
                name="$2"
                shift 2
                ;;
            --description|--desc)
                [[ -z "${2:-}" ]] && die "--description requires a value"
                description="$2"
                shift 2
                ;;
            *)
                if [[ -z "$path" ]]; then
                    path="$1"
                else
                    die "unexpected argument: $1"
                fi
                shift
                ;;
        esac
    done

    [[ -z "$path" ]] && die "usage: projects add <path> [--name NAME] [--description DESC]"

    # Resolve to absolute path
    [[ -d "$path" ]] || die "directory does not exist: $path"
    path="$(cd "$path" && pwd)"

    # Derive ID from directory basename
    local id
    id="$(basename "$path" | tr '[:upper:]' '[:lower:]' | tr ' .' '-' | tr -cd 'a-z0-9-')"
    [[ -z "$id" ]] && die "could not derive project ID from path"

    ensure_registry

    if project_exists "$id"; then
        die "project '$id' already registered (use 'projects remove $id' first)"
    fi

    # Auto-detect
    local git_remote
    git_remote=$(detect_git_remote "$path")
    local language
    language=$(detect_language "$path")

    # Defaults
    [[ -z "$name" ]] && name="$(basename "$path")"
    [[ -z "$description" ]] && description=""

    local now
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    info "Registering project: $id"

    # Add to the sqlite master, then regenerate the view
    soren_db "INSERT INTO projects (id, name, path, is_self, active, supervisor_agent_id, hooks_installed, added_at, git_remote, language, description)
        VALUES ('$(sql_q "$id")', '$(sql_q "$name")', '$(sql_q "$path")', 0, 0, '', 0, '$(sql_q "$now")', '$(sql_q "$git_remote")', '$(sql_q "$language")', '$(sql_q "$description")');" \
        || die "failed to register project '$id'"
    regen_projects_view

    ok "Project '$id' registered"

    # Generate the conventions skill for this project
    local skill_file
    if skill_file=$(generate_conventions_skill "$id" "$path"); then
        ok "Conventions skill generated: $skill_file"
    else
        warn "Could not generate conventions skill for '$id'"
    fi

    echo ""
    echo "  Path:     $path"
    echo "  Language: $language"
    [[ -n "$git_remote" ]] && echo "  Remote:   $git_remote"
    [[ -n "$description" ]] && echo "  Desc:     $description"
    echo ""
    echo "Run 'projects activate $id' to start a project supervisor."
}

cmd_remove() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: projects remove <id>"

    ensure_registry

    if ! project_exists "$id"; then
        die "project '$id' not found"
    fi

    # Prevent removing self-project
    local is_self
    is_self=$(project_field "$id" is_self)
    if [[ "$is_self" == "1" ]]; then
        die "cannot remove SOREN self-project"
    fi

    info "Removing project: $id"

    # Step 1: Deactivate (kill supervisor) if active
    local is_active
    is_active=$(project_field "$id" active)
    if [[ "$is_active" == "1" ]]; then
        info "Deactivating project supervisor..."
        cmd_deactivate "$id" || warn "Failed to deactivate project (continuing removal)"
    fi

    # Step 2: Kill all workers whose SOREN_PROJECT_ID matches this project
    local session="${SOREN_SESSION:-soren}"
    if tmux has-session -t "$session" 2>/dev/null; then
        local windows
        windows=$(tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null || true)
        while IFS= read -r wname; do
            [[ -z "$wname" ]] && continue
            [[ "$wname" == "monitor" ]] && continue
            [[ "$wname" == "supervisor" ]] && continue
            [[ "$wname" == "sentry" ]] && continue
            [[ "$wname" == sup-* ]] && continue

            # Check if this window's SOREN_PROJECT_ID matches
            local pane_pid
            pane_pid=$(tmux list-panes -t "${session}:${wname}" -F '#{pane_pid}' 2>/dev/null | head -1) || continue
            [[ -z "$pane_pid" ]] && continue

            # Check environment of the shell process for SOREN_PROJECT_ID
            local worker_project
            worker_project=$(ps -p "$pane_pid" -o command= 2>/dev/null | grep -o "SOREN_PROJECT_ID=${id}" 2>/dev/null || true)
            if [[ -z "$worker_project" ]]; then
                # Also check via /proc or lsof — try capturing from tmux env
                worker_project=$(tmux show-environment -t "${session}:${wname}" SOREN_PROJECT_ID 2>/dev/null | grep -o "=${id}$" || true)
            fi

            if [[ -n "$worker_project" ]]; then
                info "Killing worker '$wname' (project: $id)"
                tmux send-keys -t "${session}:${wname}" C-c 2>/dev/null || true
                sleep 0.5
                tmux kill-window -t "${session}:${wname}" 2>/dev/null || true
            fi
        done <<< "$windows"
    fi

    # Step 3: Remove the soren-bridge plugin shim if it was installed
    local hooks_installed
    hooks_installed=$(project_field "$id" hooks_installed)
    if [[ "$hooks_installed" == "1" ]]; then
        local project_path
        project_path=$(project_field "$id" path)
        local plugin_file="${project_path}/.opencode/plugins/soren-bridge.ts"
        if [[ -f "$plugin_file" ]]; then
            info "Removing installed soren-bridge plugin: $plugin_file"
            rm -f "$plugin_file"
            # Prune empty .opencode/plugins dirs
            rmdir "${project_path}/.opencode/plugins" 2>/dev/null || true
            rmdir "${project_path}/.opencode" 2>/dev/null || true
            ok "soren-bridge plugin removed"
        fi
    fi

    # Step 4: Remove the auto-generated conventions skill
    local sid
    sid=$(sanitize_skill_id "$id")
    if [[ -n "$sid" ]]; then
        local skill_dir="${SOREN_HOME}/.opencode/skills/project-${sid}-conventions"
        if [[ -d "$skill_dir" ]]; then
            info "Removing conventions skill: $skill_dir"
            rm -rf "$skill_dir"
        fi
    fi

    # Step 5: Remove from the master, regenerate the view
    soren_db "DELETE FROM projects WHERE id = '$(sql_q "$id")';"
    regen_projects_view

    ok "Project '$id' removed"
}

cmd_list() {
    ensure_registry

    local count
    count=$(soren_db "SELECT COUNT(*) FROM projects;")

    if [[ "$count" -eq 0 ]]; then
        echo -e "${DIM}No projects registered${NC}"
        return
    fi

    printf "${BOLD}%-16s %-20s %-8s %-10s %s${NC}\n" "ID" "NAME" "ACTIVE" "LANGUAGE" "PATH"
    printf "%-16s %-20s %-8s %-10s %s\n" "────────────────" "────────────────────" "────────" "──────────" "────────────────────"

    soren_db -separator $'\t' "SELECT id, name, CASE WHEN active THEN 'yes' ELSE 'no' END, IFNULL(language, ''), path FROM projects ORDER BY rowid;" | \
    while IFS=$'\t' read -r id name active lang path; do
        local color="$NC"
        if [[ "$active" == "yes" ]]; then
            color="$GREEN"
        fi
        printf "${color}%-16s %-20s %-8s %-10s %s${NC}\n" "$id" "$name" "$active" "$lang" "$path"
    done

    echo ""
    echo "Total: $count project(s)"
}

cmd_info() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: projects info <id>"

    ensure_registry

    if ! project_exists "$id"; then
        die "project '$id' not found"
    fi

    local data
    data=$(soren_db -json "SELECT * FROM projects WHERE id = '$(sql_q "$id")';" | jq '.[0]')

    echo -e "${BOLD}Project: $(echo "$data" | jq -r '.name')${NC}"
    echo ""
    echo "  ID:          $(echo "$data" | jq -r '.id')"
    echo "  Path:        $(echo "$data" | jq -r '.path')"
    echo "  Active:      $(echo "$data" | jq -r 'if .active == 1 then "yes" else "no" end')"
    echo "  Language:    $(echo "$data" | jq -r 'if (.language // "") == "" then "unknown" else .language end')"
    echo "  Self:        $(echo "$data" | jq -r 'if .is_self == 1 then "yes" else "no" end')"
    echo "  Supervisor:  $(echo "$data" | jq -r 'if (.supervisor_agent_id // "") == "" then "none" else .supervisor_agent_id end')"
    echo "  Hooks:       $(echo "$data" | jq -r 'if .hooks_installed == 1 then "installed" else "not installed" end')"
    echo "  Remote:      $(echo "$data" | jq -r 'if (.git_remote // "") == "" then "none" else .git_remote end')"
    echo "  Description: $(echo "$data" | jq -r 'if (.description // "") == "" then "none" else .description end')"
    echo "  Added:       $(echo "$data" | jq -r '.added_at')"
}

generate_agent_id() {
    # Generate ag_ + 8 random alphanumeric chars (same logic as tools/workers).
    # Collision check goes against the SQLite registry master — the JSON file
    # is only a derived view (see tools/lib/opencode.sh).
    local attempt=0
    local id existing

    while [[ $attempt -lt 100 ]]; do
        id="ag_$(head -c 32 /dev/urandom | base64 | tr -dc 'a-z0-9' | head -c 8)"
        if [[ ${#id} -ne 11 ]]; then
            attempt=$((attempt+1))
            continue
        fi
        existing=$(soren_db "SELECT COUNT(*) FROM agents WHERE agent_id = '${id}';" 2>/dev/null) || existing=0
        if [[ -n "$existing" && "$existing" != "0" ]]; then
            attempt=$((attempt+1))
            continue
        fi
        echo "$id"
        return 0
    done

    die "failed to generate unique agent ID after 100 attempts"
}

cmd_activate() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: projects activate <id>"

    ensure_registry

    if ! project_exists "$id"; then
        die "project '$id' not found"
    fi

    # Self-project uses Supervisor Prime — nothing to spawn
    local is_self
    is_self=$(project_field "$id" is_self)
    if [[ "$is_self" == "1" ]]; then
        # Just mark active
        soren_db "UPDATE projects SET active = 1 WHERE id = '$(sql_q "$id")';"
        regen_projects_view
        ok "Self-project '$id' activated (Supervisor Prime handles this project)"
        return 0
    fi

    local already_active
    already_active=$(project_field "$id" active)
    if [[ "$already_active" == "1" ]]; then
        # Check if the tmux window is actually running
        local sup_name_check="sup-${id}"
        local session_check="${SOREN_SESSION:-soren}"
        if tmux list-windows -t "$session_check" -F '#{window_name}' 2>/dev/null | grep -qxF "$sup_name_check"; then
            warn "project '$id' is already active"
            return 0
        fi
        # Window is dead but registry says active — deactivate stale state first
        warn "project '$id' marked active but supervisor window is gone — reactivating"
        cmd_deactivate "$id" 2>/dev/null || true
    fi

    # Read project details
    local project_path
    project_path=$(project_field "$id" path)
    [[ -d "$project_path" ]] || die "project path does not exist: $project_path"

    local sup_name="sup-${id}"
    local session="${SOREN_SESSION:-soren}"

    # Check if supervisor window already exists
    if tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | grep -qxF "$sup_name"; then
        warn "supervisor window '$sup_name' already exists"
        # Still mark active in registry
        soren_db "UPDATE projects SET active = 1 WHERE id = '$(sql_q "$id")';"
        regen_projects_view
        return 0
    fi

    info "Activating project: $id"

    # Generate agent ID for the project supervisor
    local agent_id
    agent_id=$(generate_agent_id)
    info "Project supervisor agent ID: $agent_id"

    # Create tmux window
    tmux new-window -t "${session}:" -n "$sup_name"
    tmux set-option -t "${session}:${sup_name}" allow-rename off 2>/dev/null || true

    # Register in the agent registry (SQLite master; agent_registry.json is
    # regenerated as a view — the API serves the correct data immediately).
    # status IN_PROGRESS lives in the data blob so the derived status column
    # matches (the old direct-sqlite mirror set the column only).
    local reg_file="${SOREN_HOME}/.soren/agent_registry.json"
    local now
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ ! -f "$reg_file" ]]; then
        echo '{}' > "$reg_file"
    fi
    soren_registry_update "$reg_file" \
       --arg key "$sup_name" \
       --arg aid "$agent_id" \
       --arg pid "$id" \
       --arg now "$now" \
       '.[$key] = {
