cmd_deactivate() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: projects deactivate <id>"

    ensure_registry

    if ! project_exists "$id"; then
        die "project '$id' not found"
    fi

    # Prevent deactivating self-project
    local is_self
    is_self=$(project_field "$id" is_self)
    if [[ "$is_self" == "1" ]]; then
        die "cannot deactivate SOREN self-project"
    fi

    local already_inactive
    already_inactive=$(project_field "$id" active)
    if [[ "$already_inactive" == "0" ]]; then
        warn "project '$id' is already inactive"
        return 0
    fi

    info "Deactivating project: $id"

    local sup_name="sup-${id}"
    local session="${SOREN_SESSION:-soren}"

    # Kill the project supervisor's tmux window if it exists
    if tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | grep -qxF "$sup_name"; then
        info "Killing project supervisor: $sup_name"
        # Send Ctrl+C first for graceful shutdown
        tmux send-keys -t "${session}:${sup_name}" C-c 2>/dev/null || true
        sleep 1
        tmux kill-window -t "${session}:${sup_name}" 2>/dev/null || true
        ok "Supervisor window killed"
    fi

    # Retire in the registry master: keep the row but mark it SLEEPING and
    # drop the oc_port (release its reservation first). This preserves the
    # archived view — previously the JSON del() and the direct sqlite
    # UPDATE→SLEEPING disagreed with each other; the sqlite behavior (keep as
    # SLEEPING) wins now that sqlite is the single master.
    local reg_file="${SOREN_HOME}/.soren/agent_registry.json"
    local dead_port=""
    dead_port=$(soren_registry_get -r --arg key "$sup_name" '.[$key].oc_port // empty' 2>/dev/null) || dead_port=""
    if [[ -n "$dead_port" ]]; then
        soren_oc_release_port "$dead_port"
    fi
    soren_registry_update "$reg_file" --arg key "$sup_name" \
        'if has($key) then .[$key].status = "SLEEPING" | del(.[$key].oc_port) else . end'

    # Remove heartbeat file
    rm -f "${SOREN_HOME}/.soren/.${sup_name}-heartbeat"

    # Update registry: set active=false, clear supervisor_agent_id
    # ('' in the master renders as null in the view)
    soren_db "UPDATE projects SET active = 0, supervisor_agent_id = '' WHERE id = '$(sql_q "$id")';"
    regen_projects_view

    ok "Project '$id' deactivated"
}

cmd_install_hooks() {
    local id="${1:-}"
    [[ -z "$id" ]] && die "usage: projects install-hooks <id>"

    ensure_registry

    if ! project_exists "$id"; then
        die "project '$id' not found"
    fi

    local is_self
    is_self=$(project_field "$id" is_self)
    if [[ "$is_self" == "1" ]]; then
        warn "SOREN self-project already has the soren-bridge plugin configured"
        return 0
    fi

    local project_path
    project_path=$(project_field "$id" path)
    [[ -d "$project_path" ]] || die "project path does not exist: $project_path"

    info "Installing soren-bridge opencode plugin in: $project_path"

    # Create .opencode/plugins directory in the target project
    local target_plugin_dir="${project_path}/.opencode/plugins"
    mkdir -p "$target_plugin_dir"

    # Install a plugin shim that re-exports SOREN's bridge plugin
    local plugin_file="${target_plugin_dir}/soren-bridge.ts"

    # Warn if the plugin shim already exists
    if [[ -f "$plugin_file" ]]; then
        warn "Existing .opencode/plugins/soren-bridge.ts found — overwriting"
    fi

    cat > "$plugin_file" << PLUGINEOF
// Installed by SOREN (tools/projects install-hooks). Do not edit.
export { SorenBridge } from "${SOREN_HOME}/.opencode/plugins/soren-bridge.ts"
PLUGINEOF

    # Update registry: mark hooks as installed
    soren_db "UPDATE projects SET hooks_installed = 1 WHERE id = '$(sql_q "$id")';"
    regen_projects_view

    ok "soren-bridge plugin installed at $plugin_file"
    echo "  Re-exports: ${SOREN_HOME}/.opencode/plugins/soren-bridge.ts"
}

cmd_sync_skills() {
    ensure_registry

    local count=0 skipped=0
    local id ppath is_self skill_file
    while IFS=$'\t' read -r id ppath is_self; do
        [[ -z "$id" ]] && continue
        if [[ "$is_self" == "1" ]]; then
            skipped=$((skipped+1))
            continue
        fi
        if [[ ! -d "$ppath" ]]; then
            warn "skipping '$id' — path does not exist: $ppath"
            skipped=$((skipped+1))
            continue
        fi
        info "Regenerating conventions skill for: $id"
        if skill_file=$(generate_conventions_skill "$id" "$ppath"); then
            ok "  → $skill_file"
            count=$((count+1))
        else
            warn "  failed to generate skill for '$id'"
            skipped=$((skipped+1))
        fi
    done < <(soren_db -separator $'\t' "SELECT id, path, is_self FROM projects ORDER BY rowid;")

    echo ""
    ok "Conventions skills regenerated: $count project(s)${skipped:+ (skipped: $skipped)}"
}

