#!/usr/bin/env bash
# tools/secrets — Encrypted secret storage CLI
# Usage: ./tools/secrets <subcommand> [args]
#   set KEY VALUE    Encrypt and store a secret
#   get KEY          Decrypt and print a secret value
#   list             List all secret names
#   delete KEY       Delete a secret
#
# Passphrase source (in order):
#   1. SOREN_SECRETS_PASSPHRASE env var
#   2. Prompted from stdin

set -euo pipefail
cd "$(dirname "$0")/.."

SUBCMD="${1:-}"

_get_passphrase() {
    if [[ -n "${SOREN_SECRETS_PASSPHRASE:-}" ]]; then
        echo "$SOREN_SECRETS_PASSPHRASE"
    else
        # Read from terminal (not stdin) so it works even when stdin is piped
        local pass
        read -rs -p "Passphrase: " pass </dev/tty
        echo "" >&2
        echo "$pass"
    fi
}

case "$SUBCMD" in
  set)
    KEY="${2:-}"
    VALUE="${3:-}"
    if [[ -z "$KEY" || -z "$VALUE" ]]; then
        echo "Usage: ./tools/secrets set KEY VALUE" >&2
        exit 1
    fi
    PASSPHRASE="$(_get_passphrase)"
    uv run python - "$KEY" "$VALUE" "$PASSPHRASE" <<'EOF'
import sys
from src.server.services.secrets import set_secret
set_secret(sys.argv[1], sys.argv[2], sys.argv[3])
print(f"Secret '{sys.argv[1]}' stored.")
EOF
    ;;

  get)
    KEY="${2:-}"
    if [[ -z "$KEY" ]]; then
        echo "Usage: ./tools/secrets get KEY" >&2
        exit 1
    fi
    PASSPHRASE="$(_get_passphrase)"
    uv run python - "$KEY" "$PASSPHRASE" <<'EOF'
import sys
from src.server.services.secrets import get_secret
value = get_secret(sys.argv[1], sys.argv[2])
if value is None:
    print(f"Secret '{sys.argv[1]}' not found.", file=sys.stderr)
    sys.exit(1)
print(value)
EOF
    ;;

  list)
    PASSPHRASE="$(_get_passphrase)"
    uv run python - "$PASSPHRASE" <<'EOF'
import sys
from src.server.services.secrets import list_secrets
names = list_secrets(sys.argv[1])
if not names:
    print("No secrets stored.")
else:
    for name in names:
        print(f"  {name}")
EOF
    ;;

  delete)
    KEY="${2:-}"
    if [[ -z "$KEY" ]]; then
        echo "Usage: ./tools/secrets delete KEY" >&2
        exit 1
    fi
    PASSPHRASE="$(_get_passphrase)"
    uv run python - "$KEY" "$PASSPHRASE" <<'EOF'
import sys
from src.server.services.secrets import delete_secret
deleted = delete_secret(sys.argv[1], sys.argv[2])
if not deleted:
    print(f"Secret '{sys.argv[1]}' not found.", file=sys.stderr)
    sys.exit(1)
print(f"Secret '{sys.argv[1]}' deleted.")
EOF
    ;;

  *)
    echo "Usage: ./tools/secrets <subcommand> [args]"
    echo ""
    echo "Subcommands:"
    echo "  set KEY VALUE    Encrypt and store a secret"
    echo "  get KEY          Decrypt and print a secret value"
    echo "  list             List all secret names (not values)"
    echo "  delete KEY       Delete a secret"
    echo ""
    echo "Passphrase: read from SOREN_SECRETS_PASSPHRASE env var or prompted from stdin."
    exit 1
    ;;
esac
