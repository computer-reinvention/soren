#!/usr/bin/env bash
#===============================================================================
# verifications - Inspect the verify-done pipeline state
#
# The verify-done hook (.opencode/hooks/verify-done.sh) machine-checks every
# worker [DONE]: it verifies the commit hash, runs tests, and writes
# "ts | [VERIFY] | agent | detail" lines to .soren/status.log PLUS one
# structured row per outcome to the verify_events table in the consolidated
# DB (.soren/soren.db). Failures get a [FIX-REQUEST] (2-retry budget per task
# key, counters in the fix_retries table); exhausted budgets escalate as
# [VERIFY-FAILED] and set an escalation latch (fix_retries.escalated=1) that
# suppresses further auto-fix until cleared.
#
# Usage:
#   verifications recent [N]              - Last N verification events (default 20)
#   verifications pending                 - Agents with active retry counters
#   verifications latches                 - Escalation latches (agent, task key, age)
#   verifications clear-latch <agent> [key] - Clear latch(es) — supervisor unblock
#
# Read-only except clear-latch (and the one-time lazy import of the legacy
# .soren/.fix-retries/ directory into the fix_retries table).
# Storage: fix_retries + verify_events tables in .soren/soren.db
# (SOREN_DB overrides the DB path); .soren/status.log is the fallback source
# for `recent` until the table has rows.
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
STATUS_LOG="${SOREN_HOME}/.soren/status.log"
# Pre-migration retry/latch dir — imported once into fix_retries, then renamed.
LEGACY_RETRY_DIR="${SOREN_HOME}/.soren/.fix-retries"
MAX_RETRIES=2

# Shared DB access (SOREN_DB_PATH + soren_db). Same lib verify-done.sh uses.
# shellcheck source=/dev/null
source "${SOREN_HOME}/tools/lib/db.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }

#-------------------------------------------------------------------------------
# Helpers
#-------------------------------------------------------------------------------

# Escape a value for embedding in a single-quoted SQL literal.
sql_q() {
    printf '%s' "$1" | sed "s/'/''/g"
}

# Schema for retry/latch state + structured verification history.
# NOTE (shared function): duplicated in .opencode/hooks/verify-done.sh — keep in sync.
ensure_verify_tables() {
    soren_db <<'SQL' 2>/dev/null || true
CREATE TABLE IF NOT EXISTS fix_retries (
    agent      TEXT NOT NULL,
    task_key   TEXT NOT NULL,
    retries    INTEGER NOT NULL DEFAULT 0,
    escalated  INTEGER NOT NULL DEFAULT 0,
    updated_at TEXT,
    PRIMARY KEY (agent, task_key)
);
CREATE TABLE IF NOT EXISTS verify_events (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    ts         TEXT NOT NULL,
    event      TEXT NOT NULL,
    agent      TEXT NOT NULL,
    task_key   TEXT,
    commit_sha TEXT,
    detail     TEXT
);
SQL
}

# One-time lazy import of the legacy .fix-retries directory into fix_retries.
# mv is the atomic claim: exactly one concurrent invocation imports; the dir
# ends up renamed to <dir>.migrated so this never runs twice.
# NOTE (shared function): duplicated in .opencode/hooks/verify-done.sh — keep in sync.
migrate_fix_retries_dir() {
    local legacy="$1"
    [[ -d "$legacy" ]] || return 0
    local claim="${legacy}.importing.$$"
    mv "$legacy" "$claim" 2>/dev/null || return 0
    local now f base esc key agt count
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    for f in "$claim"/*; do
        [[ -e "$f" ]] || continue
        base=$(basename "$f")
        esc=0
        if [[ "$base" == *.escalated ]]; then
            esc=1
            base="${base%.escalated}"
        fi
        # <agent>-<key> where key is a commit sha / md5 (7-40 hex) or
        # "default"; legacy keyless files are just <agent>.
        key="${base##*-}"
        agt="${base%-*}"
        if [[ "$base" != *-* ]] || { [[ ! "$key" =~ ^[0-9a-f]{7,40}$ ]] && [[ "$key" != "default" ]]; }; then
            agt="$base"
            key="default"
        fi
        if (( esc == 1 )); then
            soren_db "INSERT INTO fix_retries (agent, task_key, retries, escalated, updated_at)
                VALUES ('$(sql_q "$agt")', '$(sql_q "$key")', 0, 1, '$now')
                ON CONFLICT(agent, task_key) DO UPDATE SET escalated = 1, updated_at = '$now';" 2>/dev/null || true
        else
            count=$(tr -cd '0-9' < "$f" 2>/dev/null) || count=""
            [[ -z "$count" ]] && count=0
            soren_db "INSERT INTO fix_retries (agent, task_key, retries, escalated, updated_at)
                VALUES ('$(sql_q "$agt")', '$(sql_q "$key")', $count, 0, '$now')
                ON CONFLICT(agent, task_key) DO UPDATE SET retries = $count, updated_at = '$now';" 2>/dev/null || true
        fi
    done
    if [[ -e "${legacy}.migrated" ]]; then
        mv "$claim" "${legacy}.migrated.$(date +%s).$$" 2>/dev/null || true
    else
        mv "$claim" "${legacy}.migrated" 2>/dev/null || true
    fi
}

# Ensure schema + one-time import; called by every command that touches state.
init_state() {
    ensure_verify_tables
    migrate_fix_retries_dir "$LEGACY_RETRY_DIR"
}

# Human age from a seconds-count
age_from_secs() {
    local diff="$1"
    [[ "$diff" =~ ^[0-9]+$ ]] || diff=0
    if (( diff < 60 )); then
        echo "${diff}s"
    elif (( diff < 3600 )); then
        echo "$((diff / 60))m"
    elif (( diff < 86400 )); then
        echo "$((diff / 3600))h"
    else
        echo "$((diff / 86400))d"
    fi
}

# Classify a verify_events.event value into a colored outcome label.
event_outcome() {
    local event="$1"
    case "$event" in
        VERIFIED)        echo -e "${GREEN}VERIFIED${NC}" ;;
        SKIP-*)          echo -e "${GREEN}VERIFIED${NC}" ;;   # no-op / research / contract-exempt
        FIX-REQUEST)     echo -e "${YELLOW}FIX-REQUEST${NC}" ;;
        VERIFY-FAILED)   echo -e "${RED}VERIFY-FAILED${NC}" ;;
        LATCHED)         echo -e "${RED}LATCHED${NC}" ;;
        *)               echo -e "${DIM}INFO${NC}" ;;
    esac
}

# Classify a [VERIFY] status.log detail string into an outcome label (colored).
# Used by the status.log fallback in `recent` (pre-migration history).
outcome_of() {
    local detail="$1"
    case "$detail" in
        "SKIP:"*)                echo -e "${GREEN}VERIFIED${NC}" ;;   # no-op / research / contract-exempt
        commit*verified*)        echo -e "${GREEN}COMMIT-OK${NC}" ;;
        *"pytest PASSED"*|*"typecheck PASSED"*) echo -e "${GREEN}CHECK-OK${NC}" ;;
        *"pytest FAILED"*|*"typecheck FAILED"*) echo -e "${RED}CHECK-FAIL${NC}" ;;
        "FIX-REQUEST sent"*)     echo -e "${YELLOW}FIX-REQUEST${NC}" ;;
        "ESCALATED"*)            echo -e "${RED}VERIFY-FAILED${NC}" ;;
        "escalation latched"*)   echo -e "${RED}LATCHED${NC}" ;;
        "FAILED:"*)              echo -e "${RED}FAILED${NC}" ;;
        "WARN:"*)                echo -e "${YELLOW}WARN${NC}" ;;
        "LESSON"*)               echo -e "${CYAN}LESSON${NC}" ;;
        running*)                echo -e "${DIM}RUNNING${NC}" ;;
        *)                       echo -e "${DIM}INFO${NC}" ;;
    esac
}

print_recent_header() {
    printf "${BOLD}%-20s  %-26s  %-13s  %s${NC}\n" "TIME" "AGENT" "OUTCOME" "DETAIL"
    echo -e "${DIM}────────────────────  ──────────────────────────  ─────────────  ──────────────────────────────${NC}"
}

#-------------------------------------------------------------------------------
# Commands
#-------------------------------------------------------------------------------

cmd_recent() {
    local n="${1:-20}"
    [[ "$n" =~ ^[0-9]+$ ]] || die "usage: verifications recent [N]"
    init_state

    # Primary source: the verify_events table (one row per outcome).
    local rows
    rows=$(soren_db -separator $'\t' "SELECT ts, agent, event, COALESCE(detail, '')
        FROM (SELECT * FROM verify_events ORDER BY id DESC LIMIT $n)
        ORDER BY id ASC;" 2>/dev/null) || rows=""

    if [[ -n "$rows" ]]; then
        print_recent_header
        local ts agt event detail outcome
        while IFS=$'\t' read -r ts agt event detail; do
            [[ -z "$ts" ]] && continue
            outcome=$(event_outcome "$event")
            (( ${#detail} > 78 )) && detail="${detail:0:75}..."
            printf "%-20s  %-26s  %-24b  %s\n" "$ts" "$agt" "$outcome" "$detail"
        done <<< "$rows"
        return
    fi

    # Fallback (first runs post-migration): parse status.log [VERIFY] lines.
    [[ -f "$STATUS_LOG" ]] || die "no verify_events rows and status log not found: $STATUS_LOG"
    local lines
    lines=$(grep ' | \[VERIFY\] | ' "$STATUS_LOG" | tail -n "$n" || true)
    if [[ -z "$lines" ]]; then
        echo -e "${DIM}No verification events in the verify_events table or $STATUS_LOG${NC}"
        return
    fi

    print_recent_header
    local line ts agent detail outcome
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        ts=$(echo "$line" | awk -F' \\| ' '{print $1}')
        agent=$(echo "$line" | awk -F' \\| ' '{print $3}')
        detail=$(echo "$line" | awk -F' \\| ' '{ s=""; for (i=4; i<=NF; i++) s = s (i>4 ? " | " : "") $i; print s }')
        outcome=$(outcome_of "$detail")
        (( ${#detail} > 78 )) && detail="${detail:0:75}..."
        printf "%-20s  %-26s  %-24b  %s\n" "$ts" "$agent" "$outcome" "$detail"
    done <<< "$lines"
}

cmd_pending() {
    init_state

    # Age computed in SQL (updated_at is ISO-8601 UTC, which strftime parses).
    local rows
    rows=$(soren_db -separator $'\t' "SELECT agent, task_key, retries,
            CAST(strftime('%s','now') AS INTEGER)
              - CAST(COALESCE(strftime('%s', updated_at), strftime('%s','now')) AS INTEGER)
        FROM fix_retries
        WHERE retries > 0
        ORDER BY updated_at DESC;" 2>/dev/null) || rows=""

    if [[ -z "$rows" ]]; then
        echo -e "${DIM}No active retry counters — nothing pending${NC}"
        return
    fi

    printf "${BOLD}%-26s  %-34s  %-9s  %-5s  %s${NC}\n" "AGENT" "TASK KEY" "ATTEMPTS" "AGE" "LAST FIX-REQUEST"
    echo -e "${DIM}──────────────────────────  ──────────────────────────────────  ─────────  ─────  ──────────────────────────${NC}"

    local agent key count age_s age last
    while IFS=$'\t' read -r agent key count age_s; do
        [[ -z "$agent" ]] && continue
        age=$(age_from_secs "$age_s")
        last=$(soren_db "SELECT detail FROM verify_events
            WHERE agent = '$(sql_q "$agent")' AND event = 'FIX-REQUEST'
            ORDER BY id DESC LIMIT 1;" 2>/dev/null) || last=""
        if [[ -z "$last" && -f "$STATUS_LOG" ]]; then
            last=$(grep " | \[VERIFY\] | ${agent} | FIX-REQUEST sent" "$STATUS_LOG" 2>/dev/null | tail -1 \
                | awk -F' \\| ' '{print $4}' | sed 's/^FIX-REQUEST sent to [^ ]* //') || true
        fi
        printf "%-26s  %-34s  %-9s  %-5s  %s\n" "$agent" "$key" "${count}/${MAX_RETRIES}" "$age" "${last:--}"
    done <<< "$rows"

    echo ""
    echo -e "${DIM}Counters clear automatically on the agent's next [VERIFIED]; at ${MAX_RETRIES}/${MAX_RETRIES} the next failure escalates.${NC}"
}

cmd_latches() {
    init_state

    local rows
    rows=$(soren_db -separator $'\t' "SELECT agent, task_key,
            CAST(strftime('%s','now') AS INTEGER)
              - CAST(COALESCE(strftime('%s', updated_at), strftime('%s','now')) AS INTEGER)
        FROM fix_retries
        WHERE escalated = 1
        ORDER BY updated_at DESC;" 2>/dev/null) || rows=""

    if [[ -z "$rows" ]]; then
        echo -e "${DIM}No escalation latches — no agents are blocked${NC}"
        return
    fi

    printf "${BOLD}%-26s  %-34s  %s${NC}\n" "AGENT" "TASK KEY" "AGE"
    echo -e "${DIM}──────────────────────────  ──────────────────────────────────  ─────${NC}"

    local agent key age_s
    while IFS=$'\t' read -r agent key age_s; do
        [[ -z "$agent" ]] && continue
        printf "%-26s  %-34s  %s\n" "$agent" "$key" "$(age_from_secs "$age_s")"
    done <<< "$rows"

    echo ""
    echo -e "${DIM}While latched, further [DONE] reports for that task key get no auto FIX-REQUEST.${NC}"
    echo -e "${DIM}Unblock: ./tools/verifications clear-latch <agent> [key]  (or dispatch via ./tools/workers send <agent>, which auto-clears)${NC}"
}

cmd_clear_latch() {
    local agent="${1:-}"
    local key="${2:-}"
    [[ -z "$agent" ]] && die "usage: verifications clear-latch <agent> [key]"
    [[ "$agent" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid agent name: '$agent'"
    init_state

    local now removed
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [[ -n "$key" ]]; then
        removed=$(soren_db "UPDATE fix_retries SET escalated = 0, updated_at = '$now'
            WHERE agent = '$(sql_q "$agent")' AND task_key = '$(sql_q "$key")' AND escalated = 1;
            SELECT changes();" 2>/dev/null) || removed=0
        (( removed == 0 )) && die "no latch for agent '$agent' with key '$key'"
    else
        removed=$(soren_db "UPDATE fix_retries SET escalated = 0, updated_at = '$now'
            WHERE agent = '$(sql_q "$agent")' AND escalated = 1;
            SELECT changes();" 2>/dev/null) || removed=0
        (( removed == 0 )) && die "no latches found for agent '$agent'"
    fi

    ok "Cleared ${removed} latch(es) for ${agent}"
    echo -e "${DIM}Auto-fix resumes on the agent's next [DONE]. Note: ./tools/workers send <agent> also auto-clears latches (a new dispatch counts as supervisor intervention).${NC}"
}

cmd_help() {
    cat << 'EOF'
verifications - Inspect the verify-done pipeline state

USAGE:
    verifications <command> [arguments]

COMMANDS:
    recent [N]                 Last N verification events from the
                               verify_events table (default 20): time, agent,
                               outcome, detail. Falls back to .soren/status.log
                               [VERIFY] lines while the table is still empty.
    pending                    Agents with active retry counters (fix_retries
                               rows with retries > 0) — i.e. unresolved
                               [FIX-REQUEST]s
    latches                    Escalation latches (fix_retries rows with
                               escalated = 1): agent, task key, age. Latched
                               agents get no auto-fix.
    clear-latch <agent> [key]  Clear latch(es) for an agent — the documented
                               supervisor unblock path. Without [key], clears
                               all of the agent's latches.
    help                       Show this help

PIPELINE (see .opencode/hooks/verify-done.sh):
    Worker reports [DONE] via ./tools/mailbox done → the hook extracts the
    commit hash, verifies it exists, runs pytest/typecheck for touched areas,
    then sends [VERIFIED] to the supervisor or [FIX-REQUEST] back to the
    worker. Each task key gets 2 fix attempts; after that the failure is
    escalated as [VERIFY-FAILED] and an escalation latch (escalated=1 in the
    fix_retries table) suppresses further auto-fix until a supervisor clears
    it (clear-latch here, or a new dispatch via ./tools/workers send, which
    auto-clears).

READ-ONLY:
    All commands are read-only except clear-latch (plus a one-time lazy import
    of the pre-migration .soren/.fix-retries/ directory into the table; the
    dir is renamed to .fix-retries.migrated afterwards).

ENVIRONMENT:
    SOREN_HOME   Soren root (default: git rev-parse --show-toplevel)
    SOREN_DB     Consolidated DB path (default: $SOREN_HOME/.soren/soren.db —
                 same override verify-done.sh honors)

EXAMPLES:
    verifications recent
    verifications recent 50
    verifications pending
    verifications latches
    verifications clear-latch worker-auth
    verifications clear-latch worker-auth a1b2c3d
EOF
}

#-------------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------------

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        recent)      cmd_recent "$@" ;;
        pending)     cmd_pending "$@" ;;
        latches)     cmd_latches "$@" ;;
        clear-latch) cmd_clear_latch "$@" ;;
        help|--help|-h) cmd_help ;;
        *)           die "unknown command: $cmd (try 'verifications help')" ;;
    esac
}

main "$@"
