#!/usr/bin/env bash
#===============================================================================
# verifications - Inspect the verify-done pipeline state
#
# The verify-done hook (.opencode/hooks/verify-done.sh) machine-checks every
# worker [DONE]: it verifies the commit hash, runs tests, and writes
# "ts | [VERIFY] | agent | detail" lines to .soren/status.log. Failures get a
# [FIX-REQUEST] (2-retry budget per task key, counters in .soren/.fix-retries/);
# exhausted budgets escalate as [VERIFY-FAILED] and drop an .escalated latch
# that suppresses further auto-fix until cleared.
#
# Usage:
#   verifications recent [N]              - Last N verification events (default 20)
#   verifications pending                 - Agents with active retry counters
#   verifications latches                 - Escalation latches (agent, task key, age)
#   verifications clear-latch <agent> [key] - Remove latch(es) — supervisor unblock
#
# Read-only except clear-latch.
# Storage: .soren/status.log, RETRY_DIR (default .soren/.fix-retries)
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
STATUS_LOG="${SOREN_HOME}/.soren/status.log"
# Same default + env override as verify-done.sh
RETRY_DIR="${RETRY_DIR:-${SOREN_HOME}/.soren/.fix-retries}"
MAX_RETRIES=2

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }

#-------------------------------------------------------------------------------
# Helpers
#-------------------------------------------------------------------------------

# Epoch mtime of a file — macOS (stat -f) and Linux (stat -c)
mtime_of() {
    stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0
}

# Human age from an epoch timestamp
age_from() {
    local then="$1" now diff
    now=$(date +%s)
    diff=$((now - then))
    if (( diff < 60 )); then
        echo "${diff}s"
    elif (( diff < 3600 )); then
        echo "$((diff / 60))m"
    elif (( diff < 86400 )); then
        echo "$((diff / 3600))h"
    else
        echo "$((diff / 86400))d"
    fi
}

# Split a retry/latch filename into "agent<TAB>key".
# New format: <agent>-<taskkey> where taskkey is a commit sha (7-40 hex) or an
# md5 (32 hex) of the DONE summary, or the literal "default". Legacy files
# (pre task-key) are just <agent>.
split_retry_name() {
    local base="$1"
    local key="${base##*-}"
    local agent="${base%-*}"
    if [[ "$base" == *-* ]] && { [[ "$key" =~ ^[0-9a-f]{7,40}$ ]] || [[ "$key" == "default" ]]; }; then
        printf '%s\t%s\n' "$agent" "$key"
    else
        printf '%s\t%s\n' "$base" "-"
    fi
}

# Classify a [VERIFY] detail string into an outcome label (colored).
outcome_of() {
    local detail="$1"
    case "$detail" in
        "SKIP:"*)                echo -e "${GREEN}VERIFIED${NC}" ;;   # no-op / research / contract-exempt
        commit*verified*)        echo -e "${GREEN}COMMIT-OK${NC}" ;;
        *"pytest PASSED"*|*"typecheck PASSED"*) echo -e "${GREEN}CHECK-OK${NC}" ;;
        *"pytest FAILED"*|*"typecheck FAILED"*) echo -e "${RED}CHECK-FAIL${NC}" ;;
        "FIX-REQUEST sent"*)     echo -e "${YELLOW}FIX-REQUEST${NC}" ;;
        "ESCALATED"*)            echo -e "${RED}VERIFY-FAILED${NC}" ;;
        "escalation latched"*)   echo -e "${RED}LATCHED${NC}" ;;
        "FAILED:"*)              echo -e "${RED}FAILED${NC}" ;;
        "WARN:"*)                echo -e "${YELLOW}WARN${NC}" ;;
        "LESSON"*)               echo -e "${CYAN}LESSON${NC}" ;;
        running*)                echo -e "${DIM}RUNNING${NC}" ;;
        *)                       echo -e "${DIM}INFO${NC}" ;;
    esac
}

#-------------------------------------------------------------------------------
# Commands
#-------------------------------------------------------------------------------

cmd_recent() {
    local n="${1:-20}"
    [[ "$n" =~ ^[0-9]+$ ]] || die "usage: verifications recent [N]"
    [[ -f "$STATUS_LOG" ]] || die "status log not found: $STATUS_LOG"

    local lines
    lines=$(grep ' | \[VERIFY\] | ' "$STATUS_LOG" | tail -n "$n" || true)
    if [[ -z "$lines" ]]; then
        echo -e "${DIM}No verification events in $STATUS_LOG${NC}"
        return
    fi

    printf "${BOLD}%-20s  %-26s  %-13s  %s${NC}\n" "TIME" "AGENT" "OUTCOME" "DETAIL"
    echo -e "${DIM}────────────────────  ──────────────────────────  ─────────────  ──────────────────────────────${NC}"
    local line ts agent detail outcome
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        ts=$(echo "$line" | awk -F' \\| ' '{print $1}')
        agent=$(echo "$line" | awk -F' \\| ' '{print $3}')
        detail=$(echo "$line" | awk -F' \\| ' '{ s=""; for (i=4; i<=NF; i++) s = s (i>4 ? " | " : "") $i; print s }')
        outcome=$(outcome_of "$detail")
        (( ${#detail} > 78 )) && detail="${detail:0:75}..."
        printf "%-20s  %-26s  %-24b  %s\n" "$ts" "$agent" "$outcome" "$detail"
    done <<< "$lines"
}

cmd_pending() {
    if [[ ! -d "$RETRY_DIR" ]]; then
        echo -e "${DIM}No retry directory ($RETRY_DIR) — nothing pending${NC}"
        return
    fi

    local found=false
    printf "${BOLD}%-26s  %-34s  %-9s  %-5s  %s${NC}\n" "AGENT" "TASK KEY" "ATTEMPTS" "AGE" "LAST FIX-REQUEST"
    echo -e "${DIM}──────────────────────────  ──────────────────────────────────  ─────────  ─────  ──────────────────────────${NC}"

    local f base agent key count age last
    for f in "$RETRY_DIR"/*; do
        [[ -f "$f" ]] || continue
        base=$(basename "$f")
        [[ "$base" == *.escalated ]] && continue
        found=true
        agent=$(split_retry_name "$base" | cut -f1)
        key=$(split_retry_name "$base" | cut -f2)
        count=$(tr -cd '0-9' < "$f")
        [[ -z "$count" ]] && count="?"
        age=$(age_from "$(mtime_of "$f")")
        last=""
        if [[ -f "$STATUS_LOG" ]]; then
            last=$(grep " | \[VERIFY\] | ${agent} | FIX-REQUEST sent" "$STATUS_LOG" 2>/dev/null | tail -1 \
                | awk -F' \\| ' '{print $4}' | sed 's/^FIX-REQUEST sent to [^ ]* //') || true
        fi
        printf "%-26s  %-34s  %-9s  %-5s  %s\n" "$agent" "$key" "${count}/${MAX_RETRIES}" "$age" "${last:--}"
    done

    if [[ "$found" == false ]]; then
        echo -e "${DIM}No active retry counters — nothing pending${NC}"
        return
    fi
    echo ""
    echo -e "${DIM}Counters clear automatically on the agent's next [VERIFIED]; at ${MAX_RETRIES}/${MAX_RETRIES} the next failure escalates.${NC}"
}

cmd_latches() {
    if [[ ! -d "$RETRY_DIR" ]]; then
        echo -e "${DIM}No retry directory ($RETRY_DIR) — no latches${NC}"
        return
    fi

    local found=false
    printf "${BOLD}%-26s  %-34s  %s${NC}\n" "AGENT" "TASK KEY" "AGE"
    echo -e "${DIM}──────────────────────────  ──────────────────────────────────  ─────${NC}"

    local f base agent key age
    for f in "$RETRY_DIR"/*.escalated; do
        [[ -f "$f" ]] || continue
        found=true
        base=$(basename "$f" .escalated)
        agent=$(split_retry_name "$base" | cut -f1)
        key=$(split_retry_name "$base" | cut -f2)
        age=$(age_from "$(mtime_of "$f")")
        printf "%-26s  %-34s  %s\n" "$agent" "$key" "$age"
    done

    if [[ "$found" == false ]]; then
        echo -e "${DIM}No escalation latches — no agents are blocked${NC}"
        return
    fi
    echo ""
    echo -e "${DIM}While latched, further [DONE] reports for that task key get no auto FIX-REQUEST.${NC}"
    echo -e "${DIM}Unblock: ./tools/verifications clear-latch <agent> [key]  (or dispatch via ./tools/workers send <agent>, which auto-clears)${NC}"
}

cmd_clear_latch() {
    local agent="${1:-}"
    local key="${2:-}"
    [[ -z "$agent" ]] && die "usage: verifications clear-latch <agent> [key]"
    [[ "$agent" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid agent name: '$agent'"
    [[ -d "$RETRY_DIR" ]] || die "retry directory not found: $RETRY_DIR"

    local removed=0 f
    if [[ -n "$key" ]]; then
        f="$RETRY_DIR/${agent}-${key}.escalated"
        [[ -f "$f" ]] || die "no latch for agent '$agent' with key '$key' ($f)"
        rm -f "$f"
        removed=1
    else
        # All latches for this agent: keyed files + legacy keyless
        for f in "$RETRY_DIR/${agent}-"*.escalated "$RETRY_DIR/${agent}.escalated"; do
            [[ -f "$f" ]] || continue
            rm -f "$f"
            removed=$((removed + 1))
        done
        (( removed == 0 )) && die "no latches found for agent '$agent'"
    fi

    ok "Cleared ${removed} latch(es) for ${agent}"
    echo -e "${DIM}Auto-fix resumes on the agent's next [DONE]. Note: ./tools/workers send <agent> also auto-clears latches (a new dispatch counts as supervisor intervention).${NC}"
}

cmd_help() {
    cat << 'EOF'
verifications - Inspect the verify-done pipeline state

USAGE:
    verifications <command> [arguments]

COMMANDS:
    recent [N]                 Last N verification events from .soren/status.log
                               (default 20): time, agent, outcome, detail
    pending                    Agents with active retry counters (files in the
                               retry dir) — i.e. unresolved [FIX-REQUEST]s
    latches                    Escalation latches (.escalated files): agent,
                               task key, age. Latched agents get no auto-fix.
    clear-latch <agent> [key]  Remove latch(es) for an agent — the documented
                               supervisor unblock path. Without [key], clears
                               all of the agent's latches.
    help                       Show this help

PIPELINE (see .opencode/hooks/verify-done.sh):
    Worker reports [DONE] via ./tools/mailbox done → the hook extracts the
    commit hash, verifies it exists, runs pytest/typecheck for touched areas,
    then sends [VERIFIED] to the supervisor or [FIX-REQUEST] back to the
    worker. Each task key gets 2 fix attempts; after that the failure is
    escalated as [VERIFY-FAILED] and an .escalated latch suppresses further
    auto-fix until a supervisor clears it (clear-latch here, or a new dispatch
    via ./tools/workers send, which auto-clears).

READ-ONLY:
    All commands are read-only except clear-latch.

ENVIRONMENT:
    SOREN_HOME   Soren root (default: git rev-parse --show-toplevel)
    RETRY_DIR    Retry/latch dir (default: $SOREN_HOME/.soren/.fix-retries —
                 same override verify-done.sh honors)

EXAMPLES:
    verifications recent
    verifications recent 50
    verifications pending
    verifications latches
    verifications clear-latch worker-auth
    verifications clear-latch worker-auth a1b2c3d
EOF
}

#-------------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------------

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        recent)      cmd_recent "$@" ;;
        pending)     cmd_pending "$@" ;;
        latches)     cmd_latches "$@" ;;
        clear-latch) cmd_clear_latch "$@" ;;
        help|--help|-h) cmd_help ;;
        *)           die "unknown command: $cmd (try 'verifications help')" ;;
    esac
}

main "$@"
