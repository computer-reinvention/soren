#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════════════
# autonomy-check - Scan all work sources and output structured, actionable data
#
# Designed to feed the supervisor autonomy engine. The monitor calls this when
# the supervisor is idle and injects the output as a rich [HEARTBEAT] message.
#
# Checks (in priority order):
#   1. Mailbox  - unread messages with sender/type breakdown
#   2. Workers  - active/idle counts with names
#   3. Backlog  - pending items with priority breakdown
#   4. Supervisors - project supervisor health
#   5. Git      - uncommitted tracked changes
#   6. Health   - system health endpoint
#
# Output modes:
#   --summary    One-line-per-section format (default, used by monitor.sh)
#   --raw        Raw JSON for programmatic consumption
#
# Exit 0 if work found, exit 1 if nothing to do
#═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

SOREN_PROJECT_ROOT="${SOREN_HOME:-${SOREN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}"
SOREN_SESSION="${SOREN_SESSION:-soren}"
SOREN_PORT="${SOREN_PORT:-8000}"
SOREN_MAILBOX="${SOREN_MAILBOX:-${SOREN_PROJECT_ROOT}/.soren/mailbox}"
WORKER_IDLE_THRESHOLD=${WORKER_IDLE_THRESHOLD:-1800}  # 30 minutes in seconds

# Shared DB helpers (SOREN_DB_PATH resolution + soren_db wrapper)
source "${SOREN_PROJECT_ROOT}/tools/lib/db.sh"

# Parse flags
OUTPUT_MODE="summary"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --summary) OUTPUT_MODE="summary"; shift ;;
        --raw)     OUTPUT_MODE="raw"; shift ;;
        *)         shift ;;
    esac
done

# Accumulators for structured output
mailbox_summary=""
mailbox_count=0
mailbox_priority=""
worker_summary=""
worker_active=0
worker_idle_count=0
worker_idle_names=""
backlog_summary=""
backlog_total=0
backlog_pending_summary=""
supervisor_summary=""
git_summary=""
git_file_count=0
health_summary=""
highest_priority=""

#───────────────────────────────────────────────────────────────────────────────
# 1. Mailbox — unread messages with sender/type breakdown
#───────────────────────────────────────────────────────────────────────────────

if [[ -f "$SOREN_MAILBOX" ]] && [[ -s "$SOREN_MAILBOX" ]]; then
    # ── Step 1: Build a map of resolved message ids from status_update records ──
    # Collect ids whose LATEST status is 'completed' or 'failed'.
    # We group all status_update records by .id, pick the one with the max .ts
    # for each group, and only emit the id if that latest status is terminal.
    # This correctly handles re-opened messages (e.g. completed -> working).
    resolved_ids=""
    if command -v jq &>/dev/null; then
        # sort_by epoch to handle mixed timezones (+05:30, Z, etc.) correctly.
        # jq's fromdateiso8601 only handles "Z" — not +HH:MM offsets — so we
        # define a helper (ts2epoch) that strips fractional seconds, detects
        # the offset sign, parses the base as UTC, then adjusts by the offset.
        resolved_ids=$(jq -rs '
            def ts2epoch:
              sub("\\.[0-9]+"; "")
              | if test("\\+[0-9]{2}:[0-9]{2}$") then
                  split("+") | .[0] as $b
                  | (.[1] | split(":") | (.[0]|tonumber)*3600 + (.[1]|tonumber)*60) as $off
                  | ($b + "Z" | fromdateiso8601) - $off
                elif test("-[0-9]{2}:[0-9]{2}$") then
                  (.[:-6]) as $b
                  | (.[-5:] | split(":") | (.[0]|tonumber)*3600 + (.[1]|tonumber)*60) as $off
                  | ($b + "Z" | fromdateiso8601) + $off
                else fromdateiso8601? // 0
                end;
            [ .[] | select(.type == "status_update") ]
            | group_by(.id)
            | map(sort_by(.ts | ts2epoch) | last)
            | .[]
            | select(.status == "completed" or .status == "failed")
            | .id
        ' "$SOREN_MAILBOX" 2>/dev/null | sort -u || true)
    fi

    # ── Step 2: Count unread messages, excluding status_update records and resolved messages ──
    mailbox_count=0
    blocked_count=0
    done_count=0
    status_count=0
    question_count=0
    other_count=0
    senders=()

    # Sentinel-wrapped resolved_ids for a single bash pattern-match lookup
    # per line instead of a `grep -qxF` subprocess per line. (No
    # associative arrays — this machine's /bin/bash is 3.2, which
    # predates bash 4's `declare -A`.)
    resolved_ids_wrapped=$'\n'"${resolved_ids}"$'\n'

    if command -v jq &>/dev/null; then
        # Extract type/id/from/subject for every mailbox line in ONE jq
        # pass instead of up to 4 jq subprocess spawns PER LINE — measured
        # 3.3s wall-clock for a 290-line mailbox before this fix, all of
        # it synchronous inside monitor.sh's 5s dashboard loop whenever
        # the supervisor is idle past the heartbeat threshold. jq's
        # default (non-slurp) mode already treats a JSONL file as a
        # stream of independent top-level values, so this naturally
        # emits one delimited line per mailbox line, in order.
        #
        # @tsv (not a plain join) specifically so jq escapes any embedded
        # tab/newline/backslash *within* a field's own value (a subject
        # or body can legitimately contain a real newline once jq has
        # parsed it out of JSON's "\n" escape) — without that, an embedded
        # newline would prematurely end a `read` line and misalign every
        # field after it. The tabs @tsv joins fields WITH are then swapped
        # to `|` before `read` ever sees them, for two independent
        # reasons: (1) bash's `read` treats IFS *whitespace* characters
        # (space/tab/newline) specially even when IFS is set to just one
        # of them — a LEADING delimiter is silently stripped instead of
        # producing an empty first field, shifting every field left by one
        # whenever a line's first value (.type, empty for ordinary
        # messages) is empty; (2) this machine's /bin/bash is 3.2, which
        # has a separate, confirmed bug of its own where IFS set to a
        # control character via `$'\x01'`-style ANSI-C quoting silently
        # fails to split at all inside a `read` fed by process
        # substitution (reproduced directly: works fine piped to `cat`,
        # breaks the instant a `while read` loop consumes it). An ordinary
        # printable character sidesteps both bugs. `|` specifically is
        # safe against real message content because `subject` is the LAST
        # variable `read` populates — even if a subject legitimately
        # contains a literal "|", `read` places everything from the 4th
        # field onward into `subject` as one unsplit remainder, embedded
        # delimiters and all. (.type/.id/.from never contain "|": a
        # literal "status_update"/empty, a UUID, and a tmux address.)
        while IFS='|' read -r local_type local_id sender subject; do
            [[ "$local_type" == "status_update" ]] && continue

            if [[ -n "$local_id" ]] && [[ "$resolved_ids_wrapped" == *$'\n'"$local_id"$'\n'* ]]; then
                continue
            fi

            ((mailbox_count++))
            [[ -n "$sender" ]] && senders+=("$sender")

            # Quoting the literal brackets keeps this a literal-string
            # match rather than a glob character class (`[BLOCKED]`
            # unquoted would match any single one of those letters).
            case "$subject" in
                "[BLOCKED]"*)  ((blocked_count++)) ;;
                "[DONE]"*)     ((done_count++)) ;;
                "[STATUS]"*)   ((status_count++)) ;;
                "[QUESTION]"*) ((question_count++)) ;;
                *)             ((other_count++)) ;;
            esac
        done < <(jq -r '[(.type // ""), (.id // ""), (.from // ""), (.subject // "")] | @tsv' "$SOREN_MAILBOX" 2>/dev/null | tr '\t' '|')
    else
        # Fallback when jq is entirely unavailable — rare (jq is a hard
        # dependency pervasively elsewhere in this codebase), so this path
        # is intentionally left as the original, unoptimized per-line
        # sed-based parsing rather than adding more complexity for a case
        # that basically never executes in practice.
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue

            local_type=$(echo "$line" | sed -n 's/.*"type":"\([^"]*\)".*/\1/p')
            [[ "$local_type" == "status_update" ]] && continue

            local_id=$(echo "$line" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
            if [[ -n "$local_id" ]] && [[ "$resolved_ids_wrapped" == *$'\n'"$local_id"$'\n'* ]]; then
                continue
            fi

            ((mailbox_count++))

            sender=$(echo "$line" | sed -n 's/.*\] \([^:]*:[^ ]*\) ->.*/\1/p' | head -1)
            [[ -z "$sender" ]] && sender=$(echo "$line" | sed -n 's/.*\] \([^ ]*\) ->.*/\1/p' | head -1)
            [[ -n "$sender" ]] && senders+=("$sender")

            if echo "$line" | grep -q '"subject"'; then
                subject=$(echo "$line" | sed -n 's/.*"subject":"\([^"]*\)".*/\1/p')
            else
                subject=$(echo "$line" | sed -n 's/.*-> [^:]*: *\(.*\)/\1/p')
            fi

            case "$subject" in
                "[BLOCKED]"*)  ((blocked_count++)) ;;
                "[DONE]"*)     ((done_count++)) ;;
                "[STATUS]"*)   ((status_count++)) ;;
                "[QUESTION]"*) ((question_count++)) ;;
                *)             ((other_count++)) ;;
            esac
        done < "$SOREN_MAILBOX"
    fi

    if ((mailbox_count > 0)); then
        # Build detail string
        details_parts=()
        ((blocked_count > 0)) && details_parts+=("${blocked_count} BLOCKED")
        ((done_count > 0)) && details_parts+=("${done_count} DONE")
        ((question_count > 0)) && details_parts+=("${question_count} QUESTION")
        ((status_count > 0)) && details_parts+=("${status_count} STATUS")
        ((other_count > 0)) && details_parts+=("${other_count} other")

        # Unique senders
        unique_senders=""
        if ((${#senders[@]} > 0)); then
            unique_senders=$(printf '%s\n' "${senders[@]}" | sort -u | paste -sd', ' -)
        fi

        type_detail=""
        if ((${#details_parts[@]} > 0)); then
            type_detail=$(IFS=', '; echo "${details_parts[*]}")
        fi

        mailbox_summary="${mailbox_count} unread"
        if [[ -n "$type_detail" ]]; then
            mailbox_summary="${mailbox_summary} (${type_detail})"
        fi
        if [[ -n "$unique_senders" ]]; then
            mailbox_summary="${mailbox_summary} from: ${unique_senders}"
        fi

        # BLOCKED messages are highest priority
        if ((blocked_count > 0)); then
            mailbox_priority="blocked"
            highest_priority="Mailbox has ${blocked_count} BLOCKED message(s) — agents need help"
        elif ((question_count > 0)); then
            mailbox_priority="question"
            [[ -z "$highest_priority" ]] && highest_priority="Mailbox has ${question_count} QUESTION(s) awaiting response"
        elif ((done_count > 0)); then
            mailbox_priority="done"
            [[ -z "$highest_priority" ]] && highest_priority="Mailbox has ${done_count} DONE report(s) to review"
        fi
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 2. Workers — active/idle with names
#───────────────────────────────────────────────────────────────────────────────

context_dir="${SOREN_PROJECT_ROOT}/.soren/worker-contexts"
windows=$(tmux list-windows -t "$SOREN_SESSION" -F '#{window_name}' 2>/dev/null || true)
now=$(date +%s)

if [[ -n "$windows" ]]; then
    active_workers=()
    idle_workers=()

    while IFS= read -r wname; do
        [[ -z "$wname" ]] && continue
        # Skip system windows
        [[ "$wname" == "monitor" ]] && continue
        [[ "$wname" == "supervisor" ]] && continue
        [[ "$wname" == sup-* ]] && continue
        [[ "$wname" == "sentry" ]] && continue

        # Check if this looks like a worker (has a context file)
        local_ctx="${context_dir}/${wname}-context.md"
        if [[ ! -f "$local_ctx" ]]; then
            continue
        fi

        # Check idle time via context file mtime
        file_mtime=$(stat -c %Y "$local_ctx" 2>/dev/null || stat -f %m "$local_ctx" 2>/dev/null || echo 0)

        idle_seconds=$((now - file_mtime))
        if ((idle_seconds > WORKER_IDLE_THRESHOLD)); then
            idle_min=$((idle_seconds / 60))
            idle_workers+=("${wname} (${idle_min}m)")
            ((worker_idle_count++))
        else
            active_workers+=("$wname")
        fi
    done <<< "$windows"

    worker_active=${#active_workers[@]}
    total_workers=$((worker_active + worker_idle_count))

    if ((total_workers > 0)); then
        worker_summary="${worker_active} active"
        if ((worker_idle_count > 0)); then
            worker_idle_names=$(IFS=', '; echo "${idle_workers[*]}")
            worker_summary="${worker_summary}, ${worker_idle_count} idle >30min (${worker_idle_names})"
            [[ -z "$highest_priority" ]] && highest_priority="Worker(s) idle >30min: ${worker_idle_names} — consider cleanup"
        fi
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 3. Backlog — pending items with priority breakdown (from the tasks table)
#───────────────────────────────────────────────────────────────────────────────

if [[ -f "$SOREN_DB_PATH" ]]; then
    # In supervised mode (the default — see tools/backlog's is_supervised),
    # agent-filed proposals sit with approved=0 until a human runs
    # `backlog approve` — they're genuinely unclaimable by any agent until
    # then (tools/backlog's own cmd_claim rejects them). Counting them here
    # the same as claimable work meant the heartbeat nudged the supervisor
    # every idle cycle to "act on" something it was explicitly forbidden to
    # touch — a loop only a human approving/rejecting could break.
    # Autonomous mode has no such gate (tools/backlog's cmd_next drops the
    # approved filter entirely), so nothing changes there.
    approval_filter=""
    if [[ "${SOREN_AUTONOMY:-supervised}" != "autonomous" ]]; then
        approval_filter="AND approved=1"
    fi

    p1=$(soren_db "SELECT COUNT(*) FROM tasks WHERE status='backlog' AND priority='critical' ${approval_filter};" 2>/dev/null || echo 0)
    p2=$(soren_db "SELECT COUNT(*) FROM tasks WHERE status='backlog' AND priority='high' ${approval_filter};" 2>/dev/null || echo 0)
    p3=$(soren_db "SELECT COUNT(*) FROM tasks WHERE status='backlog' AND priority='medium' ${approval_filter};" 2>/dev/null || echo 0)
    p4=$(soren_db "SELECT COUNT(*) FROM tasks WHERE status='backlog' AND priority='low' ${approval_filter};" 2>/dev/null || echo 0)
    backlog_total=$((p1 + p2 + p3 + p4))

    if ((backlog_total > 0)); then
        priority_parts=()
        ((p1 > 0)) && priority_parts+=("${p1} critical")
        ((p2 > 0)) && priority_parts+=("${p2} high")
        ((p3 > 0)) && priority_parts+=("${p3} medium")
        ((p4 > 0)) && priority_parts+=("${p4} low")

        backlog_summary="${backlog_total} items ($(IFS=', '; echo "${priority_parts[*]}"))"

        if ((p1 > 0)) && [[ -z "$highest_priority" ]]; then
            highest_priority="Backlog has ${p1} critical-priority item(s) — claim with ./tools/backlog next"
        elif ((p2 > 0)) && [[ -z "$highest_priority" ]]; then
            highest_priority="Backlog has ${p2} high-priority item(s) pending"
        fi
    fi

    # Pending-approval proposals are reported for visibility only — they
    # deliberately do NOT feed backlog_summary/highest_priority/has_findings
    # above, so a cycle where the only "work" is unclaimable proposals goes
    # genuinely quiet instead of renudging "act on it" every idle period.
    # A human still sees them any time via `./tools/backlog list` or the
    # dashboard, on their own schedule, without the supervisor being
    # interrupted about something it cannot act on.
    if [[ "${SOREN_AUTONOMY:-supervised}" != "autonomous" ]]; then
        pending_approval_total=$(soren_db "SELECT COUNT(*) FROM tasks WHERE status='backlog' AND approved=0;" 2>/dev/null || echo 0)
        if ((pending_approval_total > 0)); then
            backlog_pending_summary="${pending_approval_total} item(s) awaiting human approval (not actionable by agents)"
        fi
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 4. Project supervisors — health status
#───────────────────────────────────────────────────────────────────────────────

registry="${SOREN_PROJECT_ROOT}/.soren/projects.json"
if [[ -f "$registry" ]]; then
    active_projects=$(jq -r '.projects[] | select(.active == true and .is_self == false) | .id' "$registry" 2>/dev/null || true)

    if [[ -n "$active_projects" ]]; then
        sup_parts=()
        while IFS= read -r project_id; do
            [[ -z "$project_id" ]] && continue
            local_sup="sup-${project_id}"
            local_hb="${SOREN_PROJECT_ROOT}/.soren/.${local_sup}-heartbeat"

            if ! echo "$windows" | grep -qxF "$local_sup" 2>/dev/null; then
                sup_parts+=("${local_sup} DOWN")
                [[ -z "$highest_priority" ]] && highest_priority="Project supervisor ${local_sup} is down — needs relaunch"
                continue
            fi

            if [[ -f "$local_hb" ]]; then
                local_beat=$(cat "$local_hb" 2>/dev/null || echo 0)
                if [[ "$local_beat" =~ ^[0-9]+$ ]]; then
                    local_staleness=$((now - local_beat))
                    if ((local_staleness < 600)); then
                        sup_parts+=("${local_sup} active")
                    elif ((local_staleness < 1800)); then
                        idle_hr=$((local_staleness / 60))
                        sup_parts+=("${local_sup} idle ${idle_hr}min")
                    else
                        idle_hr=$((local_staleness / 3600))
                        idle_rem=$(( (local_staleness % 3600) / 60 ))
                        if ((idle_hr > 0)); then
                            sup_parts+=("${local_sup} idle ${idle_hr}hr${idle_rem}m")
                        else
                            sup_parts+=("${local_sup} idle ${idle_rem}min")
                        fi
                    fi
                else
                    sup_parts+=("${local_sup} unknown")
                fi
            else
                sup_parts+=("${local_sup} no-heartbeat")
            fi
        done <<< "$active_projects"

        if ((${#sup_parts[@]} > 0)); then
            supervisor_summary=$(IFS=', '; echo "${sup_parts[*]}")
        fi
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 4a. Scheduled check-ins — fire due reminders
#───────────────────────────────────────────────────────────────────────────────

schedule_summary=""
schedule_tool="${SOREN_PROJECT_ROOT}/tools/schedule"
if [[ -x "$schedule_tool" ]]; then
    fired_notes=$("$schedule_tool" fire 2>/dev/null || true)
    if [[ -n "$fired_notes" ]]; then
        fired_count=$(echo "$fired_notes" | wc -l | tr -d ' ')
        schedule_summary="${fired_count} reminder(s): ${fired_notes}"
        highest_priority="Scheduled reminder: $(echo "$fired_notes" | head -1)"
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 4b. Watchdog — stuck agent detection
#───────────────────────────────────────────────────────────────────────────────

watchdog_summary=""
watchdog_tool="${SOREN_PROJECT_ROOT}/tools/watchdog"
if [[ -x "$watchdog_tool" ]]; then
    watchdog_output=$("$watchdog_tool" scan 2>/dev/null || true)
    # Extract stuck agents (lines with red dot indicator)
    stuck_lines=$(echo "$watchdog_output" | grep -E '●.*critical|●.*warning' | grep -v 'healthy' || true)
    if [[ -n "$stuck_lines" ]]; then
        # Count stuck agents
        stuck_count=$(echo "$stuck_lines" | wc -l | tr -d ' ')
        # Extract agent names and issues
        stuck_details=$(echo "$stuck_lines" | sed 's/.*●[[:space:]]*//' | sed 's/[[:space:]]*healthy.*//' | tr '\n' '; ' | sed 's/; $//')
        watchdog_summary="${stuck_count} stuck agent(s): ${stuck_details}"
        [[ -z "$highest_priority" ]] && highest_priority="Watchdog: ${stuck_count} agent(s) stuck — run ./tools/watchdog scan for details"
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 5. Git — uncommitted tracked changes
#───────────────────────────────────────────────────────────────────────────────

cd "$SOREN_PROJECT_ROOT"
git_diff_stat=$(git diff --stat HEAD -- \
    ':!.soren/soren.db' ':!.soren/conversations.db' ':!.soren/mailbox' ':!.soren/.supervisor-heartbeat' \
    ':!.soren/.router_line' ':!.soren/.router_position' ':!.soren/.log_markers/' \
    ':!.soren/audit.log' ':!.soren/tasks.db' 2>/dev/null || true)

if [[ -n "$git_diff_stat" ]]; then
    git_file_count=$(echo "$git_diff_stat" | grep -c '|' || echo 0)
    git_stat_line=$(echo "$git_diff_stat" | tail -1 | sed 's/^ *//')
    git_summary="${git_file_count} uncommitted files (${git_stat_line})"
    [[ -z "$highest_priority" ]] && highest_priority="Uncommitted changes — consider committing"
fi

# Also check untracked files (new files not yet added)
untracked_count=$(git ls-files --others --exclude-standard -- ':!.soren/soren.db' ':!.soren/conversations.db' ':!.soren/mailbox' ':!.soren/.supervisor-heartbeat' 2>/dev/null | wc -l | tr -d ' ')
if ((untracked_count > 0)); then
    if [[ -n "$git_summary" ]]; then
        git_summary="${git_summary}, ${untracked_count} untracked"
    else
        git_summary="${untracked_count} untracked files"
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 6. Health — system health endpoint
#───────────────────────────────────────────────────────────────────────────────

if ! curl -sf "http://localhost:${SOREN_PORT}/api/webhooks/health" >/dev/null 2>&1; then
    health_summary="FAILED (port ${SOREN_PORT})"
    highest_priority="Server health check FAILED — immediate attention required"
fi

#───────────────────────────────────────────────────────────────────────────────
# Check if anything was found
#───────────────────────────────────────────────────────────────────────────────

has_findings=false
[[ -n "$mailbox_summary" ]] && has_findings=true
[[ -n "$worker_summary" ]] && has_findings=true
[[ -n "$backlog_summary" ]] && has_findings=true
[[ -n "$supervisor_summary" ]] && has_findings=true
[[ -n "$schedule_summary" ]] && has_findings=true
[[ -n "$watchdog_summary" ]] && has_findings=true
[[ -n "$git_summary" ]] && has_findings=true
[[ -n "$health_summary" ]] && has_findings=true

if [[ "$has_findings" != "true" ]]; then
    if [[ "$OUTPUT_MODE" == "summary" ]]; then
        echo "All clear — no pending work found."
    fi
    exit 1
fi

#───────────────────────────────────────────────────────────────────────────────
# Output
#───────────────────────────────────────────────────────────────────────────────

if [[ "$OUTPUT_MODE" == "summary" ]]; then
    # Structured summary — one line per section, designed for monitor.sh to
    # assemble into a [HEARTBEAT] message
    [[ -n "$mailbox_summary" ]]    && echo "Mailbox: ${mailbox_summary}"
    [[ -n "$worker_summary" ]]     && echo "Workers: ${worker_summary}"
    [[ -n "$backlog_summary" ]]    && echo "Backlog: ${backlog_summary}"
    # Purely informational — never the reason this cycle counted as
    # "actionable" (see has_findings below), so it only ever gets shown
    # piggybacking on other genuine findings, never on its own.
    [[ -n "$backlog_pending_summary" ]] && echo "Backlog (pending approval): ${backlog_pending_summary}"
    [[ -n "$supervisor_summary" ]] && echo "Supervisors: ${supervisor_summary}"
    [[ -n "$schedule_summary" ]]   && echo "Reminders: ${schedule_summary}"
    [[ -n "$watchdog_summary" ]]   && echo "Watchdog: ${watchdog_summary}"
    [[ -n "$git_summary" ]]        && echo "Git: ${git_summary}"
    [[ -n "$health_summary" ]]     && echo "Health: ${health_summary}"

    # Priority recommendation
    if [[ -n "$highest_priority" ]]; then
        echo "---"
        echo "Highest priority: ${highest_priority}"
    fi
fi

exit 0
