#!/usr/bin/env bash
# integration-check — run the full integration test suite across worker outputs
#
# Usage: tools/integration-check [--since <commit>] [--project <id>] [--json]
#   --since  : check changes since this commit (default: HEAD~5)
#   --project: limit to a specific project ID
#   --json   : output raw JSON instead of human summary
#
# Exit code: 0 if all checks pass, 1 if any fail

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Defaults
SINCE_COMMIT="HEAD~5"
PROJECT_ID=""
JSON_OUTPUT=0

# Parse args
while [[ $# -gt 0 ]]; do
    case "$1" in
        --since)
            SINCE_COMMIT="$2"
            shift 2
            ;;
        --project)
            PROJECT_ID="$2"
            shift 2
            ;;
        --json)
            JSON_OUTPUT=1
            shift
            ;;
        -h|--help)
            echo "Usage: tools/integration-check [--since <commit>] [--project <id>] [--json]"
            echo ""
            echo "Options:"
            echo "  --since <commit>   Check changes since this commit (default: HEAD~5)"
            echo "  --project <id>     Limit to a specific project ID"
            echo "  --json             Output raw JSON"
            echo ""
            echo "Checks run:"
            echo "  1. Import/syntax validity for changed Python files"
            echo "  2. API contract consistency (frontend calls match backend routes)"
            echo "  3. pytest -x (fail-fast, only if Python changed)"
            echo "  4. TypeScript typecheck (only if frontend TS/TSX files changed)"
            echo "  5. Frontend build (only if typecheck passed and frontend changed)"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            echo "Run with --help for usage" >&2
            exit 1
            ;;
    esac
done

# Build the Python invocation
python_script='
import sys, json
sys.path.insert(0, ".")
from src.server.services.integration_checker import run_integration_check

since = sys.argv[1]
project_id = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else None

result = run_integration_check(since_commit=since, project_id=project_id)
print(json.dumps(result, indent=2))
'

cd "${PROJECT_ROOT}"
JSON=$(uv run python -c "$python_script" "$SINCE_COMMIT" "${PROJECT_ID}" 2>&1)
EXIT_CODE=$?

if [[ $EXIT_CODE -ne 0 ]]; then
    echo "ERROR: Integration checker failed to run:" >&2
    echo "$JSON" >&2
    exit 1
fi

if [[ $JSON_OUTPUT -eq 1 ]]; then
    echo "$JSON"
else
    # Human-readable summary
    PASSED=$(echo "$JSON" | python3 -c "import sys, json; d=json.load(sys.stdin); print('PASS' if d['passed'] else 'FAIL')")
    SINCE=$(echo "$JSON" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d['since_commit'])")
    CHANGED=$(echo "$JSON" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d['changed_count'])")

    echo ""
    echo "══════════════════════════════════════════════"
    echo " Integration Check — since ${SINCE}"
    echo " Changed files: ${CHANGED}"
    echo "══════════════════════════════════════════════"

    # Print each summary line
    echo "$JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
for line in d.get('summary', []):
    if line.startswith('PASS'):
        print('  \033[32m' + line + '\033[0m')
    elif line.startswith('FAIL'):
        print('  \033[31m' + line + '\033[0m')
    else:
        print('  ' + line)
"

    echo "══════════════════════════════════════════════"

    if [[ "$PASSED" == "PASS" ]]; then
        echo -e "  RESULT: \033[32mALL CHECKS PASSED\033[0m"
        echo "══════════════════════════════════════════════"
        echo ""
        exit 0
    else
        echo -e "  RESULT: \033[31mCHECKS FAILED\033[0m"
        echo "══════════════════════════════════════════════"

        # Print failure details
        echo ""
        echo "$JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
checks = d.get('checks', {})

# Import failures
imp = checks.get('imports', {})
for f in imp.get('failures', []):
    print(f'  [{f[\"check\"].upper()}] {f[\"file\"]}')
    if f.get('error'):
        print(f'    {f[\"error\"]}')

# API contract errors
api = checks.get('api_contracts', {})
for e in api.get('errors', []):
    print(f'  [API] {e[\"message\"]}')

# pytest output
pt = checks.get('pytest', {})
if not pt.get('passed') and pt.get('output'):
    lines = pt['output'].strip().splitlines()
    print()
    print('  [PYTEST]')
    for line in lines[-20:]:
        print(f'    {line}')

# typecheck output
tc = checks.get('typecheck', {})
if not tc.get('passed') and tc.get('output'):
    lines = tc['output'].strip().splitlines()
    print()
    print('  [TYPECHECK]')
    for line in lines[-10:]:
        print(f'    {line}')

# build output
bld = checks.get('frontend_build', {})
if not bld.get('passed') and bld.get('output'):
    lines = bld['output'].strip().splitlines()
    print()
    print('  [BUILD]')
    for line in lines[-10:]:
        print(f'    {line}')
"
        echo ""
        exit 1
    fi
fi
