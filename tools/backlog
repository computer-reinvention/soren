#!/usr/bin/env bash
#===============================================================================
# backlog - Manage backlog items in the SOREN tasks database
#
# Backlog is a status field on tasks in the consolidated .soren/soren.db.
# This CLI provides a convenient interface for managing backlog items.
#
# Usage:
#   backlog add "<title>" [priority 1-5]         - Add backlog item
#   backlog add "<title>" "<desc>" [pri] [src]    - Add with description
#   backlog list                                  - Show backlog items by priority
#   backlog next                                  - Claim highest-priority backlog item
#   backlog claim <id>                            - Claim a specific backlog item
#   backlog approve <id> | --all                  - Approve item(s) (humans only)
#   backlog reject <id>                           - Reject item (humans only)
#   backlog done <id> [remarks]                   - Mark item done with optional remarks
#   backlog complete <id> [remarks]               - Alias for done
#   backlog skip <id>                             - Mark item done (skipped)
#   backlog prioritize <id> <priority>            - Change priority (1-5)
#   backlog show <id>                             - Show full details
#
# Autonomy gating (SOREN_AUTONOMY=supervised|autonomous, default supervised):
#   Agent-added items (SOREN_AGENT=true) are proposals (approved=0). In
#   supervised mode they cannot be claimed until a human approves them.
#   Set SOREN_AUTONOMY=autonomous to restore ungated behavior.
#
# Storage: .soren/soren.db (consolidated SQLite DB — tasks with status='backlog')
# Designed for supervisor agents to maintain autonomous work queues.
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

# Shared DB helpers (SOREN_DB_PATH resolution + soren_db wrapper)
source "${SOREN_HOME}/tools/lib/db.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

SEP="$(printf '\x1f')"  # Unit separator for field splitting

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }

#-------------------------------------------------------------------------------
# Helpers
#-------------------------------------------------------------------------------

ensure_db() {
    [[ -f "$SOREN_DB_PATH" ]] || die "database not found: $SOREN_DB_PATH"
    # The DB file is shared with other domains — require the tasks table
    # (created by tools/tasks or tools/migrate-state), not just the file.
    local has_tasks
    has_tasks=$(soren_db "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='tasks';")
    [[ "$has_tasks" == "1" ]] || die "tasks table not found in $SOREN_DB_PATH (run ./tools/tasks dashboard or tools/migrate-state first)"
    # Ensure the remarks column exists (may be missing from older schemas).
    # ALTER TABLE ... ADD COLUMN is a no-op if the column already exists in
    # SQLite >= 3.35; for older versions we check first.
    if ! soren_db "SELECT remarks FROM tasks LIMIT 0;" 2>/dev/null; then
        soren_db "ALTER TABLE tasks ADD COLUMN remarks TEXT DEFAULT '';" 2>/dev/null || true
    fi
    # Migrate: add approved column if missing (autonomy gating).
    # Existing user-sourced items are grandfathered as approved.
    local has_approved
    has_approved=$(soren_db "SELECT COUNT(*) FROM pragma_table_info('tasks') WHERE name='approved';")
    if [[ "$has_approved" == "0" ]]; then
        soren_db "ALTER TABLE tasks ADD COLUMN approved INTEGER DEFAULT 0;"
        soren_db "UPDATE tasks SET approved=1 WHERE source='user';"
    fi
}

# True when running inside an agent context (supervisor/worker/sentry).
is_agent() {
    [[ "${SOREN_AGENT:-}" == "true" ]]
}

# True when autonomy gating is active (default: supervised).
is_supervised() {
    [[ "${SOREN_AUTONOMY:-supervised}" != "autonomous" ]]
}

gen_uuid() {
    uuidgen | tr '[:upper:]' '[:lower:]'
}

# Map numeric priority (1-5) to text
pri_num_to_text() {
    case "$1" in
        1) echo "critical" ;;
        2) echo "high" ;;
        3) echo "medium" ;;
        4|5) echo "low" ;;
        *) echo "medium" ;;
    esac
}

# Map text priority to numeric for display
pri_text_to_num() {
    case "$1" in
        critical) echo "1" ;;
        high)     echo "2" ;;
        medium)   echo "3" ;;
        low)      echo "4" ;;
        *)        echo "3" ;;
    esac
}

priority_label() {
    case "$1" in
        1|critical) echo -e "${RED}P1-critical${NC}" ;;
        2|high)     echo -e "${YELLOW}P2-high${NC}" ;;
        3|medium)   echo -e "${CYAN}P3-medium${NC}" ;;
        4|5|low)    echo -e "${DIM}P4-low${NC}" ;;
        *)          echo "P?" ;;
    esac
}

status_label() {
    case "$1" in
        backlog)     echo -e "${CYAN}backlog${NC}" ;;
        pending)     echo -e "${YELLOW}pending${NC}" ;;
        done)        echo -e "${GREEN}done${NC}" ;;
        rejected)    echo -e "${RED}rejected${NC}" ;;
        *)           echo "$1" ;;
    esac
}

# Abbreviate UUID for display (first 8 chars)
short_id() {
    echo "${1:0:8}"
}

# Resolve partial ID prefix to full task ID
resolve_id() {
    local partial="$1"
    local matches
    matches=$(soren_db "SELECT id FROM tasks WHERE id LIKE '$(echo "$partial" | sed "s/'/''/g")%';")

    if [[ -z "$matches" ]]; then
        die "item not found: ${partial}"
    fi

    local count
    count=$(echo "$matches" | wc -l | tr -d ' ')

    if [[ "$count" -eq 1 ]]; then
        echo "$matches"
    else
        die "ambiguous ID '${partial}' — matches ${count} items. Use more characters."
    fi
}

#-------------------------------------------------------------------------------
# Commands
#-------------------------------------------------------------------------------

cmd_add() {
    local title="${1:-}"
    [[ -z "$title" ]] && die "usage: backlog add \"<title>\" [priority 1-5]"
    shift

    local description="" priority_num="3" source=""

    # Parse remaining args: if next is a number 1-5, it's priority.
    # Otherwise it's a description (legacy format: "<desc>" [pri] [src]).
    if [[ $# -gt 0 ]]; then
        if [[ "$1" =~ ^[1-5]$ ]]; then
            priority_num="$1"
            shift
        else
            description="$1"
            shift
            if [[ $# -gt 0 && "$1" =~ ^[1-5]$ ]]; then
                priority_num="$1"
                shift
            fi
            if [[ $# -gt 0 ]]; then
                source="$1"
                shift
            fi
        fi
    fi

    # Autonomy gating: agent-invented items are unapproved proposals.
    # Agents may only pass source='user' when relaying an explicit user request.
    local approved=1
    if is_agent; then
        if [[ "$source" != "user" ]]; then
            source="self"
            approved=0
        fi
    else
        [[ -z "$source" ]] && source="user"
    fi

    ensure_db

    local id priority_text now
    id=$(gen_uuid)
    priority_text=$(pri_num_to_text "$priority_num")
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    soren_db "INSERT INTO tasks (id, title, description, status, priority, source, approved, created_at, updated_at)
        VALUES ('$id', '$(echo "$title" | sed "s/'/''/g")', '$(echo "$description" | sed "s/'/''/g")', 'backlog', '$priority_text', '$(echo "$source" | sed "s/'/''/g")', $approved, '$now', '$now');"

    ok "Added $(short_id "$id"): ${title} ($(priority_label "$priority_num"))"
    if [[ "$approved" == "0" ]]; then
        echo -e "${DIM}pending-approval — a human must run: ./tools/backlog approve $(short_id "$id")${NC}"
    fi
}

cmd_list() {
    ensure_db

    local rows
    rows=$(soren_db -separator "$SEP" "SELECT id, priority, source, approved, title FROM tasks WHERE status='backlog' ORDER BY
        CASE priority
            WHEN 'critical' THEN 1
            WHEN 'high' THEN 2
            WHEN 'medium' THEN 3
            WHEN 'low' THEN 4
            ELSE 5
        END, created_at;")

    if [[ -z "$rows" ]]; then
        echo -e "${DIM}No backlog items${NC}"
        return
    fi

    echo -e "${BOLD}Backlog:${NC}"
    echo ""
    printf "${DIM}%-10s  %-12s  %-12s  %-14s  %s${NC}\n" "ID" "PRIORITY" "STATUS" "SOURCE" "TITLE"
    echo -e "${DIM}──────────  ────────────  ────────────  ──────────────  ─────────────────────────${NC}"

    local count=0 pending_count=0
    while IFS="$SEP" read -r id priority source approved title; do
        local approval_tag=""
        if [[ "$approved" != "1" ]]; then
            approval_tag=" ${DIM}[pending-approval]${NC}"
            ((pending_count++)) || true
        fi
        printf "%-10s  %-12b  %-12b  %-14s  %s%b\n" \
            "$(short_id "$id")" \
            "$(priority_label "$priority")" \
            "$(status_label "backlog")" \
            "$source" \
            "$title" \
            "$approval_tag"
        ((count++))
    done <<< "$rows"

    echo ""
    echo -e "${DIM}${count} item(s)${NC}"
    if ((pending_count > 0)); then
        echo -e "${DIM}${pending_count} awaiting human approval — ./tools/backlog approve <id> (or --all)${NC}"
    fi
}

# Shared claim transition: backlog → pending (with history entry)
do_claim() {
    local id="$1" title="$2" description="$3" priority="$4"

    local now
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    soren_db "UPDATE tasks SET status='pending', updated_at='$now' WHERE id='$id';"
    soren_db "INSERT INTO task_status_history (task_id, old_status, new_status, changed_at) VALUES ('$id', 'backlog', 'pending', '$now');"

    echo -e "${BOLD}Claimed item: $(short_id "$id")${NC}"
    echo -e "  Title:    ${title}"
    echo -e "  Priority: $(priority_label "$priority")"
    if [[ -n "$description" ]]; then
        echo -e "  Description: ${description}"
    fi
    echo ""
    ok "Marked $(short_id "$id") as pending"
}

cmd_next() {
    ensure_db

    # In supervised mode only approved items are claimable.
    local approval_filter=""
    if is_supervised; then
        approval_filter="AND approved=1"
    fi

    local row
    row=$(soren_db -separator "$SEP" "SELECT id, title, description, priority FROM tasks WHERE status='backlog' $approval_filter ORDER BY
        CASE priority
            WHEN 'critical' THEN 1
            WHEN 'high' THEN 2
            WHEN 'medium' THEN 3
            WHEN 'low' THEN 4
            ELSE 5
        END, created_at LIMIT 1;")

    if [[ -z "$row" ]]; then
        local unapproved=0
        if is_supervised; then
            unapproved=$(soren_db "SELECT COUNT(*) FROM tasks WHERE status='backlog' AND approved=0;")
        fi
        if ((unapproved > 0)); then
            die "no approved backlog items — ${unapproved} item(s) awaiting human approval — run: ./tools/backlog approve <id> (or set SOREN_AUTONOMY=autonomous)"
        fi
        echo -e "${DIM}No backlog items${NC}"
        return 1
    fi

    local id title description priority
    IFS="$SEP" read -r id title description priority <<< "$row"

    do_claim "$id" "$title" "$description" "$priority"
}

cmd_claim() {
    local id_input="${1:-}"
    [[ -z "$id_input" ]] && die "usage: backlog claim <id>"

    ensure_db
    local id
    id=$(resolve_id "$id_input")

    local status
    status=$(soren_db "SELECT status FROM tasks WHERE id='$id';")
    [[ "$status" == "backlog" ]] || die "item $(short_id "$id") is not in the backlog (status: ${status})"

    # In supervised mode, unapproved proposals cannot be claimed.
    if is_supervised; then
        local approved
        approved=$(soren_db "SELECT approved FROM tasks WHERE id='$id';")
        if [[ "$approved" != "1" ]]; then
            die "item $(short_id "$id") awaiting human approval — run: ./tools/backlog approve $(short_id "$id") (or set SOREN_AUTONOMY=autonomous)"
        fi
    fi

    local title description priority
    title=$(soren_db "SELECT title FROM tasks WHERE id='$id';")
    description=$(soren_db "SELECT description FROM tasks WHERE id='$id';")
    priority=$(soren_db "SELECT priority FROM tasks WHERE id='$id';")

    do_claim "$id" "$title" "$description" "$priority"
}

cmd_approve() {
    if is_agent; then
        die "agents cannot approve backlog items"
    fi

    local id_input="${1:-}"
    [[ -z "$id_input" ]] && die "usage: backlog approve <id> | backlog approve --all"

    ensure_db

    local now
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    if [[ "$id_input" == "--all" ]]; then
        local count
        count=$(soren_db "SELECT COUNT(*) FROM tasks WHERE status='backlog' AND approved=0;")
        soren_db "UPDATE tasks SET approved=1, updated_at='$now' WHERE status='backlog' AND approved=0;"
        ok "Approved ${count} backlog item(s)"
        return
    fi

    local id
    id=$(resolve_id "$id_input")
    soren_db "UPDATE tasks SET approved=1, updated_at='$now' WHERE id='$id';"

    local title
    title=$(soren_db "SELECT title FROM tasks WHERE id='$id';")
    ok "Approved $(short_id "$id"): ${title}"
}

cmd_reject() {
    if is_agent; then
        die "agents cannot approve backlog items"
    fi

    local id_input="${1:-}"
    [[ -z "$id_input" ]] && die "usage: backlog reject <id>"

    ensure_db
    local id
    id=$(resolve_id "$id_input")

    local now old_status
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    old_status=$(soren_db "SELECT status FROM tasks WHERE id='$id';")

    soren_db "UPDATE tasks SET status='rejected', approved=0, updated_at='$now' WHERE id='$id';"
    soren_db "INSERT INTO task_status_history (task_id, old_status, new_status, changed_at) VALUES ('$id', '$old_status', 'rejected', '$now');"

    local title
    title=$(soren_db "SELECT title FROM tasks WHERE id='$id';")
    ok "Rejected $(short_id "$id"): ${title}"
}

cmd_done() {
    local id_input="${1:-}"
    [[ -z "$id_input" ]] && die "usage: backlog done <id> [remarks]"
    shift

    local remarks="${*}"

    ensure_db
    local id
    id=$(resolve_id "$id_input")

    local now
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    local old_status
    old_status=$(soren_db "SELECT status FROM tasks WHERE id='$id';")

    soren_db "UPDATE tasks SET status='done', remarks='$(echo "$remarks" | sed "s/'/''/g")', completed_at='$now', updated_at='$now' WHERE id='$id';"
    soren_db "INSERT INTO task_status_history (task_id, old_status, new_status, changed_at) VALUES ('$id', '$old_status', 'done', '$now');"

    local title
    title=$(soren_db "SELECT title FROM tasks WHERE id='$id';")
    ok "Completed $(short_id "$id"): ${title}"
}

cmd_skip() {
    local id_input="${1:-}"
    [[ -z "$id_input" ]] && die "usage: backlog skip <id>"

    ensure_db
    local id
    id=$(resolve_id "$id_input")

    local now
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    local old_status
    old_status=$(soren_db "SELECT status FROM tasks WHERE id='$id';")

    soren_db "UPDATE tasks SET status='done', remarks='skipped', completed_at='$now', updated_at='$now' WHERE id='$id';"
    soren_db "INSERT INTO task_status_history (task_id, old_status, new_status, changed_at) VALUES ('$id', '$old_status', 'done', '$now');"

    local title
    title=$(soren_db "SELECT title FROM tasks WHERE id='$id';")
    ok "Skipped $(short_id "$id"): ${title}"
}

cmd_prioritize() {
    local id_input="${1:-}"
    local priority_num="${2:-}"

    [[ -z "$id_input" ]] && die "usage: backlog prioritize <id> <priority>"
    [[ -z "$priority_num" ]] && die "usage: backlog prioritize <id> <priority>"

    if ! [[ "$priority_num" =~ ^[1-5]$ ]]; then
        die "priority must be 1-5 (1=highest, 5=lowest)"
    fi

    ensure_db
    local id
    id=$(resolve_id "$id_input")

    local priority_text now
    priority_text=$(pri_num_to_text "$priority_num")
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    soren_db "UPDATE tasks SET priority='$priority_text', updated_at='$now' WHERE id='$id';"

    local title
    title=$(soren_db "SELECT title FROM tasks WHERE id='$id';")
    ok "Reprioritized $(short_id "$id"): ${title} → $(priority_label "$priority_num")"
}

cmd_show() {
    local id_input="${1:-}"
    [[ -z "$id_input" ]] && die "usage: backlog show <id>"

    ensure_db
    local id
    id=$(resolve_id "$id_input")

    _qf() { soren_db "SELECT $1 FROM tasks WHERE id='$id';"; }

    local title description priority status source approved remarks created_at completed_at
    title=$(_qf "title")
    description=$(_qf "description")
    priority=$(_qf "priority")
    status=$(_qf "status")
    source=$(_qf "source")
    approved=$(_qf "approved")
    remarks=$(_qf "remarks")
    created_at=$(_qf "created_at")
    completed_at=$(_qf "completed_at")

    echo -e "${BOLD}Backlog Item $(short_id "$id")${NC}"
    echo -e "  ID:          ${id}"
    echo -e "  Title:       ${title}"
    if [[ -n "$description" ]]; then
        echo -e "  Description: ${description}"
    fi
    echo -e "  Priority:    $(priority_label "$priority")"
    echo -e "  Status:      $(status_label "$status")"
    echo -e "  Source:      ${source}"
    if [[ "$approved" == "1" ]]; then
        echo -e "  Approved:    ${GREEN}yes${NC}"
    else
        echo -e "  Approved:    ${DIM}no (pending-approval)${NC}"
    fi
    echo -e "  Created:     ${created_at}"
    if [[ -n "$completed_at" ]]; then
        echo -e "  Completed:   ${completed_at}"
    fi
    if [[ -n "$remarks" ]]; then
        echo -e "  Remarks:     ${remarks}"
    fi
}

cmd_help() {
    cat << 'EOF'
backlog - Manage backlog items in the SOREN tasks database

USAGE:
    backlog <command> [arguments]

COMMANDS:
    add "<title>" [priority] [src]       Add item (priority 1-5, source: user|system|self)
    add "<title>" "<desc>" [pri] [src]   Add with description
    list                                 List backlog items, sorted by priority
                                         (unapproved items show a pending-approval tag)
    next                                 Claim highest-priority claimable item (→ pending)
    claim <id>                           Claim a specific item (→ pending)
    approve <id> | --all                 Approve proposal(s) for claiming (humans only)
    reject <id>                          Reject a proposal (→ rejected; humans only)
    done <id> [remarks]                  Mark item done with optional remarks
    complete <id> [remarks]              Alias for done
    skip <id>                            Mark item done (skipped)
    prioritize <id> <priority>           Change priority (1=highest, 5=lowest)
    show <id>                            Show full details for one item
    help                                 Show this help

IDS:
    Items use UUID identifiers. You can use a prefix (e.g. first 8 chars)
    as long as it uniquely identifies the item.

AUTONOMY GATING:
    Items added by agents (SOREN_AGENT=true) are recorded as source='self'
    proposals with approved=0. In supervised mode (SOREN_AUTONOMY unset or
    != autonomous, the default) unapproved items cannot be claimed until a
    human runs 'backlog approve <id>' (or 'approve --all'). Agents can never
    approve or reject items. Items added by humans default to source='user'
    and are pre-approved. SOREN_AUTONOMY=autonomous disables claim gating.

EXAMPLES:
    backlog add "Fix auth bug" 1
    backlog add "Run test suite" "Full pytest run" 3
    backlog list
    backlog next
    backlog claim 7966ee6a
    backlog approve 7966ee6a
    backlog approve --all
    backlog reject 368208bc
    backlog done 7966ee6a "Fixed in commit abc123"
    backlog skip 368208bc
    backlog prioritize 206c8978 1
    backlog show 7966ee6a

STORAGE:
    .soren/soren.db — tasks with status='backlog' in the unified tasks table.
    Claimed items (via next/claim) transition to status='pending'.

ENVIRONMENT:
    SOREN_HOME       Project root (default: git rev-parse --show-toplevel)
    SOREN_AUTONOMY   supervised (default) | autonomous — claim gating mode
    SOREN_AGENT      set to 'true' in agent shells; forces proposals on add
EOF
}

#-------------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------------

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        add)        cmd_add "$@" ;;
        list)       cmd_list "$@" ;;
        next)       cmd_next "$@" ;;
        claim)      cmd_claim "$@" ;;
        approve)    cmd_approve "$@" ;;
        reject)     cmd_reject "$@" ;;
        done)       cmd_done "$@" ;;
        complete)   cmd_done "$@" ;;
        skip)       cmd_skip "$@" ;;
        prioritize) cmd_prioritize "$@" ;;
        show)       cmd_show "$@" ;;
        help|--help|-h) cmd_help ;;
        *)          die "unknown command: $cmd (try 'backlog help')" ;;
    esac
}

main "$@"
