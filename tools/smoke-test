#!/usr/bin/env bash
# tools/smoke-test — Endpoint smoke tests for deeper SOREN health validation
# Usage: ./tools/smoke-test [--url http://localhost:8000]
#
# Called from monitor.sh as a deeper health check beyond just /api/webhooks/health.
# Tests all critical API endpoints and reports PASS/FAIL with response time.
# Exit 0 if all tested endpoints pass, exit 1 if any fail.
#
# Auth (required for protected endpoints):
#   SOREN_SMOKE_TOKEN=<jwt>                        pre-generated JWT token
#   SOREN_SMOKE_USER=<u> SOREN_SMOKE_PASS=<p>       auto-login to get token
#   (if neither set, auth-required tests are skipped and counted as failures)

set -euo pipefail
cd "$(dirname "$0")/.."

SOREN_PORT="${SOREN_PORT:-8000}"
BASE_URL="${SOREN_SMOKE_URL:-http://localhost:${SOREN_PORT}}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --url) BASE_URL="$2"; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
    esac
done

# --- Terminal colours (disabled when not a tty, e.g. log files) ---
if [[ -t 1 ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; DIM='\033[2m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; DIM=''; NC=''
fi

pass=0; fail=0; skip=0

# --- Temp file for curl response body (.soren/run/ is gitignored) ---
mkdir -p .soren/run
TMPBODY=".soren/run/smoke-test-$$.tmp"
trap 'rm -f "$TMPBODY"' EXIT

# --- Acquire auth token ---
TOKEN="${SOREN_SMOKE_TOKEN:-}"
if [[ -z "$TOKEN" && -n "${SOREN_SMOKE_USER:-}" && -n "${SOREN_SMOKE_PASS:-}" ]]; then
    login_resp=$(curl -sf --max-time 5 \
        -X POST "${BASE_URL}/api/auth/login" \
        -H "Content-Type: application/json" \
        -d "{\"username\":\"${SOREN_SMOKE_USER}\",\"password\":\"${SOREN_SMOKE_PASS}\"}" \
        2>/dev/null) || login_resp=""
    if [[ -n "$login_resp" ]]; then
        TOKEN=$(echo "$login_resp" | jq -r '.token // empty' 2>/dev/null) || TOKEN=""
    fi
fi

# --- check <label> <url> <expected_http_code> <jq_expr> <needs_auth> ---
# jq_expr is evaluated against the response body; must return truthy to pass.
# Use '.' to accept any valid JSON regardless of content.
check() {
    local label="$1"
    local url="$2"
    local want_code="$3"
    local jq_check="$4"
    local needs_auth="${5:-false}"

    if [[ "$needs_auth" == "true" && -z "$TOKEN" ]]; then
        printf "  %bSKIP%b  %-42s  %b(no auth token — set SOREN_SMOKE_TOKEN or SOREN_SMOKE_USER/PASS)%b\n" \
            "$YELLOW" "$NC" "$label" "$DIM" "$NC"
        (( skip++ )) || true
        # Skipped tests do NOT count as failures — allows monitor.sh to use
        # smoke-test without auth credentials to check unauthenticated endpoints.
        return
    fi

    local t0 t1 elapsed http_code body ok=true

    t0=$(date +%s%3N)

    local -a curl_args=(-s --max-time 10 -o "$TMPBODY" -w "%{http_code}")
    [[ -n "$TOKEN" ]] && curl_args+=(-H "Authorization: Bearer ${TOKEN}")

    http_code=$(curl "${curl_args[@]}" "$url" 2>/dev/null) || http_code="000"
    body=$(cat "$TMPBODY" 2>/dev/null) || body=""

    t1=$(date +%s%3N)
    elapsed=$(( t1 - t0 ))

    # Check HTTP status code
    [[ "$http_code" != "$want_code" ]] && ok=false

    # Check JSON body with jq expression
    if [[ "$ok" == "true" && -n "$jq_check" && -n "$body" ]]; then
        echo "$body" | jq -e "$jq_check" > /dev/null 2>&1 || ok=false
    fi

    if [[ "$ok" == "true" ]]; then
        printf "  %bPASS%b  %-42s  %b%dms%b\n" "$GREEN" "$NC" "$label" "$DIM" "$elapsed" "$NC"
        (( pass++ )) || true
    else
        printf "  %bFAIL%b  %-42s  HTTP %s\n" "$RED" "$NC" "$label" "$http_code"
        # Print truncated response for debugging
        if [[ -n "$body" ]]; then
            printf "         %b%.120s%b\n" "$DIM" "$body" "$NC"
        fi
        (( fail++ )) || true
    fi
}

echo "SOREN Smoke Tests — ${BASE_URL}"
echo "────────────────────────────────────────────────────────────"

# Health: check .api == "healthy" (consistent with monitor.sh logic; .status
# can be "degraded" with a 503 when the frontend build is absent, but .api
# remains "healthy" as long as the API process itself is responsive).
check "GET /api/webhooks/health"   "${BASE_URL}/api/webhooks/health"   200  '.api == "healthy"'      false

# Agent list: protected, must return an agents array
check "GET /api/agents"            "${BASE_URL}/api/agents"            200  'has("agents")'          true

# Budget status: protected, must return daily_spend_usd key
check "GET /api/budget/status"     "${BASE_URL}/api/budget/status"     200  'has("daily_spend_usd")' true

# Journal today: auth-exempt (/api/journal prefix is in AUTH_EXEMPT_PREFIXES);
# no date param returns today's journal. Accept any valid JSON response.
check "GET /api/journal (today)"   "${BASE_URL}/api/journal"           200  '.'                      false

echo "────────────────────────────────────────────────────────────"
printf "  %d passed  %d failed  %d skipped\n" "$pass" "$fail" "$skip"
echo ""

[[ $fail -eq 0 ]]
