#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════════════
# schedule - Self-scheduling check-ins for supervisor agents
#
# Schedule future reminders that get injected into the supervisor's prompt
# via the autonomy-check/heartbeat system. Based on the tmux-orchestrator
# schedule_with_note pattern.
#
# Usage:
#   schedule add <seconds> "<note>"    Schedule a check-in N seconds from now
#   schedule add-at <HH:MM> "<note>"   Schedule at a specific time today
#   schedule list                      List pending check-ins
#   schedule fire                      Check for due items and output them
#   schedule clear [id]                Clear one or all check-ins
#   schedule help                      Show this help
#
# The "fire" command is called by tools/autonomy-check during heartbeat scans.
# Due items are returned as text (one note per line).
#
# Storage: the `schedule` table in the consolidated SQLite DB (.soren/soren.db).
# Firing is a single atomic UPDATE ... RETURNING, which kills the legacy
# fire-vs-add race (the old JSON file was read, filtered, and rewritten
# wholesale — an `add` between the read and the rewrite was silently lost).
# Fired rows keep their fired_at stamp so an item can never fire twice; the
# legacy .soren/schedule.json is imported once, lazily, then renamed
# schedule.json.migrated.
#═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

SOREN_PROJECT_ROOT="${SOREN_HOME:-${SOREN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}"
SCHEDULE_FILE="${SOREN_PROJECT_ROOT}/.soren/schedule.json"

# Shared DB helpers (SOREN_DB_PATH resolution + soren_db wrapper)
source "${SOREN_PROJECT_ROOT}/tools/lib/db.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# Escape a value for embedding in a single-quoted SQL literal.
sql_q() { printf '%s' "$1" | sed "s/'/''/g"; }

#───────────────────────────────────────────────────────────────────────────────
# State init — schema + one-time lazy import of the legacy JSON file
#───────────────────────────────────────────────────────────────────────────────

_sched_ensure_schema() {
    soren_db "CREATE TABLE IF NOT EXISTS schedule (
        id         TEXT PRIMARY KEY,
        note       TEXT,
        due_at     TEXT,
        created_at TEXT,
        fired_at   TEXT
    );" 2>/dev/null || true
}

# One-time lazy import of the legacy schedule.json ([{id, note, due_at,
# created_at}] with epoch-second timestamps). mv is the atomic claim: exactly
# one concurrent invocation imports; the file ends up renamed *.migrated so
# this never runs twice.
_sched_import_legacy() {
    [[ -f "$SCHEDULE_FILE" ]] || return 0
    local claim="${SCHEDULE_FILE}.importing.$$"
    mv "$SCHEDULE_FILE" "$claim" 2>/dev/null || return 0
    local prog sql
    prog=$(cat <<'JQEOF'
def q: "'" + ((. // "") | tostring | gsub("'"; "''")) + "'";
.[]?
| "INSERT OR IGNORE INTO schedule (id, note, due_at, created_at, fired_at) VALUES ("
  + (.id | q) + ", " + (.note | q) + ", " + (.due_at | q) + ", "
  + (.created_at | q) + ", NULL);"
JQEOF
)
    if sql=$(jq -r "$prog" "$claim" 2>/dev/null) && [[ -n "$sql" ]]; then
        printf 'BEGIN IMMEDIATE;\n%s\nCOMMIT;\n' "$sql" | soren_db 2>/dev/null || true
    fi
    if [[ -e "${SCHEDULE_FILE}.migrated" ]]; then
        mv "$claim" "${SCHEDULE_FILE}.migrated.$(date +%s).$$" 2>/dev/null || true
    else
        mv "$claim" "${SCHEDULE_FILE}.migrated" 2>/dev/null || true
    fi
}

init_state() {
    _sched_ensure_schema
    _sched_import_legacy
}

#───────────────────────────────────────────────────────────────────────────────
# Add a check-in N seconds from now
#───────────────────────────────────────────────────────────────────────────────

cmd_add() {
    local seconds="${1:-}"
    local note="${2:-}"

    if [[ -z "$seconds" ]] || [[ -z "$note" ]]; then
        echo -e "${RED}error:${NC} usage: schedule add <seconds> \"<note>\""
        exit 1
    fi

    if ! [[ "$seconds" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}error:${NC} seconds must be a number"
        exit 1
    fi

    local now due_at id
    now=$(date +%s)
    due_at=$((now + seconds))

    local due_human
    if [[ "$(uname)" == "Darwin" ]]; then
        due_human=$(date -r "$due_at" '+%H:%M:%S')
    else
        due_human=$(date -d "@$due_at" '+%H:%M:%S')
    fi

    # Insert with a random id; retry on the (unlikely) collision
    local attempt=0 inserted="0"
    while (( attempt < 5 )); do
        id="s_$(printf '%08x' $(( (RANDOM * 32768 + RANDOM) % 4294967296 )))"
        inserted=$(soren_db "INSERT OR IGNORE INTO schedule (id, note, due_at, created_at, fired_at)
            VALUES ('$(sql_q "$id")', '$(sql_q "$note")', '$due_at', '$now', NULL);
            SELECT changes();")
        [[ "$inserted" == "1" ]] && break
        attempt=$((attempt + 1))
    done
    if [[ "$inserted" != "1" ]]; then
        echo -e "${RED}error:${NC} could not insert scheduled item"
        exit 1
    fi

    local mins=$((seconds / 60))
    local secs=$((seconds % 60))
    local time_str=""
    ((mins > 0)) && time_str="${mins}m"
    ((secs > 0 || mins == 0)) && time_str="${time_str}${secs}s"

    echo -e "${GREEN}✓${NC} Scheduled ${BOLD}${id}${NC} in ${time_str} (at ${due_human}): ${note}"
}

#───────────────────────────────────────────────────────────────────────────────
# Add a check-in at a specific time today
#───────────────────────────────────────────────────────────────────────────────

cmd_add_at() {
    local time_str="${1:-}"
    local note="${2:-}"

    if [[ -z "$time_str" ]] || [[ -z "$note" ]]; then
        echo -e "${RED}error:${NC} usage: schedule add-at <HH:MM> \"<note>\""
        exit 1
    fi

    # Parse HH:MM
    local target_epoch
    if [[ "$(uname)" == "Darwin" ]]; then
        target_epoch=$(date -j -f '%H:%M' "$time_str" '+%s' 2>/dev/null || echo "")
    else
        target_epoch=$(date -d "today $time_str" '+%s' 2>/dev/null || echo "")
    fi

    if [[ -z "$target_epoch" ]]; then
        echo -e "${RED}error:${NC} invalid time format (use HH:MM)"
        exit 1
    fi

    local now
    now=$(date +%s)
    if ((target_epoch <= now)); then
        echo -e "${YELLOW}warning:${NC} time $time_str is in the past, scheduling for tomorrow"
        target_epoch=$((target_epoch + 86400))
    fi

    local seconds=$((target_epoch - now))
    cmd_add "$seconds" "$note"
}

#───────────────────────────────────────────────────────────────────────────────
# List pending check-ins
#───────────────────────────────────────────────────────────────────────────────

cmd_list() {
    local count
    count=$(soren_db "SELECT COUNT(*) FROM schedule WHERE fired_at IS NULL;")

    if ((count == 0)); then
        echo -e "${DIM}No scheduled check-ins${NC}"
        return
    fi

    local now
    now=$(date +%s)

    echo -e "${BOLD}Scheduled check-ins:${NC}\n"
    printf "${DIM}%-12s  %-10s  %-s${NC}\n" "ID" "DUE IN" "NOTE"
    printf "${DIM}%-12s  %-10s  %-s${NC}\n" "────────────" "──────────" "────────────────────────────────"

    soren_db -separator $'\t' "SELECT id, CAST(due_at AS INTEGER) - $now, note
        FROM schedule WHERE fired_at IS NULL ORDER BY rowid;" | \
    while IFS=$'\t' read -r id remaining note; do
        if ((remaining <= 0)); then
            printf "  ${RED}%-12s${NC}  ${RED}%-10s${NC}  %s\n" "$id" "OVERDUE" "$note"
        else
            local mins=$((remaining / 60))
            local secs=$((remaining % 60))
            local time_display=""
            if ((mins >= 60)); then
                local hrs=$((mins / 60))
                mins=$((mins % 60))
                time_display="${hrs}h${mins}m"
            elif ((mins > 0)); then
                time_display="${mins}m${secs}s"
            else
                time_display="${secs}s"
            fi
            printf "  ${CYAN}%-12s${NC}  ${BOLD}%-10s${NC}  %s\n" "$id" "$time_display" "$note"
        fi
    done

    echo -e "\n${DIM}${count} item(s)${NC}"
}

#───────────────────────────────────────────────────────────────────────────────
# Fire due check-ins — called by autonomy-check
# A single atomic UPDATE ... RETURNING claims due items exactly once (two
# concurrent fires cannot both claim the same item; adds concurrent with a
# fire are never lost). Output: the due notes, one per line.
#───────────────────────────────────────────────────────────────────────────────

cmd_fire() {
    local now
    now=$(date +%s)

    local fired
    fired=$(soren_db -separator $'\t' "UPDATE schedule SET fired_at = '$now'
        WHERE CAST(due_at AS INTEGER) <= $now AND fired_at IS NULL
        RETURNING id, note;" 2>/dev/null) || fired=""

    if [[ -z "$fired" ]]; then
        return 1  # nothing due
    fi

    # Output due notes (autonomy-check consumes raw stdout, one note per line)
    printf '%s\n' "$fired" | cut -f2-

    # Opportunistic pruning: drop fired rows older than 7 days
    soren_db "DELETE FROM schedule WHERE fired_at IS NOT NULL
        AND CAST(fired_at AS INTEGER) < $((now - 604800));" 2>/dev/null || true

    return 0
}

#───────────────────────────────────────────────────────────────────────────────
# Clear check-ins
#───────────────────────────────────────────────────────────────────────────────

cmd_clear() {
    local target_id="${1:-}"

    if [[ -z "$target_id" ]]; then
        soren_db "DELETE FROM schedule;"
        echo -e "${GREEN}✓${NC} Cleared all scheduled check-ins"
    else
        local deleted
        deleted=$(soren_db "DELETE FROM schedule WHERE id = '$(sql_q "$target_id")'; SELECT changes();")
        if [[ "$deleted" == "0" ]]; then
            echo -e "${RED}error:${NC} check-in $target_id not found"
            exit 1
        fi
        echo -e "${GREEN}✓${NC} Cleared $target_id"
    fi
}

#───────────────────────────────────────────────────────────────────────────────
# Help
#───────────────────────────────────────────────────────────────────────────────

cmd_help() {
    cat << 'EOF'
schedule - Self-scheduling check-ins for supervisor agents

USAGE:
    schedule add <seconds> "<note>"    Schedule a check-in N seconds from now
    schedule add-at <HH:MM> "<note>"   Schedule at a specific time today
    schedule list                      List pending check-ins
    schedule fire                      Check for due items (used by autonomy-check)
    schedule clear [id]                Clear one or all check-ins
    schedule help                      Show this help

EXAMPLES:
    schedule add 300 "Check if worker-X finished the auth refactor"
    schedule add 1800 "Review sup-todo-backend's test results"
    schedule add-at 14:00 "Run full test suite before EOD"
    schedule list
    schedule fire          # Called automatically by heartbeat
    schedule clear s_abc123

INTEGRATION:
    The heartbeat system (tools/autonomy-check) calls "schedule fire" on each
    scan cycle. Due items are injected into the supervisor's prompt as
    scheduled reminders. Firing is exactly-once (atomic UPDATE ... RETURNING
    in the consolidated SQLite DB).

STORAGE:
    The `schedule` table in .soren/soren.db (override with SOREN_DB). The
    legacy .soren/schedule.json is imported once and renamed *.migrated.
EOF
}

#───────────────────────────────────────────────────────────────────────────────
# Main dispatch
#───────────────────────────────────────────────────────────────────────────────

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    add)     init_state; cmd_add "$@" ;;
    add-at)  init_state; cmd_add_at "$@" ;;
    list)    init_state; cmd_list "$@" ;;
    fire)    init_state; cmd_fire "$@" ;;
    clear)   init_state; cmd_clear "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        echo -e "${RED}error:${NC} unknown command: $cmd (try 'schedule help')"
        exit 1
        ;;
esac
