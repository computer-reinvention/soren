#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════════════
# system-verify - Validate all SOREN infrastructure exists and works
#
# Usage: system-verify
#
# Checks hooks, daemons, health endpoint, critical files, and tmux session.
# Exits 0 if all pass, 1 if any fail.
#═══════════════════════════════════════════════════════════════════════════════

set -uo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
SOREN_SESSION="${SOREN_SESSION:-soren}"
SOREN_PORT="${SOREN_PORT:-8000}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

passed=0
failed=0

pass() { echo -e "  ${GREEN}✓${NC} $1"; ((passed++)); }
fail() { echo -e "  ${RED}✗${NC} $1"; ((failed++)); }
section() { echo -e "\n${BOLD}$1${NC}"; }

#───────────────────────────────────────────────────────────────────────────────
# 1. OPENCODE BRIDGE — verify the plugin, hook scripts, and opencode binary
#───────────────────────────────────────────────────────────────────────────────
section "Opencode bridge"

bridge_plugin="${SOREN_HOME}/.opencode/plugins/soren-bridge.ts"
if [[ -f "$bridge_plugin" ]]; then
    pass "plugin: soren-bridge.ts"
else
    fail "plugin missing: $bridge_plugin"
fi

for hook in verify-done.sh verify-ui-check.sh pre-compact.sh; do
    hook_path="${SOREN_HOME}/.opencode/hooks/${hook}"
    if [[ ! -f "$hook_path" ]]; then
        fail "hook missing: $hook ($hook_path)"
    elif [[ ! -x "$hook_path" ]]; then
        fail "hook not executable: $hook"
    else
        pass "hook: $hook"
    fi
done

if command -v opencode >/dev/null 2>&1; then
    pass "opencode binary on PATH"
else
    fail "opencode binary not found on PATH"
fi

#───────────────────────────────────────────────────────────────────────────────
# 2. DAEMONS — check background processes are running
#───────────────────────────────────────────────────────────────────────────────
section "Daemons"

# Check for monitor window in tmux (runs router, compact, journal-nudge)
if tmux list-windows -t "$SOREN_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "monitor"; then
    pass "monitor window exists"
else
    fail "monitor window missing from tmux session"
fi

# Check daemon processes by looking for running scripts
for daemon in router.sh journal-nudge.sh compact.sh; do
    if pgrep -f "$daemon" > /dev/null 2>&1; then
        pass "daemon running: $daemon"
    else
        fail "daemon not running: $daemon"
    fi
done

#───────────────────────────────────────────────────────────────────────────────
# 3. HEALTH — verify API server responds correctly
#───────────────────────────────────────────────────────────────────────────────
section "Health"

health_url="http://localhost:${SOREN_PORT}/api/webhooks/health"
health_response=$(curl -sf --max-time 3 "$health_url" 2>/dev/null) || health_response=""

if [[ -z "$health_response" ]]; then
    fail "health endpoint unreachable: $health_url"
else
    pass "health endpoint responds"

    # Check for api:healthy in response
    api_status=$(echo "$health_response" | jq -r '.api // empty' 2>/dev/null)
    if [[ "$api_status" == "healthy" ]]; then
        pass "API status: healthy"
    else
        fail "API status: ${api_status:-unknown} (expected 'healthy')"
    fi

    # Check overall status field
    overall=$(echo "$health_response" | jq -r '.status // empty' 2>/dev/null)
    if [[ "$overall" == "healthy" ]]; then
        pass "overall status: healthy"
    else
        fail "overall status: ${overall:-missing} (expected 'healthy')"
    fi
fi

#───────────────────────────────────────────────────────────────────────────────
# 4. FILES — verify critical files exist
#───────────────────────────────────────────────────────────────────────────────
section "Critical Files"

for f in \
    .soren/mailbox \
    .soren/soren.db \
    .soren/agent_registry.json \
    .soren/projects.json \
    tools/workers \
    tools/backlog \
    tools/journal \
    tools/mailbox \
    tools/teams; do

    full_path="${SOREN_HOME}/${f}"
    if [[ -e "$full_path" ]]; then
        pass "$f"
    else
        fail "$f missing"
    fi
done

#───────────────────────────────────────────────────────────────────────────────
# 5. TMUX — verify session and supervisor window
#───────────────────────────────────────────────────────────────────────────────
section "Tmux Session"

if tmux has-session -t "$SOREN_SESSION" 2>/dev/null; then
    pass "tmux session '$SOREN_SESSION' exists"
else
    fail "tmux session '$SOREN_SESSION' not found"
fi

if tmux list-windows -t "$SOREN_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "supervisor"; then
    pass "supervisor window exists"
else
    fail "supervisor window missing"
fi

# Count total windows
window_count=$(tmux list-windows -t "$SOREN_SESSION" 2>/dev/null | wc -l | tr -d ' ')
if [[ -n "$window_count" ]]; then
    pass "total tmux windows: $window_count"
fi

#───────────────────────────────────────────────────────────────────────────────
# 6. CONTEXT FRESHNESS — check for stale/orphaned worker context files
#───────────────────────────────────────────────────────────────────────────────
section "Context Freshness"

freshness_tool="${SOREN_HOME}/tools/check-context-freshness"
if [[ -x "$freshness_tool" ]]; then
    freshness_json=$("$freshness_tool" --json 2>/dev/null) || freshness_json=""
    if [[ -n "$freshness_json" ]]; then
        ctx_stale=$(echo "$freshness_json" | jq -r '.stale // 0' 2>/dev/null)
        ctx_orphaned=$(echo "$freshness_json" | jq -r '.orphaned // 0' 2>/dev/null)
        ctx_fresh=$(echo "$freshness_json" | jq -r '.fresh // 0' 2>/dev/null)
        ctx_total=$(echo "$freshness_json" | jq -r '.total // 0' 2>/dev/null)

        if (( ctx_stale == 0 )); then
            pass "all $ctx_total context files fresh"
        else
            # List stale agents
            stale_agents=$(echo "$freshness_json" | jq -r '.entries[] | select(.status=="STALE") | .agent' 2>/dev/null | tr '\n' ', ' | sed 's/,$//')
            fail "$ctx_stale stale context(s): $stale_agents"
        fi

        if (( ctx_orphaned > 0 )); then
            orphan_agents=$(echo "$freshness_json" | jq -r '.entries[] | select(.status=="ORPHANED") | .agent' 2>/dev/null | tr '\n' ', ' | sed 's/,$//')
            echo -e "  ${YELLOW}⚠${NC} $ctx_orphaned orphaned context(s): $orphan_agents"
        fi
    else
        fail "check-context-freshness returned no output"
    fi
else
    echo -e "  ${DIM}-${NC} check-context-freshness not found (skipped)"
fi

#───────────────────────────────────────────────────────────────────────────────
# 7. CODE HEALTH — scan for unused imports, dead routes, orphaned contexts
#───────────────────────────────────────────────────────────────────────────────
section "Code Health"

health_tool="${SOREN_HOME}/tools/code-health"
if [[ -x "$health_tool" ]]; then
    health_json=$("$health_tool" --json 2>/dev/null) || health_json=""
    if [[ -n "$health_json" ]]; then
        health_issues=$(echo "$health_json" | jq -r '.issues // 0' 2>/dev/null)
        unused=$(echo "$health_json" | jq -r '.unused_imports // 0' 2>/dev/null)
        dead=$(echo "$health_json" | jq -r '.dead_routes // 0' 2>/dev/null)
        orphaned=$(echo "$health_json" | jq -r '.orphaned_contexts // 0' 2>/dev/null)

        if (( health_issues == 0 )); then
            pass "code health clean"
        else
            details=""
            (( unused > 0 )) && details="${details}${unused} unused imports, "
            (( dead > 0 )) && details="${details}${dead} dead routes, "
            (( orphaned > 0 )) && details="${details}${orphaned} orphaned contexts, "
            details="${details%, }"
            fail "code health: ${health_issues} issue(s) — ${details}"
        fi

        # Show TODO/FIXME/HACK as info (not a pass/fail)
        todo=$(echo "$health_json" | jq -r '.todo // 0' 2>/dev/null)
        fixme=$(echo "$health_json" | jq -r '.fixme // 0' 2>/dev/null)
        hack=$(echo "$health_json" | jq -r '.hack // 0' 2>/dev/null)
        comment_total=$((todo + fixme + hack))
        if (( comment_total > 0 )); then
            echo -e "  ${DIM}-${NC} comment markers: ${todo} TODO, ${fixme} FIXME, ${hack} HACK"
        fi
    else
        fail "code-health returned no output"
    fi
else
    echo -e "  ${DIM}-${NC} code-health not found (skipped)"
fi

#───────────────────────────────────────────────────────────────────────────────
# 8. LESSON FRESHNESS — check for stale accumulated knowledge entries
#───────────────────────────────────────────────────────────────────────────────
section "Lesson Freshness"

prune_tool="${SOREN_HOME}/tools/prune-lessons"
if [[ -x "$prune_tool" ]]; then
    prune_json=$("$prune_tool" --json 2>/dev/null) || prune_json=""
    if [[ -n "$prune_json" ]]; then
        prune_stale=$(echo "$prune_json" | jq -r '.pruned // 0' 2>/dev/null)
        prune_total=$(echo "$prune_json" | jq -r '.total_lessons // 0' 2>/dev/null)
        prune_workers=$(echo "$prune_json" | jq -r '.workers // 0' 2>/dev/null)

        if (( prune_stale == 0 )); then
            pass "all $prune_total lessons fresh across $prune_workers workers"
        else
            fail "$prune_stale stale lesson(s) — run 'tools/prune-lessons --apply' to clean"
        fi
    else
        fail "prune-lessons returned no output"
    fi
else
    echo -e "  ${DIM}-${NC} prune-lessons not found (skipped)"
fi

#───────────────────────────────────────────────────────────────────────────────
# 9. ROLE CONTRACTS — validate permanent-team contract frontmatter
#───────────────────────────────────────────────────────────────────────────────
section "Role Contracts"

contract_tool="${SOREN_HOME}/tools/contract"
if [[ -x "$contract_tool" ]]; then
    if contract_out=$("$contract_tool" validate all 2>&1); then
        pass "role contract frontmatter valid (tools/contract validate all)"
    else
        # Non-fatal: warn but don't fail the verification run.
        echo -e "  ${YELLOW}⚠${NC} role contract validation failed — run 'tools/contract validate all' for details"
    fi
else
    echo -e "  ${DIM}-${NC} tools/contract not found (skipped)"
fi

#───────────────────────────────────────────────────────────────────────────────
# Summary
#───────────────────────────────────────────────────────────────────────────────

total=$((passed + failed))
echo ""
if [[ $failed -eq 0 ]]; then
    echo -e "${GREEN}${BOLD}${passed}/${total} checks passed${NC}"
    exit 0
else
    echo -e "${RED}${BOLD}${passed}/${total} checks passed${NC} (${failed} failed)"
    exit 1
fi
