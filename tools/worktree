#!/usr/bin/env bash
#===============================================================================
# worktree - Manage SOREN agent git worktrees
#
# SOREN isolates protected-path and builder work in git worktrees:
#   path:   ~/.soren/worktrees/<project>/<name>
#   branch: feat/<name>   (branched from HEAD of the source repo)
#
# This CLI wraps the conventions that tools/workers spawn --worktree uses,
# for manual/supervisor use. It NEVER touches the live checkout of main.
#
# Usage:
#   worktree list                        - All soren worktrees (branch, state, owner)
#   worktree new <name> [--project <id>] [--repo <path>]
#                                        - Create a worktree per soren convention
#   worktree status <name>               - Detail: dirty files, commits ahead, last commit
#   worktree merge <name>                - Rebase onto main + print PR-flow commands
#   worktree clean <name> [--force]      - Remove worktree + branch (only if merged)
#   worktree clean --merged              - Sweep all fully-merged worktrees
#
# Storage: ~/.soren/worktrees/ (override: SOREN_WORKTREES_DIR)
# Registry: .soren/agent_registry.json (worktree_path / worktree_branch fields)
#===============================================================================

set -euo pipefail

SOREN_HOME="${SOREN_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
WT_ROOT="${SOREN_WORKTREES_DIR:-${HOME}/.soren/worktrees}"
REG_FILE="${SOREN_HOME}/.soren/agent_registry.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }
ok() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }
info() { echo -e "${CYAN}→${NC} $1"; }

#-------------------------------------------------------------------------------
# Helpers
#-------------------------------------------------------------------------------

# Resolve the main repo root that a worktree belongs to.
repo_of() {
    local wt="$1"
    local common
    common=$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null) || return 1
    # May be relative to the worktree
    case "$common" in
        /*) : ;;
        *) common="${wt}/${common}" ;;
    esac
    # common is <repo>/.git — normalize to the repo root
    (cd "$(dirname "$common")" && pwd)
}

# Detect the repo's main branch (main, falling back to master).
main_branch_of() {
    local repo="$1"
    if git -C "$repo" show-ref --verify --quiet refs/heads/main; then
        echo "main"
    elif git -C "$repo" show-ref --verify --quiet refs/heads/master; then
        echo "master"
    else
        return 1
    fi
}

# Branch currently checked out in a worktree.
branch_of() {
    git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null
}

# "dirty" or "clean"
dirtiness_of() {
    if [[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]]; then
        echo "dirty"
    else
        echo "clean"
    fi
}

# "ahead behind" relative to the repo's main branch (space separated).
ahead_behind_of() {
    local wt="$1" main="$2"
    local counts
    counts=$(git -C "$wt" rev-list --left-right --count "${main}...HEAD" 2>/dev/null) || { echo "? ?"; return; }
    # rev-list output: <behind><TAB><ahead> (left=main-only, right=HEAD-only)
    local behind ahead
    behind=$(echo "$counts" | awk '{print $1}')
    ahead=$(echo "$counts" | awk '{print $2}')
    echo "$ahead $behind"
}

# Owning agent per registry (matches worktree_path), or empty.
owner_of() {
    local path="$1"
    [[ -f "$REG_FILE" ]] || return 0
    jq -r --arg p "$path" 'to_entries[] | select(.value.worktree_path == $p) | .key' "$REG_FILE" 2>/dev/null | head -1
}

# Enumerate soren worktree dirs (WT_ROOT/<project>/<name>) — those with a .git file.
all_worktrees() {
    [[ -d "$WT_ROOT" ]] || return 0
    local proj wt
    for proj in "$WT_ROOT"/*/; do
        [[ -d "$proj" ]] || continue
        for wt in "$proj"*/; do
            [[ -e "${wt%/}/.git" ]] || continue
            echo "${wt%/}"
        done
    done
}

# Resolve a name to a single worktree path. Prefers SOREN_PROJECT_ID on ambiguity.
resolve_worktree() {
    local name="$1"
    local matches=""
    local wt
    while IFS= read -r wt; do
        [[ -z "$wt" ]] && continue
        if [[ "$(basename "$wt")" == "$name" ]]; then
            matches="${matches}${wt}
"
        fi
    done <<< "$(all_worktrees)"

    [[ -z "$matches" ]] && die "no soren worktree named '$name' under $WT_ROOT"

    local count
    count=$(printf '%s' "$matches" | grep -c '' || true)
    if [[ "$count" -eq 1 ]]; then
        printf '%s' "$matches" | head -1
        return 0
    fi

    # Ambiguous — prefer the current project's copy
    if [[ -n "${SOREN_PROJECT_ID:-}" ]]; then
        local preferred="${WT_ROOT}/${SOREN_PROJECT_ID}/${name}"
        if printf '%s' "$matches" | grep -qx "$preferred"; then
            echo "$preferred"
            return 0
        fi
    fi
    echo -e "${RED}error:${NC} '$name' matches multiple worktrees:" >&2
    printf '%s' "$matches" | sed 's/^/  /' >&2
    exit 1
}

#-------------------------------------------------------------------------------
# Commands
#-------------------------------------------------------------------------------

cmd_list() {
    local found=false
    local wt
    printf "${BOLD}%-24s %-24s %-8s %-6s %-13s %s${NC}\n" \
        "NAME" "BRANCH" "STATE" "PROJ" "AHEAD/BEHIND" "AGENT"
    echo -e "${DIM}────────────────────────────────────────────────────────────────────────────────────────${NC}"
    while IFS= read -r wt; do
        [[ -z "$wt" ]] && continue
        found=true
        local name proj branch state repo main ab ahead behind owner
        name=$(basename "$wt")
        proj=$(basename "$(dirname "$wt")")
        branch=$(branch_of "$wt" || echo "?")
        state=$(dirtiness_of "$wt")
        repo=$(repo_of "$wt" || echo "")
        main=""
        [[ -n "$repo" ]] && main=$(main_branch_of "$repo" || true)
        if [[ -n "$main" ]]; then
            ab=$(ahead_behind_of "$wt" "$main")
            ahead=$(echo "$ab" | awk '{print $1}')
            behind=$(echo "$ab" | awk '{print $2}')
            ab="+${ahead}/-${behind} ${main}"
        else
            ab="?"
        fi
        owner=$(owner_of "$wt" || true)
        local state_col
        if [[ "$state" == "dirty" ]]; then
            state_col="${YELLOW}dirty${NC}"
        else
            state_col="${GREEN}clean${NC}"
        fi
        printf "%-24s %-24s %-19b %-6s %-13s %b\n" \
            "$name" "$branch" "$state_col" "$proj" "$ab" "${owner:-${DIM}-${NC}}"
    done <<< "$(all_worktrees)"
    if [[ "$found" == false ]]; then
        echo -e "${DIM}No soren worktrees under ${WT_ROOT}${NC}"
    fi
}

cmd_new() {
    local name="${1:-}"
    [[ -z "$name" ]] && die "usage: worktree new <name> [--project <id>] [--repo <path>]"
    shift
    [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid worktree name: '$name' (use [a-zA-Z0-9_-])"

    local project="" repo=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project) project="${2:-}"; shift 2 ;;
            --repo)    repo="${2:-}";    shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done

    # Soren convention (mirrors tools/workers spawn --worktree):
    #   project: --project > SOREN_PROJECT_ID > "soren"
    #   branch:  feat/<name>, from HEAD of the source repo
    project="${project:-${SOREN_PROJECT_ID:-soren}}"
    local branch="feat/${name}"
    local path="${WT_ROOT}/${project}/${name}"

    [[ -e "$path" ]] && die "worktree already exists: $path"

    # Source repo: --repo > projects.json entry > CWD's git root
    if [[ -z "$repo" ]]; then
        local proj_file="${SOREN_HOME}/.soren/projects.json"
        if [[ "$project" != "soren" && -f "$proj_file" ]]; then
            repo=$(jq -r --arg pid "$project" '.projects[] | select(.id == $pid) | .path // empty' "$proj_file" 2>/dev/null) || true
        fi
    fi
    if [[ -z "$repo" ]]; then
        repo="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo and no --repo given"
    fi
    [[ -d "$repo/.git" ]] || die "not a git repo: $repo"

    info "Creating worktree at $path on branch $branch (from $(basename "$repo") HEAD)"
    mkdir -p "$(dirname "$path")"
    if git -C "$repo" show-ref --verify --quiet "refs/heads/${branch}"; then
        warn "branch $branch already exists — attaching worktree to it"
        git -C "$repo" worktree add "$path" "$branch"
    else
        git -C "$repo" worktree add -b "$branch" "$path" HEAD
    fi
    ok "Worktree created: $path"
    echo -e "${DIM}Branched from $(git -C "$path" log -1 --oneline HEAD~0 2>/dev/null | head -1)${NC}" || true
    echo -e "${DIM}Spawn a jailed worker there with: ./tools/workers spawn ${name} \"<task>\" --worktree${NC}"
}

cmd_status() {
    local name="${1:-}"
    [[ -z "$name" ]] && die "usage: worktree status <name>"
    local wt repo main branch
    wt=$(resolve_worktree "$name")
    repo=$(repo_of "$wt") || die "cannot resolve parent repo for $wt"
    main=$(main_branch_of "$repo") || die "no main/master branch in $repo"
    branch=$(branch_of "$wt")

    echo -e "${BOLD}Worktree: ${name}${NC}"
    echo -e "  Path:    $wt"
    echo -e "  Repo:    $repo"
    echo -e "  Branch:  $branch"
    local owner
    owner=$(owner_of "$wt" || true)
    echo -e "  Agent:   ${owner:-none (not in registry)}"

    local ab ahead behind
    ab=$(ahead_behind_of "$wt" "$main")
    ahead=$(echo "$ab" | awk '{print $1}')
    behind=$(echo "$ab" | awk '{print $2}')
    echo -e "  vs ${main}: ${ahead} ahead, ${behind} behind"

    echo ""
    echo -e "${BOLD}Last commit:${NC}"
    git -C "$wt" log -1 --format="  %h %ad %an%n  %s" --date=format:'%Y-%m-%d %H:%M' 2>/dev/null || echo "  (none)"

    echo ""
    local dirty
    dirty=$(git -C "$wt" status --porcelain 2>/dev/null || true)
    if [[ -n "$dirty" ]]; then
        echo -e "${YELLOW}Uncommitted changes:${NC}"
        echo "$dirty" | sed 's/^/  /'
    else
        echo -e "${GREEN}Working tree clean${NC}"
    fi

    if [[ "$ahead" != "0" && "$ahead" != "?" ]]; then
        echo ""
        echo -e "${BOLD}Commits ahead of ${main}:${NC}"
        git -C "$wt" log --oneline "${main}..HEAD" | sed 's/^/  /'
    fi
}

cmd_merge() {
    local name="${1:-}"
    [[ -z "$name" ]] && die "usage: worktree merge <name>"
    local wt repo main branch
    wt=$(resolve_worktree "$name")
    repo=$(repo_of "$wt") || die "cannot resolve parent repo for $wt"
    main=$(main_branch_of "$repo") || die "no main/master branch in $repo"
    branch=$(branch_of "$wt")

    # 1. Must be clean — refuse to rebase over uncommitted work
    if [[ "$(dirtiness_of "$wt")" == "dirty" ]]; then
        git -C "$wt" status --short | sed 's/^/  /'
        die "worktree '$name' has uncommitted changes — commit or stash them first"
    fi

    # 2. Rebase the worktree branch onto main (runs inside the worktree —
    #    main's live checkout is never touched)
    local ab ahead behind
    ab=$(ahead_behind_of "$wt" "$main")
    ahead=$(echo "$ab" | awk '{print $1}')
    behind=$(echo "$ab" | awk '{print $2}')
    if [[ "$ahead" == "0" ]]; then
        warn "branch $branch has no commits ahead of $main — nothing to merge"
        return 0
    fi
    if [[ "$behind" != "0" ]]; then
        info "Rebasing $branch onto $main ($behind commit(s) behind)..."
        local rebase_out
        if ! rebase_out=$(git -C "$wt" rebase "$main" 2>&1); then
            git -C "$wt" rebase --abort 2>/dev/null || true
            echo "$rebase_out" | tail -15 | sed 's/^/  /'
            die "rebase onto $main hit conflicts (aborted, branch untouched) — resolve manually: cd $wt && git rebase $main"
        fi
        ok "Rebased $branch onto $main"
    else
        ok "$branch is already based on the tip of $main"
    fi

    # 3. Instruct — never merge to main here. Agents must not checkout main
    #    in the live checkout; integration goes through a PR.
    echo ""
    echo -e "${BOLD}Ready to merge (${ahead} commit(s)). Do NOT switch the live checkout to ${main}.${NC}"
    echo -e "Use the PR flow:"
    echo ""
    echo -e "  git -C $wt push -u origin $branch"
    echo -e "  gh pr create --head $branch --base $main --title \"$(git -C "$wt" log -1 --format=%s)\" --fill"
    echo ""
    echo -e "${DIM}After the PR merges: ./tools/worktree clean $name${NC}"
}

# Core removal logic shared by clean <name> and clean --merged.
# $1=worktree path, $2=force(true/false). Returns non-zero if refused.
do_clean() {
    local wt="$1" force="$2"
    local name repo main branch
    name=$(basename "$wt")
    repo=$(repo_of "$wt") || { warn "$name: cannot resolve parent repo — skipping"; return 1; }
    main=$(main_branch_of "$repo") || { warn "$name: no main/master in $repo — skipping"; return 1; }
    branch=$(branch_of "$wt")

    if [[ "$(dirtiness_of "$wt")" == "dirty" && "$force" != "true" ]]; then
        warn "$name: uncommitted changes — refusing (use --force to discard)"
        return 1
    fi

    # Merged check: the branch must be fully contained in main
    if ! git -C "$repo" branch --merged "$main" | sed 's/^[*+ ]*//' | grep -qx "$branch"; then
        if [[ "$force" != "true" ]]; then
            warn "$name: branch $branch is NOT merged into $main — refusing (use --force to discard work)"
            return 1
        fi
        warn "$name: branch $branch not merged into $main — removing anyway (--force)"
    fi

    info "Removing worktree $wt"
    if [[ "$force" == "true" ]]; then
        git -C "$repo" worktree remove --force "$wt"
        git -C "$repo" branch -D "$branch"
    else
        git -C "$repo" worktree remove "$wt"
        git -C "$repo" branch -d "$branch"
    fi
    # Tidy the empty project dir
    rmdir "$(dirname "$wt")" 2>/dev/null || true
    ok "Removed worktree + branch $branch"
}

cmd_clean() {
    local target="${1:-}"
    [[ -z "$target" ]] && die "usage: worktree clean <name> [--force] | worktree clean --merged"
    shift || true

    local force=false
    local arg
    for arg in "$@"; do
        [[ "$arg" == "--force" ]] && force=true
    done

    if [[ "$target" == "--merged" ]]; then
        # Sweep: remove every clean + fully-merged worktree (never forced)
        local wt removed=0 skipped=0
        while IFS= read -r wt; do
            [[ -z "$wt" ]] && continue
            if do_clean "$wt" false; then
                removed=$((removed + 1))
            else
                skipped=$((skipped + 1))
            fi
        done <<< "$(all_worktrees)"
        echo ""
        ok "Sweep complete: ${removed} removed, ${skipped} kept"
        return 0
    fi

    local wt
    wt=$(resolve_worktree "$target")
    do_clean "$wt" "$force" || exit 1
}

cmd_help() {
    cat << 'EOF'
worktree - Manage SOREN agent git worktrees

USAGE:
    worktree <command> [arguments]

COMMANDS:
    list                          List all soren worktrees: branch, dirty/clean,
                                  ahead/behind main, owning agent (from registry)
    new <name> [--project <id>] [--repo <path>]
                                  Create ~/.soren/worktrees/<project>/<name> on
                                  branch feat/<name> from the source repo's HEAD.
                                  Refuses if the worktree already exists.
    status <name>                 Detail: uncommitted files, commits ahead of
                                  main, last commit
    merge <name>                  Squash-safe merge helper: verifies clean,
                                  rebases onto main (or reports conflicts), then
                                  prints the PR-flow commands. Never merges to
                                  main directly and never touches main's checkout.
    clean <name> [--force]        Remove worktree + branch — only if fully merged
                                  into main and clean; --force overrides both
    clean --merged                Sweep: remove ALL clean, fully-merged worktrees
    help                          Show this help

CONVENTIONS (shared with tools/workers spawn --worktree):
    Path:    ~/.soren/worktrees/<project>/<name>
    Branch:  feat/<name>, branched from the source repo's HEAD (which may be a
             supervisor integration branch, not main)
    Jail:    workers spawned with --worktree get SOREN_WORKTREE set; the
             soren-bridge plugin blocks their writes to the live checkout
    Kill:    tools/workers kill deliberately PRESERVES worktrees — clean them
             here after the branch is merged

ENVIRONMENT:
    SOREN_HOME            Soren root (default: git rev-parse --show-toplevel)
    SOREN_WORKTREES_DIR   Worktrees root (default: ~/.soren/worktrees)
    SOREN_PROJECT_ID      Default project id for new/name resolution

EXAMPLES:
    worktree list
    worktree new payment-fix
    worktree new api-hardening --project webapp
    worktree status payment-fix
    worktree merge payment-fix
    worktree clean payment-fix
    worktree clean --merged
EOF
}

#-------------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------------

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        list)   cmd_list "$@" ;;
        new)    cmd_new "$@" ;;
        status) cmd_status "$@" ;;
        merge)  cmd_merge "$@" ;;
        clean)  cmd_clean "$@" ;;
        help|--help|-h) cmd_help ;;
        *)      die "unknown command: $cmd (try 'worktree help')" ;;
    esac
}

main "$@"
