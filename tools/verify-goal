#!/usr/bin/env bash
# tools/verify-goal — Verify AMBITION goals are actually working in production
# Usage: ./tools/verify-goal [--version N] [--json] [--save]
#
# Flags:
#   --version N   Only check goals from version N
#   --json        Machine-readable JSON output
#   --save        Save JSON to journal artifacts
#
# Exit codes: 0 = all verified, 1 = any stale, 2 = only unverifiable

set -euo pipefail
cd "$(dirname "$0")/.."

SOREN_PORT="${SOREN_PORT:-8000}"
BASE_URL="http://localhost:${SOREN_PORT}"
AMBITION=".soren/AMBITION.md"
VERSION_FILTER=""
JSON_OUT=false
SAVE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --version) VERSION_FILTER="$2"; shift 2 ;;
        --json)    JSON_OUT=true; shift ;;
        --save)    SAVE=true; JSON_OUT=true; shift ;;
        -h|--help)
            echo "Usage: tools/verify-goal [--version N] [--json] [--save]"
            echo "  --version N   Only check goals from version N"
            echo "  --json        Machine-readable JSON output"
            echo "  --save        Save JSON to journal artifacts"
            exit 0 ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
    esac
done

# Terminal colours
if [[ -t 1 && "$JSON_OUT" == "false" ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
    DIM='\033[2m'; BOLD='\033[1m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; DIM=''; BOLD=''; NC=''
fi

# --- Check functions ---
check_commit() {
    git show --quiet "$1" &>/dev/null && echo "OK" || echo "MISSING"
}
check_endpoint() {
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "${BASE_URL}$1" 2>/dev/null || echo '000')
    if [[ "$code" == '000' ]]; then echo 'UNREACHABLE'
    elif (( code >= 500 )); then echo '5XX'
    elif [[ "$code" == '405' || "$code" == '422' ]]; then
        # Might be POST-only — try POST with empty body
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 -X POST -H 'Content-Type: application/json' -d '{}' "${BASE_URL}$1" 2>/dev/null || echo '000')
        if (( code >= 500 )); then echo '5XX'
        else echo 'OK'; fi
    else echo 'OK'; fi
}
check_tool() {
    if [[ -x "$1" ]]; then echo "OK"
    elif [[ -f "$1" ]]; then echo "NOT_EXEC"
    else echo "MISSING"; fi
}
check_test_file() { [[ -f "$1" ]] && echo "OK" || echo "MISSING"; }

# Add a check result to checks_json (uses caller's checks_json, has_checks, all_ok)
add_check() {
    local type="$1" target="$2" status="$3"
    checks_json=$(echo "$checks_json" | jq --arg t "$type" --arg tgt "$target" --arg s "$status" \
        '. + [{"type": $t, "target": $tgt, "status": $s}]')
    has_checks=true
    [[ "$status" != "OK" ]] && all_ok=false || true
}

# --- Single-pass parse: extract version context + completed goals + verification assertions ---
declare -a GOALS=() GOAL_VERSIONS=()
declare -A VERSION_ASSERTIONS=()
current_version=""
in_verification=false
in_code_block=false
current_assert_label=""
current_assertions=""

while IFS= read -r line; do
    # Track version from headers
    if [[ "$line" =~ ^##[[:space:]]+Priority\ \# ]]; then
        current_version="1"
        in_verification=false; in_code_block=false
    elif [[ "$line" =~ ^#{2,4}[[:space:]]+(AMBITION[[:space:]]+)?v([0-9]+) ]]; then
        current_version="${BASH_REMATCH[2]}"
        in_verification=false; in_code_block=false
    fi

    # Detect ## Verification section
    if [[ "$line" =~ ^##[[:space:]]+Verification ]]; then
        in_verification=true
        continue
    fi

    # Inside verification section: look for code blocks
    if [[ "$in_verification" == "true" ]]; then
        if [[ "$in_code_block" == "false" ]]; then
            # Another heading ends the verification section (only outside code blocks)
            if [[ "$line" =~ ^#{1,4}[[:space:]] && ! "$line" =~ ^##[[:space:]]+Verification ]]; then
                in_verification=false
                continue
            fi
            # Horizontal rule (---) ends the verification section
            if [[ "$line" =~ ^---[[:space:]]*$ ]]; then
                in_verification=false
                continue
            fi
        fi
        if [[ "$in_code_block" == "false" && "$line" =~ ^\`\`\`bash ]]; then
            in_code_block=true
            continue
        fi
        if [[ "$in_code_block" == "true" ]]; then
            if [[ "$line" =~ ^\`\`\` ]]; then
                # End of code block — flush last assertion if pending
                if [[ -n "$current_assert_label" ]]; then
                    in_code_block=false
                fi
                in_code_block=false
                continue
            fi
            # Parse ASSERT labels and commands
            if [[ "$line" =~ ^#[[:space:]]*ASSERT:[[:space:]]*(.*) ]]; then
                current_assert_label="${BASH_REMATCH[1]}"
            elif [[ -n "$current_assert_label" && -n "$line" ]]; then
                # This is the command line following an ASSERT label
                # Store as label\tcmd pairs separated by newlines
                if [[ -n "${VERSION_ASSERTIONS[$current_version]:-}" ]]; then
                    VERSION_ASSERTIONS[$current_version]+=$'\n'"${current_assert_label}"$'\t'"${line}"
                else
                    VERSION_ASSERTIONS[$current_version]="${current_assert_label}"$'\t'"${line}"
                fi
                current_assert_label=""
            fi
        fi
    fi

    # Collect completed goals
    if [[ "$line" =~ ^[[:space:]]*-[[:space:]]\[x\][[:space:]]+(.*) ]]; then
        [[ -n "$VERSION_FILTER" && "$current_version" != "$VERSION_FILTER" ]] && continue
        GOALS+=("${BASH_REMATCH[1]}")
        GOAL_VERSIONS+=("$current_version")
    fi
done < "$AMBITION"

if [[ ${#GOALS[@]} -eq 0 ]]; then
    echo "No completed goals found${VERSION_FILTER:+ for version $VERSION_FILTER}" >&2
    exit 0
fi

# --- Run assertions per version (cache results) ---
declare -A VERSION_ASSERTION_RESULTS=()  # version -> JSON array of {label, command, passed}
declare -A VERSION_ASSERTIONS_ALL_PASS=()  # version -> true/false

run_version_assertions() {
    local ver="$1"
    [[ -z "${VERSION_ASSERTIONS[$ver]:-}" ]] && return
    [[ -n "${VERSION_ASSERTION_RESULTS[$ver]:-}" ]] && return  # already ran

    local results="[]"
    local all_pass=true

    while IFS=$'\t' read -r label cmd; do
        [[ -z "$label" || -z "$cmd" ]] && continue
        local passed=true
        if eval "$cmd" &>/dev/null; then
            passed=true
        else
            passed=false
            all_pass=false
        fi
        results=$(echo "$results" | jq \
            --arg l "$label" --arg c "$cmd" --argjson p "$passed" \
            '. + [{"label": $l, "command": $c, "passed": $p}]')
    done <<< "${VERSION_ASSERTIONS[$ver]}"

    VERSION_ASSERTION_RESULTS[$ver]="$results"
    VERSION_ASSERTIONS_ALL_PASS[$ver]="$all_pass"
}

# --- Process goals ---
RESULTS_JSON="[]"
verified=0; stale=0; unverifiable=0

for i in "${!GOALS[@]}"; do
    goal="${GOALS[$i]}"
    ver="${GOAL_VERSIONS[$i]}"
    checks_json="[]"; has_checks=false; all_ok=true

    # Extract and check commits: (abc1234)
    tmp="$goal"
    while [[ "$tmp" =~ \(([0-9a-f]{7,40})\) ]]; do
        add_check "commit" "${BASH_REMATCH[1]}" "$(check_commit "${BASH_REMATCH[1]}")"
        tmp="${tmp/${BASH_REMATCH[0]}/}"
    done
    # Extract and check endpoints: /api/...
    tmp="$goal"
    while [[ "$tmp" =~ (/api/[a-zA-Z0-9/_-]+) ]]; do
        add_check "endpoint" "${BASH_REMATCH[1]}" "$(check_endpoint "${BASH_REMATCH[1]}")"
        tmp="${tmp/${BASH_REMATCH[0]}/}"
    done
    # Extract and check tools: tools/...
    tmp="$goal"
    while [[ "$tmp" =~ (tools/[a-zA-Z0-9_-]+) ]]; do
        add_check "tool" "${BASH_REMATCH[1]}" "$(check_tool "${BASH_REMATCH[1]}")"
        tmp="${tmp/${BASH_REMATCH[0]}/}"
    done
    # Extract and check test files: tests/...py
    tmp="$goal"
    while [[ "$tmp" =~ (tests/[a-zA-Z0-9_]+\.py) ]]; do
        add_check "test_file" "${BASH_REMATCH[1]}" "$(check_test_file "${BASH_REMATCH[1]}")"
        tmp="${tmp/${BASH_REMATCH[0]}/}"
    done

    # Run version assertions if they exist (cached per version)
    run_version_assertions "$ver"
    has_assertions=false
    assertion_results="[]"
    assertions_all_pass=true
    if [[ -n "${VERSION_ASSERTIONS[$ver]:-}" ]]; then
        has_assertions=true
        assertion_results="${VERSION_ASSERTION_RESULTS[$ver]:-[]}"
        assertions_all_pass="${VERSION_ASSERTIONS_ALL_PASS[$ver]:-true}"
    fi

    # Score
    if [[ "$has_checks" == "false" && "$has_assertions" == "true" && "$assertions_all_pass" == "true" ]]; then
        # No artifact checks but assertions pass — VERIFIED via assertions
        result="VERIFIED"; (( verified++ )) || true
    elif [[ "$has_checks" == "false" && "$has_assertions" == "true" && "$assertions_all_pass" == "false" ]]; then
        result="STALE"; (( stale++ )) || true
    elif [[ "$has_checks" == "false" ]]; then
        result="UNVERIFIABLE"; (( unverifiable++ )) || true
    elif [[ "$all_ok" == "true" ]]; then
        result="VERIFIED"; (( verified++ )) || true
    else
        result="STALE"; (( stale++ )) || true
    fi

    # Truncate for display
    display="${goal}"; [[ ${#display} -gt 80 ]] && display="${display:0:77}..."

    RESULTS_JSON=$(echo "$RESULTS_JSON" | jq \
        --arg g "$goal" --arg v "$ver" --arg r "$result" --argjson c "$checks_json" \
        --argjson ha "$has_assertions" --argjson ar "$assertion_results" \
        '. + [{"goal": $g, "version": $v, "result": $r, "checks": $c, "has_assertions": $ha, "assertion_results": $ar}]')

    # Table output
    if [[ "$JSON_OUT" == "false" ]]; then
        case "$result" in
            VERIFIED)     icon="${GREEN}[OK]${NC}" ;;
            STALE)        icon="${RED}[!!]${NC}" ;;
            UNVERIFIABLE) icon="${YELLOW}[--]${NC}" ;;
        esac
        printf "  %b  ${DIM}v%-2s${NC}  %s\n" "$icon" "$ver" "$display"
        if [[ "$result" == "STALE" ]]; then
            echo "$checks_json" | jq -r '.[] | select(.status != "OK") | "        \(.type): \(.target) → \(.status)"' 2>/dev/null
            if [[ "$has_assertions" == "true" ]]; then
                echo "$assertion_results" | jq -r '.[] | select(.passed == false) | "        assertion: \(.label) → FAILED"' 2>/dev/null
            fi
        fi
    fi
done

# --- Output ---
FINAL_JSON=$(jq -n \
    --arg ts "$(date -Iseconds)" --argjson goals "$RESULTS_JSON" \
    --argjson v "$verified" --argjson s "$stale" --argjson u "$unverifiable" \
    --arg ver "${VERSION_FILTER:-all}" \
    '{timestamp: $ts, version_filter: $ver, goals: $goals, summary: {verified: $v, stale: $s, unverifiable: $u}}')

[[ "$JSON_OUT" == "true" ]] && echo "$FINAL_JSON"

if [[ "$SAVE" == "true" ]]; then
    # Goal verification is supervisor-level governance, not team-scoped.
    artifact_dir=".soren/journal/supervisor/$(date +%Y-%m-%d)/artifacts"
    mkdir -p "$artifact_dir"
    echo "$FINAL_JSON" > "${artifact_dir}/verify-goal.json"
    echo "(saved to ${artifact_dir}/verify-goal.json)" >&2
fi

if [[ "$JSON_OUT" == "false" ]]; then
    echo ""
    echo "  ──────────────────────────────────────────"
    total=$(( verified + stale + unverifiable ))
    printf "  %b%d VERIFIED%b  %b%d STALE%b  %b%d UNVERIFIABLE%b  (%d total)\n" \
        "$GREEN" "$verified" "$NC" "$RED" "$stale" "$NC" \
        "$YELLOW" "$unverifiable" "$NC" "$total"
    echo ""
fi

if (( stale > 0 )); then exit 1
elif (( unverifiable > 0 && verified == 0 )); then exit 2
else exit 0; fi
