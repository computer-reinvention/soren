# Soren environment configuration
# Copy this file to .env and fill in the values you need.

#───────────────────────────────────────────────────────────────────────────────
# Authentication (agent runtime)
#───────────────────────────────────────────────────────────────────────────────
# Agents need model-provider credentials. Either run `opencode auth login`
# once (recommended), or export an API key:
# ANTHROPIC_API_KEY=sk-ant-...

#───────────────────────────────────────────────────────────────────────────────
# Python server settings (pydantic, env_prefix "SOREN_" — see src/server/config.py)
# NOTE: these are distinct from the shell-tool variables below. The server
# reads SOREN_TMUX_SESSION / SOREN_MAILBOX_PATH; the shell tools read
# SOREN_SESSION / SOREN_MAILBOX. Keep both groups in sync if you change them.
#───────────────────────────────────────────────────────────────────────────────
# Server bind. Default is 127.0.0.1 (localhost only). Set SOREN_HOST=0.0.0.0
# to allow remote access (or use Tailscale/another private network).
# SOREN_HOST=127.0.0.1
# SOREN_PORT=8000

# tmux session name (server-side)
# SOREN_TMUX_SESSION=soren

# Mailbox path (server-side)
# SOREN_MAILBOX_PATH=.soren/mailbox

# Server log level
# SOREN_LOG_LEVEL=INFO

# Idle workers are auto-slept after this many minutes (auto-woken on send)
# SOREN_IDLE_SLEEP_MINUTES=30

#───────────────────────────────────────────────────────────────────────────────
# Shell tool settings (read by tools/* scripts, separate from the server)
#───────────────────────────────────────────────────────────────────────────────
# tmux session name (shell tools)
# SOREN_SESSION=soren

# Mailbox path (shell tools)
# SOREN_MAILBOX=.soren/mailbox

#───────────────────────────────────────────────────────────────────────────────
# Model tiers (tools/lib/opencode.sh) — default tier is opus for all workers
#───────────────────────────────────────────────────────────────────────────────
# SOREN_MODEL_OPUS=anthropic/claude-opus-4-6
# SOREN_MODEL_SONNET=anthropic/claude-sonnet-4-5
# SOREN_MODEL_HAIKU=anthropic/claude-haiku-4-5

#───────────────────────────────────────────────────────────────────────────────
# Context / compaction (src/server/routes/agent_events.py, compact.sh)
#───────────────────────────────────────────────────────────────────────────────
# SOREN_CONTEXT_WINDOW=200000
# SOREN_COMPACT_THRESHOLD=0.80

#───────────────────────────────────────────────────────────────────────────────
# Heartbeat (src/orchestrator/monitor.sh)
#───────────────────────────────────────────────────────────────────────────────
# Seconds idle before first nudge (default 900)
# SOREN_HEARTBEAT_WARN=900
# Cooldown seconds between nudges (default 180)
# SOREN_HEARTBEAT_NUDGE=180

# Project Settings
NODE_ENV=development
