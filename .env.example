# Soren environment configuration
# Copy this file to .env and fill in the values you need.

#───────────────────────────────────────────────────────────────────────────────
# Authentication (agent runtime)
#───────────────────────────────────────────────────────────────────────────────
# Agents need model-provider credentials. Either run `opencode auth login`
# once (recommended), or export an API key:
# ANTHROPIC_API_KEY=sk-ant-...

#───────────────────────────────────────────────────────────────────────────────
# Python server settings (pydantic, env_prefix "SOREN_" — see src/server/config.py)
# NOTE: these are distinct from the shell-tool variables below. The server
# reads SOREN_TMUX_SESSION / SOREN_MAILBOX_PATH; the shell tools read
# SOREN_SESSION / SOREN_MAILBOX. Keep both groups in sync if you change them.
#───────────────────────────────────────────────────────────────────────────────
# Server bind. Default is 127.0.0.1 (localhost only). Set SOREN_HOST=0.0.0.0
# to allow remote access (or use Tailscale/another private network).
# SOREN_HOST=127.0.0.1
# SOREN_PORT=8000

# tmux session name (server-side)
# SOREN_TMUX_SESSION=soren

# Mailbox path (server-side)
# SOREN_MAILBOX_PATH=.soren/mailbox

# Server log level
# SOREN_LOG_LEVEL=INFO

# Idle workers are auto-slept after this many minutes (auto-woken on send)
# SOREN_IDLE_SLEEP_MINUTES=30

#───────────────────────────────────────────────────────────────────────────────
# Shell tool settings (read by tools/* scripts, separate from the server)
#───────────────────────────────────────────────────────────────────────────────
# tmux session name (shell tools)
# SOREN_SESSION=soren

# Mailbox path (shell tools)
# SOREN_MAILBOX=.soren/mailbox

#───────────────────────────────────────────────────────────────────────────────
# Autonomy dial (tools/backlog) — gates agent-invented work behind human approval
#───────────────────────────────────────────────────────────────────────────────
# supervised (default): backlog items added by agents (SOREN_AGENT=true) are
#   recorded as unapproved proposals (source='self', approved=0) and cannot be
#   claimed until a human runs `./tools/backlog approve <id>` (or `approve --all`).
#   Agents can never approve/reject items.
# autonomous: prior ungated behavior — agents may claim any backlog item,
#   including their own proposals, without human approval.
# SOREN_AUTONOMY=supervised

# Quiet-orchestrator knobs (src/orchestrator/)
# SOREN_IDLE_BACKOFF_CAP=7200       # supervised mode: idle-nudge exponential backoff cap (s); 900→1800→3600→cap when nothing is actionable
# SOREN_LOG_ALERT_DEDUP_HOURS=6     # suppress repeat log alerts with the same normalized error signature; also per-agent discrepancy-alert cooldown
# SOREN_MAX_SPAWNS_PER_HOUR=6       # max agent-initiated worker spawns per rolling hour (humans exempt; --user-approved bypasses)

#───────────────────────────────────────────────────────────────────────────────
# Model tiers (tools/lib/opencode.sh) — default tier is opus for all workers
#───────────────────────────────────────────────────────────────────────────────
# SOREN_MODEL_OPUS=anthropic/claude-opus-4-6
# SOREN_MODEL_SONNET=anthropic/claude-sonnet-4-5
# SOREN_MODEL_HAIKU=anthropic/claude-haiku-4-5

#───────────────────────────────────────────────────────────────────────────────
# Context / compaction (src/server/routes/agent_events.py, compact.sh)
#───────────────────────────────────────────────────────────────────────────────
# SOREN_CONTEXT_WINDOW=200000
# SOREN_COMPACT_THRESHOLD=0.80

#───────────────────────────────────────────────────────────────────────────────
# Heartbeat (src/orchestrator/monitor.sh)
#───────────────────────────────────────────────────────────────────────────────
# Seconds idle before first nudge (default 900)
# SOREN_HEARTBEAT_WARN=900
# Cooldown seconds between nudges (default 180)
# SOREN_HEARTBEAT_NUDGE=180

# Project Settings
NODE_ENV=development

# Proactive reset policy for permanent workers (tools/auto-maintenance)
# Reset after N completed tasks or H hours since last reset (0 disables either)
# SOREN_RESET_TASKS=5
# SOREN_RESET_HOURS=12

# Rollback guardrails (src/orchestrator/monitor.sh)
# SOREN_HEALTHY_GRACE=300                 # seconds a new HEAD must run healthy before becoming the rollback target
# SOREN_MAX_GIT_RECOVERIES_PER_HOUR=3     # circuit breaker: suspend git-mutating recovery beyond this rate
# SOREN_RESCUE_BRANCH_KEEP=10             # pre-rollback rescue branches to retain
# SOREN_SMOKE_USER=pg                     # enables deep smoke-test verification of recoveries
# SOREN_SMOKE_PASS=...                    # (without credentials, only the health endpoint gates recovery)

# Heartbeat/sentry behavior
# SOREN_SENTRY=true          # false disables sentry escalation (nudges/observation still run)
# SOREN_SUSPEND_GAP=120      # monitor loop gap (s) treated as machine suspend — resets heartbeat instead of escalating

# Registry hygiene: retire sleeping ephemeral workers after N hours (0 disables)
# SOREN_RETIRE_SLEEPING_HOURS=24
